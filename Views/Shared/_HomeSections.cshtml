            <button type="button" data-filter-group="events" data-filter="all" aria-pressed="true">Tất cả</button>
            <button type="button" data-filter-group="events" data-filter="wedding" aria-pressed="false">Sắc xuân</button>
            <button type="button" data-filter-group="events" data-filter="company" aria-pressed="false">Sum họp</button>
            <button type="button" data-filter-group="events" data-filter="buffet" aria-pressed="false">Bàn tiệc</button>
        </div><div class="df-events-grid df-tet-mosaic">
        <a class="df-event-card" data-card-group="events" data-category="wedding" href="@TetPhoto("gallery-01.webp", "~/assets/img/tet-motion/tet-table.png")" data-lightbox="df-events" data-title="Sắc Tết thân quen"><img src="@TetPhoto("gallery-01.webp", "~/assets/img/tet-motion/tet-table.png")" alt="Sắc Tết thân quen" class="" loading="lazy"><div><span>CẢM HỨNG TẾT</span><h3>Sắc Tết thân quen</h3></div><span class="df-event-open" aria-hidden="true">↗</span></a>
        <a class="df-event-card" data-card-group="events" data-category="company" href="@TetPhoto("gallery-02.webp", "~/images/p4.jpg")" data-lightbox="df-events" data-title="Niềm vui sum họp"><img src="@TetPhoto("gallery-02.webp", "~/images/p4.jpg")" alt="Niềm vui sum họp" class="" loading="lazy"><div><span>CẢM HỨNG TẾT</span><h3>Niềm vui sum họp</h3></div><span class="df-event-open" aria-hidden="true">↗</span></a>
        <a class="df-event-card" data-card-group="events" data-category="buffet" href="@TetPhoto("gallery-03.webp", "~/images/p1.jpg")" data-lightbox="df-events" data-title="Bàn tiệc đầu xuân"><img src="@TetPhoto("gallery-03.webp", "~/images/p1.jpg")" alt="Bàn tiệc đầu xuân" class="" loading="lazy"><div><span>CẢM HỨNG TẾT</span><h3>Bàn tiệc đầu xuân</h3></div><span class="df-event-open" aria-hidden="true">↗</span></a>
        <a class="df-event-card" data-card-group="events" data-category="wedding" href="@TetPhoto("gallery-04.webp", "~/images/p3.jpg")" data-lightbox="df-events" data-title="Lưu một mùa thương"><img src="@TetPhoto("gallery-04.webp", "~/images/p3.jpg")" alt="Lưu một mùa thương" class="" loading="lazy"><div><span>CẢM HỨNG TẾT</span><h3>Lưu một mùa thương</h3></div><span class="df-event-open" aria-hidden="true">↗</span></a>
    </div>
</div>
</section><!-- Events End -->

<!-- Booking Start -->
<section class="df-section df-booking" id="df-booking">
    <div class="container">
        <div class="df-booking-shell">
            <div class="df-booking-story">
                <img src="@TetPhoto("booking-01.webp", "~/assets/img/tet-motion/tet-table.png")" alt="Sắc màu bàn tiệc DoraFood" class="" loading="lazy">
                <div><span class="df-eyebrow">DÀNH CHỖ CHO NIỀM VUI</span><h2>Giữ một cuộc hẹn.<br>Đón một mùa vui.</h2><p>Một cuộc hẹn nhỏ.<br>Một khoảng thời gian thật trọn vẹn.</p><span class="df-booking-mark" aria-hidden="true">✦</span></div>
            </div>
            <div class="df-booking-form-wrap">
                <span class="df-eyebrow">CUỘC HẸN CỦA BẠN</span><h2>Bạn dự định ghé khi nào?</h2><p>Phác thảo cuộc hẹn đầu xuân. Bạn có thể chỉnh lại thông tin trước khi đặt bàn.</p>
                <form id="df-booking-form">
                    <div class="df-form-grid">
                        <div class="df-field"><label for="df-name">Tên của bạn <span>*</span></label><input id="df-name" name="FullName" autocomplete="name" placeholder="Nhập họ và tên" maxlength="100" required></div>
                        <div class="df-field"><label for="df-phone">Số điện thoại <span>*</span></label><input id="df-phone" name="Phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="Số điện thoại liên hệ" pattern="[+0-9() .-]{8,20}" maxlength="20" required></div>
                        <div class="df-field"><label for="df-date">Ngày ghé <span>*</span></label><input id="df-date" name="VisitDate" type="date" required></div>
                        <div class="df-field"><label for="df-time">Giờ dự kiến <span>*</span></label><input id="df-time" name="VisitTime" type="time" required></div>
                        <div class="df-field"><label for="df-guests">Số khách <span>*</span></label><input id="df-guests" name="Guests" type="number" min="1" max="500" value="2" required></div>
                        <div class="df-field"><label for="df-occasion">Dịp gặp gỡ</label><select id="df-occasion" name="Occasion"><option value="Khác">Chọn dịp gặp gỡ</option><option>Gia đình</option><option>Bạn bè</option><option>Sinh nhật</option><option>Doanh nghiệp</option></select></div>
                        <div class="df-field df-field-full"><label for="df-note">Điều bạn muốn nhắn</label><textarea id="df-note" name="Note" rows="2" maxlength="1000" placeholder="Món quan tâm, vị trí ngồi hoặc mong muốn cho buổi hẹn..."></textarea></div>
                    </div><button class="df-button df-button-red df-booking-submit" type="submit">Xem lại cuộc hẹn <span aria-hidden="true">↗</span></button><p class="df-form-hint">Đây là bản lên kế hoạch, thông tin chưa được gửi.</p><a class="df-tet-real-booking" href="@(ViewData["BookingUrl"] as string ?? Url.Content("~/book.html"))">Đến trang đặt bàn chính thức <span aria-hidden="true">↗</span></a>
                </form>
            </div>
        </div>
    </div>
</section>
<dialog id="df-booking-preview" class="df-booking-dialog" aria-labelledby="df-preview-title"><div class="df-dialog-top"><span class="df-eyebrow">KẾ HOẠCH CỦA BẠN</span><button type="button" data-close-preview aria-label="Đóng cửa sổ">×</button></div><h2 id="df-preview-title">Hẹn nhau tại DoraFood</h2><dl id="df-preview-content"></dl><p class="df-preview-note">Đây là bản xem lại. Thông tin chưa được gửi và bàn chưa được xác nhận.</p><button type="button" class="df-button df-button-red" data-close-preview>Chỉnh sửa thông tin</button></dialog>
<!-- Booking End -->
<!-- Testimonial Start --><section class="df-section df-feedback" id="df-feedback"><div class="container"><div class="df-feedback-shell"><span class="df-feedback-symbol" aria-hidden="true">“</span><div><span class="df-eyebrow">LẮNG NGHE ĐỂ CHĂM CHÚT HƠN</span><h2>Câu chuyện của bạn.<br><span>Cảm hứng của DoraFood.</span></h2><p>Những điều bạn yêu thích và những điều có thể tốt hơn đều đáng được lắng nghe.</p><div class="df-feedback-empty">Chưa có đánh giá được công bố.</div></div><div class="df-feedback-aside"><span aria-hidden="true">✦</span><p>Hẹn một bữa ngon.<br>Giữ một kỷ niệm đẹp.</p></div></div></div></section><!-- Testimonial End -->
<!-- Blog Start --><section class="df-section" id="df-journal">
<div class="container">
    <div class="df-section-head"><span class="df-eyebrow">CHUYỆN NHỎ NGÀY XUÂN</span><h2>Chậm lại một chút.<br><span>Để Tết thêm đáng nhớ.</span></h2></div>
    <div class="df-journal-grid">
        <article class="df-journal-card"><img src="@TetPhoto("journal-01.webp", "~/images/p1.jpg")" alt="Một buổi hẹn, nhiều điều để kể" class="" loading="lazy"><div class="df-journal-body"><span class="df-eyebrow">BÀN ĂN & KẾT NỐI</span><h3>Một buổi hẹn, nhiều điều để kể</h3><details><summary>Đọc câu chuyện <span aria-hidden="true">+</span></summary><p>Bắt đầu bằng món dễ chia sẻ và dành thời gian chọn món cùng nhau. Một nhịp ăn thong thả giúp cuộc trò chuyện tự nhiên hơn.</p></details></div></article>
        <article class="df-journal-card"><img src="@TetPhoto("journal-02.webp", "~/images/p3.jpg")" alt="Chọn món cho nhóm bạn" class="" loading="lazy"><div class="df-journal-body"><span class="df-eyebrow">GỢI Ý CHỌN MÓN</span><h3>Chọn món cho nhóm bạn</h3><details><summary>Đọc câu chuyện <span aria-hidden="true">+</span></summary><p>Hỏi trước khẩu vị, món kiêng và nguyên liệu cần tránh của từng người. Kết hợp món chính, món rau và phần ăn chia sẻ để mọi người dễ lựa chọn.</p></details></div></article>
        <article class="df-journal-card"><img src="@TetPhoto("journal-03.webp", "~/images/p4.jpg")" alt="Chăm chút một bữa tiệc nhỏ" class="" loading="lazy"><div class="df-journal-body"><span class="df-eyebrow">NHỮNG DỊP ĐẶC BIỆT</span><h3>Chăm chút một bữa tiệc nhỏ</h3><details><summary>Đọc câu chuyện <span aria-hidden="true">+</span></summary><p>Dự kiến số khách và thời gian đến, rồi ghi lại những mong muốn như chỗ ngồi hoặc món quan tâm. Trao đổi trước với nhà hàng để cùng chuẩn bị.</p></details></div></article>
    </div>        </div>
</section><!-- Blog End -->
</div>