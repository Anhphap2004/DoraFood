<!-- Booking Start -->
<section class="df-section df-booking" id="df-booking"><div class="container"><div class="df-booking-shell">
<div class="df-booking-story">
<img src="~/assest/img/background-site.jpg" alt="Sắc màu bàn tiệc DoraFood" class="" loading="lazy">
<div><span class="df-eyebrow">DÀNH CHỖ CHO NIỀM VUI</span><h2>Hẹn nhau<br>một bữa ngon.</h2><p>Một cuộc hẹn nhỏ.<br>Một khoảng thời gian thật trọn vẹn.</p><span class="df-booking-mark" aria-hidden="true">✦</span></div></div>
<div class="df-booking-form-wrap"><span class="df-eyebrow">CUỘC HẸN CỦA BẠN</span><h2>Bạn dự định ghé khi nào?</h2><p>Điền thông tin để xem lại kế hoạch của bạn.</p>
<form id="df-booking-form"><div class="df-form-grid">
<div class="df-field"><label for="df-name">Tên của bạn <span>*</span></label><input id="df-name" name="FullName" autocomplete="name" placeholder="Nhập họ và tên" maxlength="100" required></div>
<div class="df-field"><label for="df-phone">Số điện thoại <span>*</span></label><input id="df-phone" name="Phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="Số điện thoại liên hệ" pattern="[+0-9() .-]{8,20}" maxlength="20" required></div>
<div class="df-field"><label for="df-date">Ngày ghé <span>*</span></label><input id="df-date" name="VisitDate" type="date" required></div>
<div class="df-field"><label for="df-time">Giờ dự kiến <span>*</span></label><input id="df-time" name="VisitTime" type="time" required></div>
<div class="df-field"><label for="df-guests">Số khách <span>*</span></label><input id="df-guests" name="Guests" type="number" min="1" max="500" value="2" required></div>
<div class="df-field"><label for="df-occasion">Dịp gặp gỡ</label><select id="df-occasion" name="Occasion"><option value="Khác">Chọn dịp gặp gỡ</option><option>Gia đình</option><option>Bạn bè</option><option>Sinh nhật</option><option>Doanh nghiệp</option></select></div>
<div class="df-field df-field-full"><label for="df-note">Điều bạn muốn nhắn</label><textarea id="df-note" name="Note" rows="2" maxlength="1000" placeholder="Món quan tâm, vị trí ngồi hoặc mong muốn cho buổi hẹn..."></textarea></div>
</div><button class="df-button df-button-red df-booking-submit" type="submit">Xem lại cuộc hẹn <span aria-hidden="true">↗</span></button><p class="df-form-hint">Thông tin chưa được gửi. Việc đặt bàn cần được nhà hàng xác nhận.</p></form>
</div></div></div></section>
<dialog id="df-booking-preview" class="df-booking-dialog" aria-labelledby="df-preview-title"><div class="df-dialog-top"><span class="df-eyebrow">KẾ HOẠCH CỦA BẠN</span><button type="button" data-close-preview aria-label="Đóng cửa sổ">×</button></div><h2 id="df-preview-title">Hẹn nhau tại DoraFood</h2><dl id="df-preview-content"></dl><p class="df-preview-note">Đây là bản xem lại. Thông tin chưa được gửi và bàn chưa được xác nhận.</p><button type="button" class="df-button df-button-red" data-close-preview>Chỉnh sửa thông tin</button></dialog>
<!-- Booking End -->
