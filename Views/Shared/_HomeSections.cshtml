    <!-- Experience Start -->
    <section class="df-experience" aria-label="Trải nghiệm DoraFood">
        <div class="container df-experience-grid">
            <div><span class="df-eyebrow">ĐẦU XUÂN GẶP GỠ · TRỌN VỊ ĐOÀN VIÊN</span><h2>Gặp nhau trong sắc Tết.<br><span>Ở lại cùng niềm vui.</span></h2></div>
            <div class="df-experience-note"><span class="df-mini-icon" aria-hidden="true">✦</span><p>Dành một khoảng thời gian cho những người bạn quý.<br>Còn cảm hứng cho bữa ăn, hãy để DoraFood gợi mở.</p><a class="df-text-link" href="#df-menu">Khám phá hương vị <span aria-hidden="true">↗</span></a></div>
        </div>
    </section>
    <!-- Experience End -->
    <!-- Service Start -->
    @await Component.InvokeAsync("HomeServices")

  <!-- Service End -->
    <!-- Events Start --><section class="df-section df-tinted" id="df-events">
