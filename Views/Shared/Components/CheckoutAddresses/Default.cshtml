@model System.Collections.Generic.List<DoraFood.ViewComponents.CheckoutAddressesViewComponent.AddressOption>

<div id="checkout-address-picker"
     class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <h2 class="h5 mb-2">Địa chỉ đã lưu</h2>

        <p class="small text-muted mb-3">
            Chọn địa chỉ muốn nhận hàng, sau đó kiểm tra thông tin
            giao hàng bên dưới.
        </p>

        <label for="checkout-saved-address"
               class="form-label">
            Chọn địa chỉ nhận hàng
        </label>

        <select id="checkout-saved-address"
                class="form-select">
            <option value="">Chọn một địa chỉ đã lưu...</option>

            @foreach (var address in Model)
            {
                <option value="@address.Id"
                        data-recipient="@address.RecipientName"
                        data-phone="@address.PhoneNumber"
                        data-address="@address.AddressLine">
                    @(address.IsDefault ? "[Mặc định] " : "")@address.RecipientName
                    — @address.PhoneNumber — @address.AddressLine
                </option>
            }

            <option value="manual">
                Nhập địa chỉ khác
            </option>
        </select>

        <p id="checkout-address-status"
           class="small text-muted mt-2 mb-0"
           role="status"></p>
    </div>
</div>

<script>
    (() => {
        const initialize = () => {
            const picker = document.getElementById(
                "checkout-saved-address"
            );

            const status = document.getElementById(
                "checkout-address-status"
            );

            const form = document.getElementById(
                "checkout-review-form"
            );

            if (!picker || !form || !status) {
                return;
            }

            const receiver = form.elements.namedItem(
                "Input.ReceiverName"
            );

            const phone = form.elements.namedItem(
                "Input.PhoneNumber"
            );

            const address = form.elements.namedItem(
                "Input.DeliveryAddress"
            );

            if (!receiver || !phone || !address) {
                return;
            }

            const options = Array.from(picker.options).filter(
                option => option.dataset.address !== undefined
            );

            // Chỉ nhận biết địa chỉ đang có trong form.
            // Không tự ghi đè dữ liệu khách vừa nhập.
            const matchingOption = options.find(option =>
                option.dataset.recipient === receiver.value
                && option.dataset.phone === phone.value
                && option.dataset.address === address.value
            );

            if (matchingOption) {
                picker.value = matchingOption.value;
            } else if (receiver.value || phone.value || address.value) {
                picker.value = "manual";
            }

            const notifyChange = field => {
                field.dispatchEvent(
                    new Event("input", { bubbles: true })
                );

                field.dispatchEvent(
                    new Event("change", { bubbles: true })
                );
            };

            picker.addEventListener("change", () => {
                if (!picker.value) {
                    status.textContent = "";
                    return;
                }

                if (picker.value === "manual") {
                    status.textContent =
                        "Anh sửa thông tin giao hàng ở form bên dưới, "
                        + "rồi bấm Kiểm tra thông tin.";

                    address.focus();
                    return;
                }

                const selected = picker.selectedOptions[0];

                receiver.value = selected.dataset.recipient ?? "";
                phone.value = selected.dataset.phone ?? "";
                address.value = selected.dataset.address ?? "";

                notifyChange(receiver);
                notifyChange(phone);
                notifyChange(address);

                status.textContent =
                    "Đã điền địa chỉ được chọn. "
                    + "Anh bấm Kiểm tra thông tin trước khi đặt đơn.";
            });

            // Nếu khách tự sửa form, cập nhật lại lựa chọn tương ứng.
            const syncSelection = () => {
                const match = options.find(option =>
                    option.dataset.recipient === receiver.value
                    && option.dataset.phone === phone.value
                    && option.dataset.address === address.value
                );

                picker.value = match ? match.value : "manual";
            };

            receiver.addEventListener("input", syncSelection);
            phone.addEventListener("input", syncSelection);
            address.addEventListener("input", syncSelection);
        };

        if (document.readyState === "loading") {
            document.addEventListener(
                "DOMContentLoaded",
                initialize,
                { once: true }
            );
        } else {
            initialize();
        }
    })();
</script>