@{
    var pageTitle = ViewData["Title"] as string;
    var description = ViewData["Description"] as string ?? "DoraFood — hương vị tinh tế cho những cuộc hẹn đáng nhớ.";
    var homeUrl = Url.Content("~/");
    var menuUrl = Url.RouteUrl("DoraFoodMenu") ?? Url.Content("~/thuc-don");
    // Giữ đường dẫn gốc khi chưa được cung cấp route đặt bàn thật.
    var bookingUrl = ViewData["BookingUrl"] as string ?? Url.Content("~/book.html");
    var address = ViewData["RestaurantAddress"] as string;
    var phone = ViewData["RestaurantPhone"] as string;
    var email = ViewData["RestaurantEmail"] as string;
    var hours = ViewData["RestaurantHours"] as string;
    var hasContact = !string.IsNullOrWhiteSpace(address) || !string.IsNullOrWhiteSpace(phone)
        || !string.IsNullOrWhiteSpace(email) || !string.IsNullOrWhiteSpace(hours);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="@description">
    <meta name="theme-color" content="#a71930">
    <title>@(string.IsNullOrWhiteSpace(pageTitle) ? "DoraFood | Tinh hoa ẩm thực" : $"{pageTitle} | DoraFood")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="~/assets/lib/animate/animate.min.css" rel="stylesheet">
    <link href="~/assets/lib/lightbox/css/lightbox.min.css" rel="stylesheet">
    <link href="~/assets/lib/owlcarousel/owl.carousel.min.css" rel="stylesheet">
    <link href="~/assets/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/assets/css/style.css" rel="stylesheet" asp-append-version="true">
    <link href="~/assets/css/dorafood-home.css" rel="stylesheet" asp-append-version="true">
    @await RenderSectionAsync("Styles", required: false)
    <link href="~/assets/css/dorafood-premium.css" rel="stylesheet" asp-append-version="true">
</head>
<body class="df-site" id="df-page-top">
    <a class="df-skip-link" href="#df-main-content">Đến nội dung chính</a>

    <div class="df-announcement">
        <div class="df-shell df-announcement-inner">
            <span><span class="df-small-diamond" aria-hidden="true">✦</span> Ẩm thực tinh tế · Những cuộc hẹn đáng nhớ</span>
            <a href="@menuUrl">Khám phá thực đơn <span aria-hidden="true">↗</span></a>
        </div>
    </div>

    <!-- Navbar luôn hiển thị: không collapse, không nút hamburger. -->
    <header class="df-site-header">
        <div class="df-shell df-brandbar">
            <a href="@homeUrl" class="df-site-brand" aria-label="DoraFood — Trang chủ">
                <span class="df-brand-symbol" aria-hidden="true"><i class="fas fa-utensils"></i></span>
                <span><span class="df-brand-word">Dora<span>Food</span><sup aria-hidden="true">✦</sup></span><span class="df-brand-tagline">TINH HOA ẨM THỰC</span></span>
            </a>
            <div class="df-brand-message"><span>CHẠM VỊ NGON · GẮN KẾT CẢM XÚC</span><strong>Mỗi bữa ăn, một khoảnh khắc đẹp.</strong></div>
            <div class="df-header-actions">
                <button type="button" class="df-header-search" data-bs-toggle="modal" data-bs-target="#searchModal" aria-label="Tìm nhanh nội dung"><i class="fas fa-search" aria-hidden="true"></i></button>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown df-user-dropdown">
                        <button type="button" class="df-user-button dropdown-toggle" id="accountDropdown" data-bs-toggle="dropdown" aria-expanded="false"><i class="far fa-user" aria-hidden="true"></i><span>@User.Identity.Name</span></button>
                        <div class="dropdown-menu dropdown-menu-end" aria-labelledby="accountDropdown">
                            <div class="df-user-intro"><span>TÀI KHOẢN CỦA BẠN</span><strong>@User.Identity.Name</strong></div>
                            <a href="@Url.RouteUrl("DoraFoodMyBookings")" class="dropdown-item"><i class="far fa-calendar-check" aria-hidden="true"></i> Đặt bàn của tôi</a>
                            <div class="dropdown-divider"></div>
                            <form action="@Url.Action("Logout", "Account")" method="post">@Html.AntiForgeryToken()<button type="submit" class="dropdown-item df-logout"><i class="fas fa-sign-out-alt" aria-hidden="true"></i> Đăng xuất</button></form>
                        </div>
                    </div>
                }
                else
                {
                    <a class="df-login-link" href="@Url.Action("Login", "Account")"><i class="far fa-user" aria-hidden="true"></i><span>Đăng nhập</span></a>
                }
                <a class="df-reserve-link" href="@bookingUrl"><i class="far fa-calendar-check" aria-hidden="true"></i><span>Đặt bàn</span><span aria-hidden="true">↗</span></a>
            </div>
        </div>
        <nav class="df-primary-navigation" aria-label="Điều hướng chính">
            <div class="df-shell df-navigation-inner">
                <div class="df-mainmenu">
                    @await Component.InvokeAsync("MainMenu")
                </div>
            </div>
        </nav>
    </header>

    <div class="modal fade df-search-modal" id="searchModal" tabindex="-1" aria-labelledby="dfSearchTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header"><span class="df-overline">KHÁM PHÁ DORAFOOD</span><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng tìm kiếm"></button></div>
                <div class="modal-body">
                    <h2 id="dfSearchTitle">Bạn đang tìm điều gì?</h2><p>Tìm nhanh menu hoặc nội dung trong trang đang xem.</p>
                    <label for="df-quick-search" class="visually-hidden">Từ khóa tìm nhanh</label>
                    <div class="df-quick-search-field"><i class="fas fa-search" aria-hidden="true"></i><input id="df-quick-search" type="search" placeholder="Thực đơn, giới thiệu, cuộc hẹn..." autocomplete="off"></div>
                    <a class="df-search-menu-link" href="@menuUrl">Tìm món ăn trong thực đơn <span aria-hidden="true">↗</span></a>
                    <div id="df-quick-results" class="df-quick-results"></div><p id="df-quick-empty" hidden role="status">Chưa tìm thấy nội dung phù hợp.</p>
                    <noscript><p>Bạn có thể dùng menu luôn hiển thị ở đầu trang.</p></noscript>
                </div>
            </div>
        </div>
    </div>

    <main id="df-main-content" class="df-site-main" tabindex="-1">@RenderBody()</main>

    <footer class="df-site-footer">
        <div class="df-shell">
            <div class="df-footer-invitation"><div><span class="df-overline">DÀNH THỜI GIAN CHO NHAU</span><h2>Một bàn ăn ngon.<br><span>Nhiều điều để nhớ.</span></h2><p>Chọn món bạn thích, hẹn người bạn quý. DoraFood chờ cuộc hẹn của bạn.</p></div><a href="@bookingUrl" class="df-footer-button">Lên lịch ghé DoraFood <span aria-hidden="true">↗</span></a></div>
            <div class="df-footer-columns @(hasContact ? "has-contact" : "")">
                <div class="df-footer-brand"><a href="@homeUrl" class="df-site-brand" aria-label="DoraFood — Trang chủ"><span class="df-brand-symbol" aria-hidden="true"><i class="fas fa-utensils"></i></span><span><span class="df-brand-word">Dora<span>Food</span></span><span class="df-brand-tagline">TINH HOA ẨM THỰC</span></span></a><p>Hương vị tạo nên cảm hứng.<br>Những cuộc gặp tạo nên kỷ niệm.</p><span class="df-footer-signature">CHẠM VỊ NGON · GẮN KẾT CẢM XÚC</span></div>
                <div class="df-footer-links"><h3>Khám phá DoraFood</h3><a href="@homeUrl">Trang chủ <span aria-hidden="true">↗</span></a><a href="@menuUrl">Thực đơn & khẩu phần <span aria-hidden="true">↗</span></a><a href="@(homeUrl + "#fdAboutTitle")">Câu chuyện DoraFood <span aria-hidden="true">↗</span></a><a href="@(homeUrl + "#df-dining-guide")">Gợi ý cho cuộc hẹn <span aria-hidden="true">↗</span></a></div>
                <div class="df-footer-links">
                    <h3>Cuộc hẹn của bạn</h3><a href="@bookingUrl">Đặt bàn <span aria-hidden="true">↗</span></a><a href="@(homeUrl + "#df-faq")">Điều bạn muốn biết <span aria-hidden="true">↗</span></a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a href="@Url.RouteUrl("DoraFoodMyBookings")">Đặt bàn của tôi <span aria-hidden="true">↗</span></a>
                    }
                    else
                    {

                        <a href="@Url.Action("Login", "Account")">Đăng nhập <span aria-hidden="true">↗</span></a>
                    }
                </div>
                @if (hasContact)
                {
                    <div class="df-footer-contact">
                        <h3>Ghé thăm nhà hàng</h3>
                        @if (!string.IsNullOrWhiteSpace(address))
                        {
                            <p><i class="fas fa-map-marker-alt" aria-hidden="true"></i><span>@address</span></p>
                        }
                        @if (!string.IsNullOrWhiteSpace(phone))
                        {
                            <p><i class="fas fa-phone-alt" aria-hidden="true"></i><a href="tel:@phone">@phone</a></p>
                        }
                        @if (!string.IsNullOrWhiteSpace(email))
                        {
                            <p><i class="far fa-envelope" aria-hidden="true"></i><a href="mailto:@email">@email</a></p>
                        }
                        @if (!string.IsNullOrWhiteSpace(hours))
                        {
                            <p><i class="far fa-clock" aria-hidden="true"></i><span>@hours</span></p>
                        }
                    </div>
                }
            </div>
            <div class="df-footer-strip" aria-label="Góc ẩm thực DoraFood">@for (var i = 1; i <= 6; i++) {
                <img src="@Url.Content($"~/images/p{i:0}.jpg")" alt="Góc ẩm thực DoraFood @i" width="240" height="140" loading="lazy">
            }
        </div>
            <div class="df-footer-bottom"><span>© @DateTime.Now.Year DoraFood. Bảo lưu mọi quyền.</span><span>Template: <a href="https://www.facebook.com/AnhPhapp24/" rel="noopener">Anhh Phapp</a></span><a href="#df-page-top">Về đầu trang <span aria-hidden="true">↑</span></a></div>
    </div>
</footer>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/1.12.4/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/assets/lib/wow/wow.min.js"></script>
<script src="~/assets/lib/easing/easing.min.js"></script>
<script src="~/assets/lib/waypoints/waypoints.min.js"></script>
<script src="~/assets/lib/counterup/counterup.min.js"></script>
<script src="~/assets/lib/lightbox/js/lightbox.min.js"></script>
<script src="~/assets/lib/owlcarousel/owl.carousel.min.js"></script>
<script src="~/assets/js/main.js" asp-append-version="true"></script>
<script src="~/assets/js/dorafood-home.js" asp-append-version="true"></script>
<script src="~/assets/js/dorafood-premium.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
