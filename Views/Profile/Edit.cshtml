@model DoraFood.ViewModels.EditProfileInput

@{
    ViewData["Title"] = "Chỉnh sửa hồ sơ";

    var today = System.DateTime.UtcNow.AddHours(7).ToString(
        "yyyy-MM-dd",
        System.Globalization.CultureInfo.InvariantCulture);
}

<section class="py-5 bg-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="mb-4">
                    <a asp-route="DoraFood.MyProfile"
                       class="text-decoration-none">
                        <i class="fas fa-arrow-left me-1" aria-hidden="true"></i>
                        Tài khoản của tôi
                    </a>

                    <h1 class="h2 fw-bold mt-3 mb-2">
                        Chỉnh sửa hồ sơ
                    </h1>

                    <p class="text-muted mb-0">
                        Cập nhật thông tin cá nhân của anh tại DoraFood.
                    </p>
                </div>

                <form asp-controller="Profile"
                      asp-action="Edit"
                      asp-antiforgery="true"
                      method="post"
                      class="card border-0 shadow-sm">

                    <div class="card-body p-4">
                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="FullName" class="form-label">
                                    Họ và tên
                                </label>

                                <input asp-for="FullName"
                                       class="form-control"
                                       maxlength="150"
                                       autocomplete="name"
                                       required />

                                <span asp-validation-for="FullName"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label">
                                    Số điện thoại
                                </label>

                                <input asp-for="PhoneNumber"
                                       type="tel"
                                       class="form-control"
                                       maxlength="20"
                                       autocomplete="tel" />

                                <span asp-validation-for="PhoneNumber"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="DateOfBirth" class="form-label">
                                    Ngày sinh
                                </label>

                                <input asp-for="DateOfBirth"
                                       asp-format="{0:yyyy-MM-dd}"
                                       type="date"
                                       max="@today"
                                       class="form-control"
                                       autocomplete="bday" />

                                <span asp-validation-for="DateOfBirth"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Gender" class="form-label">
                                    Giới tính
                                </label>

                                <select asp-for="Gender" class="form-select">
                                    <option value="">Không cung cấp</option>
                                    <option value="MALE">Nam</option>
                                    <option value="FEMALE">Nữ</option>
                                    <option value="OTHER">Khác</option>

                                    @if (!string.IsNullOrWhiteSpace(Model.CurrentGender)
                                         && Model.CurrentGender is not ("MALE" or "FEMALE" or "OTHER"))
                                    {
                                        <option value="@Model.CurrentGender">
                                            @Model.CurrentGender (giá trị hiện tại)
                                        </option>
                                    }
                                </select>

                                <span asp-validation-for="Gender"
                                      class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer bg-white d-flex flex-wrap
                                justify-content-end gap-2 p-3">
                        <a asp-route="DoraFood.MyProfile"
                           class="btn btn-outline-secondary">
                            Hủy
                        </a>

                        <button type="submit" class="btn btn-primary">
                            Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>