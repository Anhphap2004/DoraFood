@using System
@using System.Linq
@using System.Globalization
@model DoraFood.ViewModels.UserProfileViewModel
@{
    ViewData["Title"] = "Tài khoản của tôi";
    var displayName = !string.IsNullOrWhiteSpace(Model.DisplayName)
        ? Model.DisplayName.Trim()
        : (!string.IsNullOrWhiteSpace(Model.UserName) ? Model.UserName.Trim() : "Bạn");
    var requestedAvatar = Model.AvatarUrl?.Trim();
    var avatarUrl = !string.IsNullOrWhiteSpace(requestedAvatar) && Url.IsLocalUrl(requestedAvatar)
        ? Url.Content(requestedAvatar)
        : null;
    var initial = StringInfo.GetNextTextElement(displayName).ToUpperInvariant();
    var gender = Model.Gender?.Trim().ToUpperInvariant() switch
    {
        "MALE" => "Nam",
        "FEMALE" => "Nữ",
        "OTHER" => "Khác",
        _ => Model.Gender
    };
    var joinedAt = Model.CreatedAtUtc.AddHours(7);
    var hasEmail = !string.IsNullOrWhiteSpace(Model.Email);
    var emailVerified = hasEmail && Model.EmailConfirmed;
    var emailStatus = !hasEmail ? "Chưa thêm email" : (emailVerified ? "Email đã xác thực" : "Email chưa xác thực");
    var profileFields = new[]
    {
        new { Label = "Họ và tên", Filled = !string.IsNullOrWhiteSpace(Model.FullName) },
        new { Label = "Email", Filled = hasEmail },
        new { Label = "Số điện thoại", Filled = !string.IsNullOrWhiteSpace(Model.PhoneNumber) },
        new { Label = "Ngày sinh", Filled = !string.IsNullOrWhiteSpace(Model.DateOfBirth) },
        new { Label = "Giới tính", Filled = !string.IsNullOrWhiteSpace(Model.Gender) },
        new { Label = "Ảnh đại diện", Filled = !string.IsNullOrEmpty(avatarUrl) }
    };
    var filledFields = profileFields.Count(field => field.Filled);
    var totalFields = profileFields.Length;
    var missingFields = profileFields.Where(field => !field.Filled).Select(field => field.Label).ToArray();
    var completionPercent = (int)Math.Round(filledFields * 100.0 / totalFields, MidpointRounding.AwayFromZero);
    string ShowValue(string? value) => string.IsNullOrWhiteSpace(value) ? "Chưa cập nhật" : value;
}

<style>
    /* Chỉ áp dụng cho trang hồ sơ này, không đổi navbar hoặc trang khác. */
    .dpf {
        --pf-red: #a71930;
        --pf-red-deep: #7d1428;
        --pf-ink: #30252b;
        --pf-muted: #80737b;
        --pf-line: #eee4e8;
        --pf-soft: #fcf7f8;
        --pf-gold: #af8d5d;
        padding: 32px 0 52px;
        background: radial-gradient(ellipse at 95% 0%,#f5e6ea80,transparent 40%),#faf8f9;
        color: var(--pf-ink);
        font-family: "Open Sans","Segoe UI",Arial,sans-serif;
        font-size: 14px;
        line-height: 1.75
    }

        .dpf * {
            box-sizing: border-box
        }

        .dpf .dpf-container {
            width: calc(100% - 48px);
            max-width: 1290px;
            margin: 0 auto
        }

        .dpf :is(h1,h2,h3,p,dl,dd) {
            margin: 0
        }

        .dpf .dpf-page-title, .dpf .dpf-name, .dpf .dpf-card-title {
            font-family: "Open Sans","Segoe UI",Arial,sans-serif !important;
            letter-spacing: -.6px;
            font-weight: 700 !important;
            color: var(--pf-ink)
        }

        .dpf a {
            text-decoration: none
        }

            .dpf a:focus-visible {
                outline: 3px solid #ba3851;
                outline-offset: 4px
            }

        .dpf .dpf-icon {
            display: block;
            width: 20px;
            height: 20px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.7;
            stroke-linecap: round;
            stroke-linejoin: round;
            flex-shrink: 0
        }

        .dpf .dpf-symbols {
            position: absolute;
            width: 0;
            height: 0;
            overflow: hidden;
            pointer-events: none
        }

        .dpf .dpf-breadcrumb {
            display: flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 16px;
            color: #9b8992;
            font-size: 11px
        }

            .dpf .dpf-breadcrumb a {
                color: #88737e
            }

                .dpf .dpf-breadcrumb a:hover {
                    color: var(--pf-red)
                }

            .dpf .dpf-breadcrumb > span:last-child {
                color: #67545e
            }

        .dpf .dpf-page-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 24px
        }

        .dpf .dpf-page-title {
            font-size: clamp(26px,2.7vw,33px);
            line-height: 1.4;
            margin-bottom: 7px
        }

        .dpf .dpf-page-description {
            color: var(--pf-muted);
            font-size: 14px;
            line-height: 1.8
        }

        .dpf .dpf-page-signature {
            display: flex;
            align-items: center;
            gap: 9px;
            flex-shrink: 0;
            color: #9d7f62;
            font-size: 9px;
            font-weight: 600;
            letter-spacing: 1.6px
        }

            .dpf .dpf-page-signature > span {
                font-size: 17px;
                font-weight: 400;
                letter-spacing: 0
            }
        /* Thông báo nằm ngoài các trường dữ liệu. */
        .dpf .dpf-alert {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 14px 18px;
            margin-bottom: 19px;
            border: 1px solid;
            border-radius: 12px;
            font-size: 13px;
            overflow-wrap: anywhere
        }

            .dpf .dpf-alert .dpf-icon {
                width: 18px;
                height: 18px;
                margin-top: 3px
            }

        .dpf .dpf-alert-success {
            border-color: #d5e7dd;
            background: #f0f8f3;
            color: #2d7352
        }

        .dpf .dpf-alert-warning {
            border-color: #f0dfc3;
            background: #fff8ec;
            color: #8a621f
        }
        /* Thẻ nhận diện chạy ngang. */
        .dpf .dpf-hero {
            position: relative;
            overflow: hidden;
            background: #fff;
            border: 1px solid #e9dbe1;
            border-radius: 20px;
            box-shadow: 0 8px 30px #54213305;
            margin-bottom: 22px
        }

            .dpf .dpf-hero::before {
                position: absolute;
                inset: 0 0 auto;
                height: 4px;
                background: linear-gradient(90deg,#97172e 0%,#ba3b50 50%,#c4a176 100%);
                content: ""
            }

        .dpf .dpf-hero-main {
            display: flex;
            align-items: center;
            gap: 23px;
            padding: 27px 30px 23px;
            background: radial-gradient(ellipse at 100% 0%,#fbf1f4,transparent 53%)
        }

        .dpf .dpf-avatar-link {
            display: grid;
            justify-items: center;
            gap: 6px;
            flex-shrink: 0;
            color: var(--pf-red);
            font-size: 11px;
            font-weight: 600
        }

        .dpf .dpf-avatar-shell {
            position: relative;
            display: block;
            width: 94px;
            height: 94px;
            padding: 5px;
            border: 1px solid #e7ccd5;
            border-radius: 50%;
            background: #fff
        }

        .dpf .dpf-avatar {
            position: relative;
            display: grid;
            place-items: center;
            overflow: hidden;
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background: linear-gradient(135deg,#b42a43,#7b1329);
            color: #fff
        }

        .dpf .dpf-avatar-letter {
            font-size: 30px;
            font-weight: 600;
            line-height: 1
        }

        .dpf .dpf-avatar-image {
            position: absolute;
            inset: 0;
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover
        }

            .dpf .dpf-avatar-image[hidden] {
                display: none !important
            }

        .dpf .dpf-avatar-camera {
            position: absolute;
            right: -1px;
            bottom: 0;
            display: grid;
            place-items: center;
            width: 28px;
            height: 28px;
            border: 3px solid #fff;
            border-radius: 50%;
            background: var(--pf-red);
            color: #fff
        }

            .dpf .dpf-avatar-camera .dpf-icon {
                width: 13px;
                height: 13px
            }

        .dpf .dpf-identity {
            min-width: 0;
            flex: 1
        }

        .dpf .dpf-eyebrow {
            display: block;
            color: #a17c86;
            font-size: 9px;
            line-height: 1.7;
            font-weight: 600;
            letter-spacing: 1.7px;
            margin-bottom: 7px
        }

        .dpf .dpf-name {
            font-size: clamp(20px,2.1vw,27px);
            line-height: 1.4;
            overflow-wrap: anywhere;
            margin-bottom: 4px
        }

        .dpf .dpf-handle {
            font-size: 12px;
            color: var(--pf-muted);
            overflow-wrap: anywhere
        }

        .dpf .dpf-identity-note {
            margin-top: 10px;
            font-size: 12px;
            color: #937d87;
            line-height: 1.8
        }

        .dpf .dpf-hero-actions {
            display: grid;
            justify-items: end;
            gap: 10px;
            flex-shrink: 0;
            max-width: 250px
        }

        .dpf .dpf-primary-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            min-height: 44px;
            padding: 11px 19px;
            border: 1px solid var(--pf-red);
            border-radius: 9px;
            background: var(--pf-red);
            color: #fff;
            font-size: 13px;
            font-weight: 600;
            line-height: 1.6;
            transition: background .2s ease,box-shadow .2s ease
        }

            .dpf .dpf-primary-button .dpf-icon {
                width: 17px;
                height: 17px
            }

            .dpf .dpf-primary-button:hover {
                background: var(--pf-red-deep);
                border-color: var(--pf-red-deep);
                color: #fff;
                box-shadow: 0 5px 16px #a7193015
            }

        .dpf .dpf-hero-action-note {
            font-size: 10px;
            color: #a18b95;
            text-align: right
        }
        /* Dữ liệu tóm tắt có sẵn trong model. */
        .dpf .dpf-summary {
            display: grid;
            grid-template-columns: repeat(3,minmax(0,1fr));
            padding: 18px 30px;
            border-top: 1px solid #f1e5e9;
            background: #fffcfd;
            gap: 23px
        }

        .dpf .dpf-summary-item {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 0
        }

            .dpf .dpf-summary-item + .dpf-summary-item {
                border-left: 1px solid var(--pf-line);
                padding-left: 23px
            }

        .dpf .dpf-summary-icon {
            display: grid;
            place-items: center;
            flex-shrink: 0;
            width: 35px;
            height: 35px;
            border: 1px solid #efdee4;
            border-radius: 10px;
            background: #fff;
            color: #a77d8a
        }

            .dpf .dpf-summary-icon .dpf-icon {
                width: 17px;
                height: 17px
            }

        .dpf .dpf-summary-item > div {
            min-width: 0
        }

        .dpf .dpf-summary-label {
            display: block;
            color: #8a747f;
            font-size: 11px;
            margin-bottom: 2px
        }

        .dpf .dpf-summary-value {
            display: block;
            color: #60434f;
            font-size: 13px;
            font-weight: 600;
            line-height: 1.7;
            overflow-wrap: anywhere
        }

            .dpf .dpf-summary-value.is-verified {
                color: #377b5d
            }
        /* Hai cột cân đối trên desktop. */
        .dpf .dpf-content-grid {
            display: grid;
            grid-template-columns: minmax(0,1.45fr) minmax(0,1fr);
            gap: 22px;
            align-items: stretch
        }

        .dpf .dpf-card {
            min-width: 0;
            border: 1px solid var(--pf-line);
            border-radius: 17px;
            background: #fff;
            box-shadow: 0 4px 18px #41202d03
        }

        .dpf .dpf-card-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            padding: 22px 25px 19px;
            border-bottom: 1px solid #f3ebee
        }

        .dpf .dpf-card-title {
            font-size: 16px;
            line-height: 1.6
        }

        .dpf .dpf-card-subtitle {
            font-size: 12px;
            color: #97838d;
            line-height: 1.8;
            margin-top: 3px
        }

        .dpf .dpf-card-symbol {
            display: grid;
            place-items: center;
            flex-shrink: 0;
            width: 35px;
            height: 35px;
            border: 1px solid #f0e1e6;
            border-radius: 10px;
            color: var(--pf-red);
            background: #fff9fb
        }

            .dpf .dpf-card-symbol .dpf-icon {
                width: 17px;
                height: 17px
            }

        .dpf .dpf-info-body {
            padding: 4px 25px 22px
        }

        .dpf .dpf-info-grid {
            display: grid;
            grid-template-columns: repeat(2,minmax(0,1fr));
            column-gap: 26px
        }

        .dpf .dpf-info-field {
            min-width: 0;
            padding: 18px 0 17px;
            border-bottom: 1px solid #f2e9ed
        }

            .dpf .dpf-info-field dt {
                color: #8a747f;
                font-size: 12px;
                font-weight: 400;
                line-height: 1.7;
                margin-bottom: 6px
            }

            .dpf .dpf-info-field dd {
                color: #49353f;
                font-size: 15px;
                font-weight: 600;
                line-height: 1.8;
                overflow-wrap: anywhere
            }

                .dpf .dpf-info-field dd.is-empty {
                    color: #a18b96;
                    font-size: 13px;
                    font-weight: 400
                }

        .dpf .dpf-info-field-wide {
            grid-column: 1/-1
        }

        .dpf .dpf-email-value {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 7px 10px
        }

        .dpf .dpf-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 8px;
            border: 1px solid;
            border-radius: 20px;
            font-size: 9px;
            font-weight: 600;
            line-height: 1.7;
            letter-spacing: 0;
            vertical-align: middle
        }

            .dpf .dpf-badge .dpf-icon {
                width: 11px;
                height: 11px
            }

        .dpf .dpf-badge-verified {
            background: #f1f8f4;
            border-color: #d5e8dd;
            color: #377b5d
        }

        .dpf .dpf-badge-pending {
            background: #fff8ed;
            border-color: #eddfc7;
            color: #916b2e
        }

        .dpf .dpf-info-footer {
            display: flex;
            align-items: flex-start;
            gap: 9px;
            margin-top: 21px;
            padding: 13px 14px;
            border-radius: 10px;
            background: #fcf7f8;
            color: #8b707d;
            font-size: 12px;
            line-height: 1.8
        }

            .dpf .dpf-info-footer .dpf-icon {
                width: 15px;
                height: 15px;
                margin-top: 2px;
                color: #b58997
            }
        /* Các nút được gom về cùng một cột, không chèn trong dữ liệu. */
        .dpf .dpf-side {
            display: grid;
            gap: 18px;
            align-content: start;
            min-width: 0
        }

        .dpf .dpf-shortcuts {
            padding: 5px 20px 10px
        }

        .dpf .dpf-shortcut {
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 15px 0;
            color: inherit;
            min-height: 72px
        }

            .dpf .dpf-shortcut + .dpf-shortcut {
                border-top: 1px solid #f2e9ed
            }

        .dpf .dpf-shortcut-icon {
            display: grid;
            place-items: center;
            width: 37px;
            height: 37px;
            flex-shrink: 0;
            border: 1px solid #eedee4;
            border-radius: 11px;
            background: #fff8fa;
            color: var(--pf-red)
        }

            .dpf .dpf-shortcut-icon .dpf-icon {
                width: 18px;
                height: 18px
            }

        .dpf .dpf-shortcut-copy {
            display: block;
            min-width: 0;
            flex: 1
        }

        .dpf .dpf-shortcut-title {
            display: block;
            color: #59404c;
            font-size: 14px;
            font-weight: 600;
            line-height: 1.7
