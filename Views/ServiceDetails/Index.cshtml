@using System.Globalization
@model System.Collections.Generic.IReadOnlyList<DoraFood.Controllers.ServiceDetailsController.ServiceListItem>

@{
    ViewData["Title"] = "Dịch vụ";
    var culture = CultureInfo.GetCultureInfo("vi-VN");
}

<style>
    .df-service-index {
        max-width: 1120px;
        color: #2e1d1e;
    }

        .df-service-index .service-card {
            overflow: hidden;
            border: 1px solid #ecdacd;
            border-radius: 14px;
            background: #fff8ed;
        }

        .df-service-index .service-photo {
            display: block;
            width: 100%;
            height: auto;
            aspect-ratio: 16 / 10;
            object-fit: cover;
        }

        .df-service-index .service-name {
            overflow-wrap: anywhere;
        }

        .df-service-index .service-price {
            color: #881e2d;
        }

        .df-service-index .service-details-link {
            background: #881e2d;
            color: #fff;
        }

            .df-service-index .service-details-link:hover,
            .df-service-index .service-details-link:focus-visible {
                background: #6b1421;
                color: #fff;
            }
</style>

<section class="container df-service-index py-4 py-md-5"
         aria-labelledby="service-index-title">
    <header class="mb-4">
        <h1 id="service-index-title" class="h2 mb-2">Dịch vụ DoraFood</h1>
        <p class="mb-0">Xem thông tin và chọn dịch vụ đi kèm khi đặt bàn.</p>
    </header>

    @if (Model.Count == 0)
    {
        <p class="border rounded p-3 mb-0">
            Hiện chưa có dịch vụ nào được mở.
        </p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
            @foreach (var service in Model)
            {
                var imagePath = service.ImageUrl?.Trim();
                var detailsUrl = Url.RouteUrl(
                    "DoraFoodServiceDetails", new { slug = service.Slug });

                <div class="col">
                    <article class="card service-card h-100">
                        @if (Url.IsLocalUrl(imagePath))
                        {
                            <img class="service-photo"
                                 src="@Url.Content(imagePath)"
                                 alt=""
                                 width="640"
                                 height="400"
                                 loading="lazy" />
                        }

                        <div class="card-body d-flex flex-column align-items-start">
                            <h2 class="h5 service-name mb-2">@service.Name</h2>

                            <p class="service-price mb-3">
                                Giá cơ bản
                                <strong>@service.BasePrice.ToString("#,0.##", culture) ₫</strong>
                            </p>

                            <a class="btn btn-sm service-details-link mt-auto"
                               href="@detailsUrl"
                               aria-label="Xem chi tiết @service.Name">
                                Xem chi tiết <span aria-hidden="true">→</span>
                            </a>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</section>