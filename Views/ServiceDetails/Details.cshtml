@using System.Globalization
@model DoraFood.Controllers.ServiceDetailsController.ServiceDetailsModel

@{
    ViewData["Title"] = Model.Name + " | Dịch vụ";
    var culture = CultureInfo.GetCultureInfo("vi-VN");
    var servicesUrl = Url.RouteUrl("DoraFoodServices") ?? Url.Content("~/dich-vu");
    var bookingUrl = Url.RouteUrl("DoraFoodBooking") ?? Url.Content("~/dat-ban");
}

<style>
    .df-service-detail {
        --sd-ink: #2e1d1e;
        --sd-red: #881e2d;
        --sd-cream: #fff8ed;
        --sd-line: #ecdacd;
        width: min(1100px, calc(100% - 2rem));
        margin: clamp(1.5rem, 5vw, 3.5rem) auto;
        color: var(--sd-ink);
    }

    .df-service-detail__back {
        display: inline-flex;
        margin-bottom: 1rem;
        color: var(--sd-red);
        font-weight: 600;
    }

    .df-service-detail__card {
        display: grid;
        grid-template-columns: minmax(0, 4fr) minmax(0, 5fr);
        overflow: hidden;
        border: 1px solid var(--sd-line);
        border-radius: 18px;
        background: var(--sd-cream);
    }

    .df-service-detail__card--text {
        grid-template-columns: minmax(0, 1fr);
    }

    .df-service-detail__media {
        display: grid;
        min-height: 300px;
        overflow: hidden;
        background: #f3e6d7;
    }

    .df-service-detail__media img {
        width: 100%;
        height: 100%;
        max-height: 520px;
        object-fit: cover;
    }

    .df-service-detail__body {
        min-width: 0;
        padding: clamp(1.25rem, 4vw, 2.75rem);
        overflow-wrap: anywhere;
    }

    .df-service-detail__body h1 {
        margin: 0 0 1rem;
        color: var(--sd-ink);
        font-size: clamp(1.8rem, 4vw, 2.75rem);
        line-height: 1.15;
    }

    .df-service-detail__price {
        margin-bottom: 1rem;
        color: var(--sd-red);
        font-weight: 700;
    }

    .df-service-detail__description {
        line-height: 1.65;
        overflow-x: auto;
    }

    .df-service-detail__description img {
        max-width: 100%;
        height: auto;
    }

    .df-service-detail__book {
        display: inline-block;
        margin-top: 1rem;
        padding: .7rem 1.1rem;
        border-radius: 8px;
        background: var(--sd-red);
        color: #fff;
        font-weight: 600;
        text-decoration: none;
    }

    .df-service-detail__book:hover {
        background: #6b1421;
        color: #fff;
    }

    .df-service-detail a:focus-visible {
        outline: 2px solid var(--sd-red);
        outline-offset: 3px;
    }

    @@media (max-width: 720px) {
        .df-service-detail__card {
            grid-template-columns: minmax(0, 1fr);
        }

        .df-service-detail__media {
            min-height: 0;
            aspect-ratio: 16 / 10;
        }
    }
</style>

<section class="df-service-detail" aria-labelledby="df-service-detail-title">
    <a class="df-service-detail__back" href="@servicesUrl">← Tất cả dịch vụ</a>

    <article class="df-service-detail__card @(Model.ImageUrl is null ? "df-service-detail__card--text" : "")">
        @if (Model.ImageUrl is not null)
        {
            <div class="df-service-detail__media">
                <img src="@Model.ImageUrl" alt="@Model.Name" width="800" height="550" decoding="async" />
            </div>
        }

        <div class="df-service-detail__body">
            <h1 id="df-service-detail-title">@Model.Name</h1>

            <p class="df-service-detail__price">
                Giá cơ bản @Model.BasePrice.ToString("#,0.##", culture) ₫
            </p>

            @if (!string.IsNullOrWhiteSpace(Model.DescriptionHtml))
            {
                <div class="df-service-detail__description">@Html.Raw(Model.DescriptionHtml)</div>
            }

            <a class="df-service-detail__book" href="@bookingUrl">Đặt bàn</a>
        </div>
    </article>
</section>
