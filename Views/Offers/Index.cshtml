@using System
@using System.Globalization
@model DoraFood.ViewModels.PublicVoucherPageViewModel

@{
    ViewData["Title"] = "Ưu đãi & Voucher";
    var bookingUrl = Url.RouteUrl("DoraFoodBooking") ?? Url.Content("~/dat-ban");
    var menuUrl = Url.RouteUrl("DoraFoodMenu") ?? Url.Content("~/thuc-don");
    var culture = CultureInfo.GetCultureInfo("vi-VN");
    var expired = Model.Filter == "het-han";
    var filters = new[]
    {
        (Value: "moi-nhat", Label: "Mới nhất"),
        (Value: "con-luot", Label: "Còn lượt sử dụng"),
        (Value: "het-han", Label: "Hết hạn")
    };
    string Money(decimal amount) => amount.ToString("N0", culture) + " ₫";
}

<link rel="stylesheet" href="@Url.Content("~/assets/css/dorafood-vouchers.css")" asp-append-version="true">

<div class="df-offers">
    <div class="df-offers-shell">
        <div class="df-offers-top">
            <a href="@Url.Content("~/")"><i class="fas fa-arrow-left" aria-hidden="true"></i> Trang chủ</a>
            <a href="@bookingUrl"><i class="far fa-calendar-alt" aria-hidden="true"></i> Đặt bàn</a>
        </div>

        <header class="df-offers-hero">
            <img class="df-offers-hero-photo"
                 src="@Url.Content("~/assets/images/vouchers/noel.webp")"
                 alt="" width="1200" height="380" fetchpriority="high" decoding="async">

            <div class="df-offers-snow" aria-hidden="true">
                @for (var flake = 0; flake < 18; flake++)
                {
                    <i>✦</i>
                }
            </div>

            <div class="df-offers-hero-copy">
                <p class="df-offers-season">Giáng sinh tại DoraFood</p>
                <h1>Ưu đãi &amp; Voucher</h1>
                <button type="button" class="df-offers-music" data-df-music hidden>
                    <i class="fas fa-music" aria-hidden="true"></i>
                    <span data-df-music-label>Bật nhạc Giáng sinh</span>
                </button>
                <span class="visually-hidden" role="status" data-df-music-status></span>
                <audio data-df-audio preload="none" loop
                       src="@Url.Content("~/assets/audio/dorafood-noel.mp3")"></audio>
            </div>
        </header>

        <section class="df-offers-list" aria-labelledby="df-offers-title">
            <div class="df-offers-list-head">
                <h2 id="df-offers-title">Danh sách voucher <span>(@Model.Vouchers.Count)</span></h2>
                <nav class="df-offers-filters" aria-label="Bộ lọc voucher">
                    @foreach (var filter in filters)
                    {
                        var isCurrent = Model.Filter == filter.Value;
                        <a href="@Url.RouteUrl("DoraFoodVouchers", new { filter = filter.Value })"
                           aria-current="@(isCurrent ? "page" : null)">@filter.Label</a>
                    }
                </nav>
            </div>

            @if (Model.Vouchers.Count == 0)
            {
                <div class="df-offers-empty">
                    <i class="fas fa-ticket-alt" aria-hidden="true"></i>
                    <p>@(expired ? "Chưa có voucher hết hạn." : "Chưa có voucher còn lượt sử dụng.")</p>
                </div>
            }
            else
            {
                <div class="df-offers-grid">
                    @for (var i = 0; i < Model.Vouchers.Count; i++)
                    {
                        var voucher = Model.Vouchers[i];
                        var isPercent = voucher.DiscountType == "PERCENT";
                        var endsAt = new DateTimeOffset(DateTime.SpecifyKind(voucher.EndsAtUtc, DateTimeKind.Utc))
                            .ToOffset(TimeSpan.FromHours(7));
                        var benefit = isPercent ? voucher.DiscountValue.ToString("0.##", culture) + "%" : Money(voucher.DiscountValue);
                        var fallbackPhoto = (i % 3) switch
                        {
                            0 => "~/assets/images/vouchers/qua.webp",
                            1 => "~/assets/images/vouchers/bep.webp",
                            _ => "~/assets/images/vouchers/ban.webp"
                        };
                        var coverUrl = !string.IsNullOrWhiteSpace(voucher.CoverUrl) && Url.IsLocalUrl(voucher.CoverUrl)
                            ? voucher.CoverUrl
                            : fallbackPhoto;

                        <article class="df-offers-ticket">
                            <div class="df-offers-ticket-media">
                                <img src="@Url.Content(coverUrl)" alt="" width="780" height="520"
                                     loading="lazy" decoding="async">
                                <span class="df-offers-ticket-benefit">Giảm @benefit</span>
                            </div>
                            <div class="df-offers-ticket-body">
                                <span class="df-offers-state @(expired ? "is-expired" : "")">
                                    @if (expired)
                                    {
                                        @:Hết hạn
                                    }
                                    else if (voucher.RemainingUses is long remainingUses)
                                    {
                                        @:Còn @remainingUses lượt
                                    }
                                    else
                                    {
                                        @:Không giới hạn lượt
                                    }
                                </span>
                                <h3>@voucher.Name</h3>
                                <dl class="df-offers-terms">
                                    @if (voucher.MinimumOrder > 0)
                                    {
                                        <div><dt>Đơn tối thiểu</dt><dd>@Money(voucher.MinimumOrder)</dd></div>
                                    }
                                    @if (isPercent && voucher.MaxDiscount.HasValue)
                                    {
                                        <div><dt>Giảm tối đa</dt><dd>@Money(voucher.MaxDiscount.Value)</dd></div>
                                    }
                                    @if (voucher.PerCustomerLimit.HasValue)
                                    {
                                        <div><dt>Mỗi khách</dt><dd>@voucher.PerCustomerLimit.Value lượt</dd></div>
                                    }
                                    <div>
                                        <dt>@(expired ? "Đã hết hạn" : "Hạn dùng")</dt>
                                        <dd><time datetime="@endsAt.ToString("o", culture)">@endsAt.ToString("HH:mm · dd/MM/yyyy", culture)</time></dd>
                                    </div>
                                </dl>
                            </div>
                            @if (!expired)
                            {
                                <div class="df-offers-ticket-code">
                                    <input type="text" aria-label="Mã voucher @voucher.Name" title="@voucher.Code"
                                           value="@voucher.Code" readonly spellcheck="false" data-df-code>
                                    <button type="button" class="df-offers-copy" data-df-copy hidden>
                                        <i class="far fa-copy" aria-hidden="true"></i><span>Sao chép</span>
                                    </button>
                                </div>
                                <span class="visually-hidden" role="status" data-df-copy-status></span>
                            }
                        </article>
                    }
                </div>
            }
        </section>

        <section class="df-offers-gallery" aria-labelledby="df-offers-gallery-title">
            <div class="df-offers-gallery-head">
                <h2 id="df-offers-gallery-title">Góc DoraFood</h2>
                <a href="@menuUrl">Xem thực đơn <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
            </div>
            <div class="df-offers-gallery-grid">
                <img src="@Url.Content("~/assets/images/vouchers/bep.webp")" alt="Gà quay trên bàn tiệc"
                     width="780" height="520" loading="lazy" decoding="async">
                <img src="@Url.Content("~/assets/images/vouchers/ban.webp")" alt="Bàn tiệc với ấm trà và hoa mai"
                     width="780" height="520" loading="lazy" decoding="async">
                <img src="@Url.Content("~/assets/images/vouchers/noel.webp")" alt="Quà Giáng sinh cạnh cành thông"
                     width="1200" height="380" loading="lazy" decoding="async">
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script src="@Url.Content("~/assets/js/dorafood-vouchers.js")" asp-append-version="true" defer></script>
}
