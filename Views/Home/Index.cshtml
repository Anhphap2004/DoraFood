@{
    ViewData["Title"] = "Hương vị tinh tế, cuộc hẹn trọn vẹn";
    var menuPageUrl = Url.RouteUrl("DoraFoodMenu") ?? Url.Content("~/thuc-don");
    var reservationPageUrl = ViewData["BookingUrl"] as string ?? Url.Content("~/book.html");
}
@{
    var foodGallery = new[]
    {
        new {
            Image = "p1.jpg",
            Label = "CẢM HỨNG ẨM THỰC",
            Title = "Đánh thức vị giác"
        },
        new {
            Image = "p2.jpg",
            Label = "HƯƠNG VỊ YÊU THÍCH",
            Title = "Ngon từ ánh nhìn"
        },
        new {
            Image = "p3.jpg",
            Label = "PHÚT GIÂY THƯ GIÃN",
            Title = "Chậm lại, thưởng thức"
        },
        new {
            Image = "p4.jpg",
            Label = "SẮC VỊ HÒA QUYỆN",
            Title = "Một bàn đầy cảm hứng"
        },
        new {
            Image = "p5.webp",
            Label = "NIỀM VUI SẺ CHIA",
            Title = "Hẹn nhau bữa ngon"
        },
        new {
            Image = "p6.jfif",
            Label = "KHOẢNH KHẮC SUM VẦY",
            Title = "Trọn vị bên nhau"
        }
    };
}

<!-- Food Strip Start -->
<section class="fd-food-strip" aria-labelledby="foodStripTitle">

    <div class="container">
        <div class="df-home-intro">
            <div class="fd-food-heading">
                <span class="df-premium-label"><span aria-hidden="true"></span>DORAFOOD · DINING & MOMENTS</span>
                <h1 id="foodStripTitle">Đậm vị tinh tế.<br><em>Trọn những cuộc hẹn.</em></h1>
                <p>Một món ăn hợp ý. Một cuộc gặp đúng lúc.<br class="df-desktop-break"> Cùng DoraFood dành thời gian cho những điều đáng nhớ.</p>
                <div class="df-home-intro-actions"><a href="@menuPageUrl" class="df-premium-button">Khám phá thực đơn <span aria-hidden="true">↗</span></a><a href="@reservationPageUrl" class="df-premium-text-link">Lên lịch cuộc hẹn <span aria-hidden="true">→</span></a></div>
            </div>
            <aside class="df-editorial-box" aria-label="Cảm hứng cho cuộc hẹn">
                <span class="df-editorial-mark" aria-hidden="true">✦</span><span class="df-editorial-kicker">THE JOY OF DINING</span>
                <h2>Chọn món bạn thích.<br>Dành thời gian cho nhau.</h2>
                <p>Gia đình · Bạn bè · Những dịp đặc biệt</p>
                <a href="#df-dining-guide">Gợi ý cho cuộc hẹn của bạn <span aria-hidden="true">↗</span></a>
            </aside>
        </div>
    </div>

    <div class="fd-food-window"
         tabindex="0"
         aria-label="Bộ sưu tập ảnh ẩm thực. Chọn vùng này để tạm dừng chuyển động.">

        <div class="fd-food-track">
            @for (var copy = 0; copy < 2; copy++)
            {
                <div class="fd-food-group"
                     aria-hidden="@(copy == 1 ? "true" : "false")">

                    @for (var repeat = 0; repeat < 2; repeat++)
                    {
                        <div class="fd-food-repeat" aria-hidden="@(repeat == 1 ? "true" : "false")">
                            @foreach (var food in foodGallery)
                            {
                                <figure class="fd-food-card">

                                    <div class="fd-food-photo">
                                        <img src="@Url.Content("~/images/" + food.Image)"
                                             alt="@(copy == 0 && repeat == 0 ? food.Title : "")"
                                             draggable="false">
                                    </div>

                                    <figcaption>
                                        <div>
                                            <span class="fd-food-category">
                                                @food.Label
                                            </span>

                                            <span class="fd-food-name">
                                                @food.Title
                                            </span>
                                        </div>

                                        <span class="fd-food-detail"
                                              aria-hidden="true">✦</span>
                                    </figcaption>

                                </figure>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="container">
        <div class="fd-food-bottom">
            <span class="fd-food-note">
                <span class="fd-food-dot" aria-hidden="true"></span>
                Cảm hứng ẩm thực · Những khoảnh khắc sẻ chia
            </span>

            <button type="button"
                    class="fd-food-toggle"
                    aria-pressed="false">
                Tạm dừng
            </button>
        </div>
    </div>

</section>
<!-- Food Strip End -->
<section class="df-home-paths" aria-label="Khám phá trải nghiệm DoraFood">
    <div class="container df-home-paths-grid">
        <a href="@menuPageUrl"><span class="df-path-icon"><i class="fas fa-utensils" aria-hidden="true"></i></span><div><h2>Thực đơn theo sở thích</h2><p>Tìm món và khám phá từng danh mục.</p></div><span class="df-path-arrow" aria-hidden="true">↗</span></a>
        <a href="@menuPageUrl"><span class="df-path-icon"><i class="fas fa-concierge-bell" aria-hidden="true"></i></span><div><h2>Khẩu phần dễ lựa chọn</h2><p>Xem giá theo từng phần phục vụ.</p></div><span class="df-path-arrow" aria-hidden="true">↗</span></a>
        <a href="@reservationPageUrl"><span class="df-path-icon"><i class="far fa-calendar-check" aria-hidden="true"></i></span><div><h2>Cuộc hẹn có chuẩn bị</h2><p>Chọn thời gian, số khách và lời nhắn.</p></div><span class="df-path-arrow" aria-hidden="true">↗</span></a>
    </div>
</section>
<!-- About Start -->
<section class="fd-about" aria-labelledby="fdAboutTitle">
    <div class="container">
        <div class="row g-5 align-items-center">

            <!-- Bộ ảnh giới thiệu -->
            <div class="col-lg-6">
                <div class="fd-about-visual">

                    <span class="fd-about-outline"
                          aria-hidden="true"></span>

                    <figure class="fd-about-main">
                        <img src="~/assets/img/about.jpg"
                             alt="Không gian trải nghiệm ẩm thực DoraFood"
                             loading="lazy">

                        <figcaption>
                            <span>DORAFOOD</span>
                            Nơi những cuộc hẹn thêm trọn vẹn.
                        </figcaption>
                    </figure>

                    <div class="fd-about-inset">
                        <img src="~/assets/img/menu-04.jpg"
                             alt="Một góc sắc màu ẩm thực DoraFood"
                             loading="lazy">
                    </div>

                    <div class="fd-about-seal">
                        <i class="fas fa-utensils"
                           aria-hidden="true"></i>
                        <span>Chạm vị ngon</span>
                        <strong>Gắn kết yêu thương</strong>
                    </div>
                </div>
            </div>

            <!-- Nội dung giới thiệu -->
            <div class="col-lg-6">
                <div class="fd-about-content">
                    <span class="fd-about-eyebrow">
                        CÂU CHUYỆN DORAFOOD
                    </span>

                    <h2 id="fdAboutTitle">
                        Không chỉ là bữa ăn.<br>
                        <span>Là thời gian bên nhau.</span>
                    </h2>

                    <p class="fd-about-lead">
                        Có những câu chuyện chỉ cần một bàn ăn ngon
                        để bắt đầu.
                    </p>

                    <p class="fd-about-description">
                        Một buổi hẹn cùng bạn bè, bữa cơm bên gia đình
                        hay dịp gặp mặt đặc biệt — DoraFood mong muốn
                        trở thành một phần trong những khoảnh khắc ấy,
                        qua hương vị món ăn và niềm vui được quây quần.
                    </p>

                    <div class="fd-about-values">
                        <div class="fd-about-value">
                            <span class="fd-about-icon">
                                <i class="fas fa-concierge-bell"
                                   aria-hidden="true"></i>
                            </span>

                            <div>
                                <h3>Chăm chút từng món</h3>
                                <p>
                                    Từ hương vị đến cách bày biện,
                                    mỗi chi tiết đều góp phần tạo cảm hứng.
                                </p>
                            </div>
                        </div>

                        <div class="fd-about-value">
                            <span class="fd-about-icon">
                                <i class="far fa-heart"
                                   aria-hidden="true"></i>
                            </span>

                            <div>
                                <h3>Trân trọng từng cuộc hẹn</h3>
                                <p>
                                    Để bữa ăn là khoảng thời gian
                                    thoải mái dành cho những người thân quý.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="fd-about-signoff">
                        <span class="fd-about-signoff-line"
                              aria-hidden="true"></span>
                        <span>
                            Một bàn ăn ngon.
                            <strong>Nhiều điều để nhớ.</strong>
                        </span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
<!-- About End -->
@await Html.PartialAsync("_HomeSections")
<!-- Hướng dẫn lựa chọn và FAQ bổ sung -->
<section class="df-dining-guide" id="df-dining-guide" aria-labelledby="dfGuideTitle">
    <div class="container">
        <div class="df-guide-heading"><div><span class="df-premium-label">CHO MỘT CUỘC HẸN TRỌN VẸN</span><h2 id="dfGuideTitle">Một chút chuẩn bị.<br><span>Thêm nhiều niềm vui.</span></h2></div><p>Ba gợi ý nhỏ để bạn dễ chọn món và sắp xếp buổi gặp gỡ.</p></div>
        <div class="df-guide-grid">
            <article><span class="df-guide-number">01</span><h3>Chọn hương vị hợp ý</h3><p>Dùng danh mục và ô tìm kiếm để xem món bạn thích. Kiểm tra tên món, mô tả và từng khẩu phần trước khi lựa chọn.</p><a href="@menuPageUrl">Mở thực đơn <span aria-hidden="true">↗</span></a></article>
            <article><span class="df-guide-number">02</span><h3>Hẹn một thời gian phù hợp</h3><p>Dự kiến số khách, ngày và giờ đến. Nếu có dịp đặc biệt hoặc mong muốn về vị trí ngồi, hãy ghi lại để trao đổi với nhà hàng.</p><a href="@reservationPageUrl">Chuẩn bị cuộc hẹn <span aria-hidden="true">↗</span></a></article>
            <article><span class="df-guide-number">03</span><h3>Nhắn những điều cần lưu ý</h3><p>Cho nhà hàng biết nếu bạn có dị ứng, món kiêng hoặc yêu cầu riêng. Kiểm tra lại thông tin và trạng thái đặt bàn trước khi đến.</p><a href="#df-faq">Xem điều cần biết <span aria-hidden="true">↗</span></a></article>
        </div>
    </div>
</section>
<section class="df-faq-section" id="df-faq" aria-labelledby="dfFaqTitle">
    <div class="container df-faq-layout">
        <div class="df-faq-intro"><span class="df-premium-label">ĐIỀU BẠN MUỐN BIẾT</span><h2 id="dfFaqTitle">Trước cuộc hẹn,<br><span>mình cùng làm rõ.</span></h2><p>Một vài thông tin để bạn dễ khám phá thực đơn và chuẩn bị bữa ăn.</p><a href="@menuPageUrl" class="df-premium-text-link">Khám phá thực đơn <span aria-hidden="true">↗</span></a></div>
        <div class="df-faq-list">
            <details open><summary>Làm sao để tìm món phù hợp?<span aria-hidden="true">+</span></summary><div>Vào trang Thực đơn, chọn danh mục hoặc nhập tên món. Bạn có thể sắp xếp theo món nổi bật, tên món hoặc giá để dễ so sánh.</div></details>
            <details><summary>Giá món ăn được hiển thị như thế nào?<span aria-hidden="true">+</span></summary><div>Giá được hiển thị theo từng khẩu phần và đơn vị phục vụ trong thẻ món ăn. Hãy xem đúng khẩu phần bạn muốn chọn trước khi quyết định.</div></details>
            <details><summary>Tôi cần chuẩn bị gì khi đặt bàn?<span aria-hidden="true">+</span></summary><div>Chuẩn bị tên, số điện thoại, ngày giờ dự kiến và số khách. Ghi thêm những mong muốn riêng, sau đó kiểm tra trạng thái xác nhận của yêu cầu.</div></details>
            <details><summary>Nếu có dị ứng hoặc món cần kiêng thì sao?<span aria-hidden="true">+</span></summary><div>Xem thông tin lưu ý trên món nếu có, đồng thời trao đổi trực tiếp với nhân viên về nguyên liệu cần tránh trước khi gọi món.</div></details>
        </div>
    </div>
</section>
