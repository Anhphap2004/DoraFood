@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment TetEnvironment
@functions {
    // File names below are fixed by the view, not supplied by visitors.
    private string TetPhoto(string fileName, string fallback)
    {
        var webRoot = TetEnvironment.WebRootPath;
        var exists = !string.IsNullOrEmpty(webRoot)
            && System.IO.File.Exists(System.IO.Path.Combine(webRoot, "assets", "img", "tet", fileName));
        return Url.Content(exists ? "~/assets/img/tet/" + fileName : fallback);
    }
}
@{
    ViewData["Title"] = "Sắc xuân sum vầy, trọn vị yêu thương";
    ViewData["Description"] = "Khám phá hương vị, cảm hứng bàn tiệc và những cuộc hẹn đầu xuân cùng DoraFood.";
    var menuPageUrl = Url.RouteUrl("DoraFoodMenu") ?? Url.Content("~/thuc-don");
    var reservationPageUrl = ViewData["BookingUrl"] as string ?? Url.Content("~/book.html");
}
@{
    var foodGallery = new[]
    {
        new {
            Image = "p1.jpg",
            Label = "CẢM HỨNG ẨM THỰC",
            Title = "Đánh thức vị giác"
        },
        new {
            Image = "p2.jpg",
            Label = "HƯƠNG VỊ YÊU THÍCH",
            Title = "Ngon từ ánh nhìn"
        },
        new {
            Image = "p3.jpg",
            Label = "PHÚT GIÂY THƯ GIÃN",
            Title = "Chậm lại, thưởng thức"
        },
        new {
            Image = "p4.jpg",
            Label = "SẮC VỊ HÒA QUYỆN",
            Title = "Một bàn đầy cảm hứng"
        },
        new {
            Image = "p5.webp",
            Label = "NIỀM VUI SẺ CHIA",
            Title = "Hẹn nhau bữa ngon"
        },
        new {
            Image = "p6.jfif",
            Label = "KHOẢNH KHẮC SUM VẦY",
            Title = "Trọn vị bên nhau"
        }
    };
}

<div class="df-tet-home df-tet-editorial" data-tet-home>
    <!-- Food Strip Start -->
    <section class="fd-food-strip df-tet-intro" aria-labelledby="foodStripTitle">
        <div class="df-tet-decor" aria-hidden="true">
            <img class="df-tet-lantern df-tet-lantern--left" src="@TetPhoto("couplet.webp", "~/assets/img/tet-motion/nam-moi-hanh-phuc-binh-an-den.webp")" alt="" width="110">
            <img class="df-tet-lantern df-tet-lantern--right" src="@Url.Content("~/assets/img/tet-motion/lantern.svg")" alt="" width="60" height="90">
            @for (var petal = 0; petal < 7; petal++)
            {
                <span class="df-tet-petal" style="--petal-index: @petal"></span>
            }
        </div>

        <div class="container">
            <div class="df-home-intro">
                <div class="fd-food-heading">
                    <span class="df-premium-label"><span aria-hidden="true"></span>DORAFOOD · HƯƠNG VỊ NGÀY XUÂN</span>
                    <h1 id="foodStripTitle">Tết thêm rộn ràng.<br><em>Sum vầy thêm trọn vị.</em></h1>
                    <p>Sắc xuân bên bàn tiệc, niềm vui trong từng cuộc hẹn.<br class="df-desktop-break"> Cùng DoraFood dành một bữa ngon cho những người thương.</p>
                    <div class="df-tet-seasons" aria-label="Chủ đề mùa xuân"><span>Ẩm thực</span><span>Sum vầy</span><span>Khởi đầu mới</span></div>
                    <div class="df-home-intro-actions"><a href="@menuPageUrl" class="df-premium-button">Khám phá thực đơn <span aria-hidden="true">↗</span></a><a href="@reservationPageUrl" class="df-premium-text-link">Lên lịch cuộc hẹn <span aria-hidden="true">→</span></a></div>
                    <a class="df-tet-discover" href="#df-events">Khám phá sắc Tết <span aria-hidden="true">↓</span></a>
                </div>
                <aside class="df-tet-picture" aria-labelledby="tetPictureTitle">
                    <figure>
                        <div class="df-tet-carousel" data-tet-carousel role="region" aria-roledescription="trình chiếu" aria-label="Cảm hứng Tết DoraFood">
                            <div class="df-tet-picture-window">
                                <img class="df-tet-slide df-tet-table" data-tet-slide src="@TetPhoto("hero-01.webp", "~/assets/img/tet-motion/tet-table.png")" width="1600" height="900" fetchpriority="high" alt="Mâm Tết, hoa xuân và chén trà sum vầy">
                                <img class="df-tet-slide" data-tet-slide src="@TetPhoto("hero-02.webp", "~/images/p1.jpg")" width="1600" height="900" loading="lazy" alt="Cảm hứng bàn tiệc cho cuộc hẹn đầu xuân" hidden>
                                <img class="df-tet-slide" data-tet-slide src="@TetPhoto("hero-03.webp", "~/images/p4.jpg")" width="1600" height="900" loading="lazy" alt="Sắc màu ẩm thực cho những dịp quây quần" hidden>
                                <span class="df-tet-picture-tag">DORAFOOD · XUÂN SUM VẦY</span>
                            </div>
                            <div class="df-tet-carousel-controls" data-tet-carousel-controls hidden>
                                <div class="df-tet-dots" role="group" aria-label="Chọn ảnh">
                                    <button type="button" data-tet-go="0" aria-label="Xem ảnh 1" aria-pressed="true"></button>
                                    <button type="button" data-tet-go="1" aria-label="Xem ảnh 2" aria-pressed="false"></button>
                                    <button type="button" data-tet-go="2" aria-label="Xem ảnh 3" aria-pressed="false"></button>
                                </div>
                                <span class="df-tet-slide-count" data-tet-count>01 / 03</span>
                                <div class="df-tet-slide-arrows"><button type="button" data-tet-prev aria-label="Ảnh trước">←</button><button type="button" data-tet-next aria-label="Ảnh tiếp theo">→</button></div>
                            </div>
                            <span class="visually-hidden" data-tet-slide-status aria-live="polite" aria-atomic="true"></span>
                        </div>
                        <figcaption>
                            <div><span class="df-tet-kicker">GÓI GHÉM NIỀM VUI</span><h2 id="tetPictureTitle">Vị Tết thân quen.<br>Cuộc hẹn đáng nhớ.</h2></div>
                            <a href="#df-events" aria-label="Khám phá bộ ảnh sắc xuân"><span aria-hidden="true">↘</span></a>
                        </figcaption>
                    </figure>
                    <span class="df-tet-stamp" aria-hidden="true">TẾT<br><b>SUM VẦY</b></span>
                    <img class="df-tet-envelope" src="@Url.Content("~/assets/img/tet-motion/envelope.svg")" alt="" aria-hidden="true" width="64" height="84">
                </aside>
            </div>
        </div>

        <div class="fd-food-window"
             tabindex="0"
             aria-label="Bộ sưu tập ảnh ẩm thực. Chọn vùng này để tạm dừng chuyển động.">

            <div class="fd-food-track">
                @for (var copy = 0; copy < 2; copy++)
                {
                    <div class="fd-food-group"
                         aria-hidden="@(copy == 1 ? "true" : "false")">

                        @for (var repeat = 0; repeat < 2; repeat++)
                        {
                            <div class="fd-food-repeat" aria-hidden="@(repeat == 1 ? "true" : "false")">
                                @foreach (var food in foodGallery)
                                {
                                    <figure class="fd-food-card">

                                        <div class="fd-food-photo">
                                            <img src="@Url.Content("~/images/" + food.Image)"
                                                 alt="@(copy == 0 && repeat == 0 ? food.Title : "")"
                                                 draggable="false">
                                        </div>

                                        <figcaption>
                                            <div>
                                                <span class="fd-food-category">
                                                    @food.Label
                                                </span>

                                                <span class="fd-food-name">
                                                    @food.Title
                                                </span>
                                            </div>

                                            <span class="fd-food-detail"
                                                  aria-hidden="true">✦</span>
                                        </figcaption>

                                    </figure>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="container">
            <div class="fd-food-bottom">
                <span class="fd-food-note">
                    <span class="fd-food-dot" aria-hidden="true"></span>
                    Cảm hứng ẩm thực · Những khoảnh khắc sẻ chia
                </span>

                <button type="button"
                        class="fd-food-toggle"
                        aria-pressed="false">
                    Tạm dừng
                </button>
            </div>
        </div>
        @await Component.InvokeAsync("VoucherPromotions")
    </section>
    <!-- Food Strip End -->
    <section class="df-tet-wishes" id="df-tet-wishes" aria-label="Lời chúc đầu xuân">
        <div class="container df-tet-wishes-inner">
            <div class="df-tet-wishes-title"><span aria-hidden="true">✿</span><div><span class="df-tet-kicker">LỜI CHÚC ĐẦU XUÂN</span><h2>An khang · Đoàn viên · Như ý</h2></div></div>
            <p>Chúc bạn một mùa Tết ấm áp,<br>đủ đầy hương vị và những tiếng cười.</p>
            <button class="df-tet-motion-toggle" type="button" aria-pressed="false" hidden>Tạm dừng trang trí</button>
        </div>
    </section>
    <section class="df-home-paths df-tet-paths" aria-label="Khám phá trải nghiệm DoraFood">
        <div class="container df-home-paths-grid">
            <a href="@menuPageUrl"><span class="df-path-icon"><i class="fas fa-utensils" aria-hidden="true"></i></span><div><h2>Khai vị một mùa vui</h2><p>Tìm món và khám phá từng danh mục.</p></div><span class="df-path-arrow" aria-hidden="true">↗</span></a>
            <a href="@menuPageUrl"><span class="df-path-icon"><i class="fas fa-concierge-bell" aria-hidden="true"></i></span><div><h2>Gợi mở bàn tiệc xuân</h2><p>Xem giá theo từng phần phục vụ.</p></div><span class="df-path-arrow" aria-hidden="true">↗</span></a>
            <a href="@reservationPageUrl"><span class="df-path-icon"><i class="far fa-calendar-check" aria-hidden="true"></i></span><div><h2>Hẹn nhau ngày sum họp</h2><p>Chọn thời gian, số khách và lời nhắn.</p></div><span class="df-path-arrow" aria-hidden="true">↗</span></a>
        </div>
    </section>
    <!-- About Start -->
    <section class="fd-about" data-tet-reveal aria-labelledby="fdAboutTitle">
        <div class="container">
            <div class="row g-5 align-items-center">

                <!-- Bộ ảnh giới thiệu -->
                <div class="col-lg-6">
                    <div class="fd-about-visual">

                        <span class="fd-about-outline"
                              aria-hidden="true"></span>

                        <figure class="fd-about-main">
                            <img src="@TetPhoto("about-01.webp", "~/assets/img/about.jpg")"
                                 alt="Không gian trải nghiệm ẩm thực DoraFood"
                                 loading="lazy">

                            <figcaption>
                                <span>DORAFOOD</span>
                                Nơi những cuộc hẹn thêm trọn vẹn.
                            </figcaption>
                        </figure>

                        <div class="fd-about-inset">
                            <img src="~/assets/img/tet/5.png"
                                 alt="Một góc sắc màu ẩm thực DoraFood"
                                 loading="lazy">
                        </div>

                        <div class="fd-about-seal">
                            <i class="fas fa-utensils"
                               aria-hidden="true"></i>
                            <span>Chạm vị ngon</span>
                            <strong>Gắn kết yêu thương</strong>
                        </div>
                    </div>
                </div>

                <!-- Nội dung giới thiệu -->
                <div class="col-lg-6">
                    <div class="fd-about-content">
                        <span class="fd-about-eyebrow">
                            CÂU CHUYỆN DORAFOOD
                        </span>

                        <h2 id="fdAboutTitle">
                            Tết bắt đầu từ<br>
                            <span>những điều thân thương.</span>
                        </h2>

                        <p class="fd-about-lead">
                            Một bữa ngon, vài câu chuyện cũ và những lời chúc mới.
                            Đôi khi, niềm vui ngày Tết giản dị như thế.
                        </p>

                        <p class="fd-about-description">
                            Một buổi hẹn cùng bạn bè, bữa cơm bên gia đình
                            hay dịp gặp mặt đặc biệt — DoraFood mong muốn
                            trở thành một phần trong những khoảnh khắc ấy,
                            qua hương vị món ăn và niềm vui được quây quần.
                        </p>

                        <div class="fd-about-values">
                            <div class="fd-about-value">
                                <span class="fd-about-icon">
                                    <i class="fas fa-concierge-bell"
                                       aria-hidden="true"></i>
                                </span>

                                <div>
                                    <h3>Chăm chút từng món</h3>
                                    <p>
                                        Từ hương vị đến cách bày biện,
                                        mỗi chi tiết đều góp phần tạo cảm hứng.
                                    </p>
                                </div>
                            </div>

                            <div class="fd-about-value">
                                <span class="fd-about-icon">
                                    <i class="far fa-heart"
                                       aria-hidden="true"></i>
                                </span>

                                <div>
                                    <h3>Trân trọng từng cuộc hẹn</h3>
                                    <p>
                                        Để bữa ăn là khoảng thời gian
                                        thoải mái dành cho những người thân quý.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="fd-about-signoff">
                            <span class="fd-about-signoff-line"
                                  aria-hidden="true"></span>
                            <span>
                                Một bàn ăn ngon.
                                <strong>Nhiều điều để nhớ.</strong>
                            </span>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>
    <!-- About End -->
    @await Html.PartialAsync("_HomeSections")
    <!-- Hướng dẫn lựa chọn và FAQ bổ sung -->
    <section class="df-dining-guide" id="df-dining-guide" aria-labelledby="dfGuideTitle">
        <div class="container">
            <div class="df-guide-heading"><div><span class="df-premium-label">CHO MỘT CUỘC HẸN TRỌN VẸN</span><h2 id="dfGuideTitle">Một chút chuẩn bị.<br><span>Thêm nhiều niềm vui.</span></h2></div><p>Ba gợi ý nhỏ để bạn dễ chọn món và sắp xếp buổi gặp gỡ.</p></div>
            <div class="df-guide-grid">
                <article><span class="df-guide-number">01</span><h3>Chọn hương vị hợp ý</h3><p>Dùng danh mục và ô tìm kiếm để xem món bạn thích. Kiểm tra tên món, mô tả và từng khẩu phần trước khi lựa chọn.</p><a href="@menuPageUrl">Mở thực đơn <span aria-hidden="true">↗</span></a></article>
                <article><span class="df-guide-number">02</span><h3>Hẹn một thời gian phù hợp</h3><p>Dự kiến số khách, ngày và giờ đến. Nếu có dịp đặc biệt hoặc mong muốn về vị trí ngồi, hãy ghi lại để trao đổi với nhà hàng.</p><a href="@reservationPageUrl">Chuẩn bị cuộc hẹn <span aria-hidden="true">↗</span></a></article>
                <article><span class="df-guide-number">03</span><h3>Nhắn những điều cần lưu ý</h3><p>Cho nhà hàng biết nếu bạn có dị ứng, món kiêng hoặc yêu cầu riêng. Kiểm tra lại thông tin và trạng thái đặt bàn trước khi đến.</p><a href="#df-faq">Xem điều cần biết <span aria-hidden="true">↗</span></a></article>
            </div>
        </div>
    </section>
    <section class="df-faq-section" id="df-faq" aria-labelledby="dfFaqTitle">
        <div class="container df-faq-layout">
            <div class="df-faq-intro"><span class="df-premium-label">ĐIỀU BẠN MUỐN BIẾT</span><h2 id="dfFaqTitle">Trước cuộc hẹn,<br><span>mình cùng làm rõ.</span></h2><p>Một vài thông tin để bạn dễ khám phá thực đơn và chuẩn bị bữa ăn.</p><a href="@menuPageUrl" class="df-premium-text-link">Khám phá thực đơn <span aria-hidden="true">↗</span></a></div>
            <div class="df-faq-list">
                <details open><summary>Làm sao để tìm món phù hợp?<span aria-hidden="true">+</span></summary><div>Vào trang Thực đơn, chọn danh mục hoặc nhập tên món. Bạn có thể sắp xếp theo món nổi bật, tên món hoặc giá để dễ so sánh.</div></details>
                <details><summary>Giá món ăn được hiển thị như thế nào?<span aria-hidden="true">+</span></summary><div>Giá được hiển thị theo từng khẩu phần và đơn vị phục vụ trong thẻ món ăn. Hãy xem đúng khẩu phần bạn muốn chọn trước khi quyết định.</div></details>
                <details><summary>Tôi cần chuẩn bị gì khi đặt bàn?<span aria-hidden="true">+</span></summary><div>Chuẩn bị tên, số điện thoại, ngày giờ dự kiến và số khách. Ghi thêm những mong muốn riêng, sau đó kiểm tra trạng thái xác nhận của yêu cầu.</div></details>
                <details><summary>Nếu có dị ứng hoặc món cần kiêng thì sao?<span aria-hidden="true">+</span></summary><div>Xem thông tin lưu ý trên món nếu có, đồng thời trao đổi trực tiếp với nhân viên về nguyên liệu cần tránh trước khi gọi món.</div></details>
            </div>
        </div>
    </section>

</div>

@section Scripts {
    <script src="~/assets/js/dorafood-tet-motion.js" asp-append-version="true" defer></script>
    <script src="~/assets/js/voucher-promotions.js"
            asp-append-version="true"
            defer></script>
}

                @section Styles {
    <link rel="stylesheet"
          href="~/assets/css/voucher-promotions.css"
          asp-append-version="true" />
}

