@model DoraFood.ViewModels.UserAddressInput

@{
    ViewData["Title"] = "Sửa địa chỉ giao hàng";
}

<section class="py-5 bg-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <h1 class="h2 fw-bold mb-4">Sửa địa chỉ giao hàng</h1>

                <form asp-controller="ProfileAddresses"
                      asp-action="Edit"
                      asp-route-id="@Model.Id"
                      asp-antiforgery="true"
                      method="post"
                      class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <partial name="_AddressFields" model="Model" />
                    </div>

                    <div class="card-footer bg-white d-flex
                                justify-content-end gap-2 p-3">
                        <a asp-route="DoraFood.MyAddresses"
                           class="btn btn-outline-secondary">
                            Hủy
                        </a>

                        <button type="submit" class="btn btn-primary">
                            Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>