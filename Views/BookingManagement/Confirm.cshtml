@using System.Linq
@model DoraFood.Controllers.BookingManagementController.ConfirmBookingViewModel

@{
    ViewData["Title"] = "Chọn bàn và xác nhận";

    var reservation = Model.Reservation;

    var hasAvailableTables = Model.Tables
        .Any(t => t.IsAvailable);

    var confirmUrl = Url.RouteUrl(
        "DoraFoodConfirmBooking",
        new { id = Model.Id });
}

<section class="bg-light border-bottom py-5">
    <div class="container">

        <a href="@Url.RouteUrl("DoraFoodManageBookings")"
           class="text-decoration-none">
            <i class="fas fa-arrow-left me-2"
               aria-hidden="true"></i>
            Quản lý đặt bàn
        </a>

        <h1 class="fw-bold mt-4 mb-3"
            style="font-family: 'Segoe UI', Arial, sans-serif;">
            Chọn bàn và xác nhận
        </h1>

        <p class="text-muted mb-0">
            Chọn một hoặc nhiều bàn có tổng sức chứa
            phù hợp với số khách.
        </p>

    </div>
</section>

<section class="py-5">
    <div class="container">

        @if (TempData["BookingManagementError"] is string errorMessage)
        {
            <div class="alert alert-danger" role="alert">
                @errorMessage
            </div>
        }

        <!-- Thông tin yêu cầu -->
        <div class="border rounded-4 bg-white p-4 mb-4">

            <div class="d-flex flex-wrap align-items-center
                justify-content-between gap-3 mb-4">

                <h2 class="h4 fw-bold mb-0">
                    Thông tin yêu cầu
                </h2>

                <span class="badge bg-warning text-dark
                    rounded-pill px-3 py-2">
                    Chờ xác nhận
                </span>
            </div>

            <dl class="row g-3 mb-0">

                <div class="col-md-6">
                    <dt class="text-muted small fw-normal">
                        Mã yêu cầu
                    </dt>
                    <dd class="fw-semibold text-break mb-0">
                        @reservation.Code
                    </dd>
                </div>

                <div class="col-md-6">
                    <dt class="text-muted small fw-normal">
                        Người liên hệ
                    </dt>
                    <dd class="fw-semibold mb-0">
                        @reservation.GuestName · @reservation.GuestPhone
                    </dd>
                </div>

                <div class="col-md-4">
                    <dt class="text-muted small fw-normal">
                        Giờ đến — giờ Việt Nam
                    </dt>
                    <dd class="fw-semibold mb-0">
                        @reservation.StartsAtUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm")
                    </dd>
                </div>

                <div class="col-md-4">
                    <dt class="text-muted small fw-normal">
                        Giờ kết thúc dự kiến
                    </dt>
                    <dd class="fw-semibold mb-0">
                        @reservation.EndsAtUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm")
                    </dd>
                </div>

                <div class="col-md-4">
                    <dt class="text-muted small fw-normal">
                        Số khách
                    </dt>
                    <dd class="fw-bold text-primary mb-0">
                        @reservation.PartySize người
                    </dd>
                </div>

                @if (!string.IsNullOrWhiteSpace(reservation.Note))
                {
                    <div class="col-12">
                        <dt class="text-muted small fw-normal">
                            Ghi chú
                        </dt>
                        <dd class="mb-0"
                            style="white-space: pre-wrap; overflow-wrap: anywhere;">@reservation.Note</dd>
                    </div>
                }

            </dl>
        </div>

        <!-- Chọn bàn -->
        <form action="@confirmUrl" method="post">

            @Html.AntiForgeryToken()

            <input asp-for="Version" type="hidden" />

            <div asp-validation-summary="All"
                 class="text-danger mb-4"
                 role="alert"></div>

            <div class="border rounded-4 bg-white p-4">

                <h2 class="h4 fw-bold mb-2">
                    Các bàn đang phục vụ
                </h2>

                <p class="text-muted mb-4">
                    Tổng sức chứa các bàn được chọn phải đạt ít nhất
                    <strong>@reservation.PartySize chỗ</strong>.
                    Bàn trùng lịch sẽ không chọn được.
                </p>

                @if (Model.Tables.Count == 0)
                {
                    <div class="alert alert-warning mb-0">
                        Chưa có bàn đang hoạt động trong các khu vực
                        đang phục vụ. Cần kiểm tra dữ liệu bàn và khu vực.
                    </div>
                }
                else
                {
                    @foreach (var area in Model.Tables.GroupBy(t => t.AreaName))
                    {
                        <fieldset class="border-0 p-0 mb-4">

                            <legend class="h5 fw-bold mb-3">
                                @area.Key
                            </legend>

                            <div class="row g-3">

                                @foreach (var table in area)
                                {
                                    var isSelected =
                                        table.IsAvailable
                                        && Model.TableIds.Contains(table.Id);

                                    <div class="col-sm-6 col-lg-4 col-xl-3">
                                        <div class="border rounded-3 p-3 h-100
                                            @(!table.IsAvailable ? "bg-light" : "")">

                                            <div class="form-check">
                                                <input type="checkbox"
                                                       class="form-check-input"
                                                       id="booking-table-@table.Id"
                                                       name="TableIds"
                                                       value="@table.Id"
                                                       checked="@isSelected"
                                                       disabled="@(!table.IsAvailable)" />

                                                <label class="form-check-label"
                                                       for="booking-table-@table.Id">

                                                    <span class="d-block fw-bold">
                                                        Bàn @table.Code
                                                    </span>

                                                    <span class="text-muted small">
                                                        Sức chứa: @table.Capacity người
                                                    </span>
                                                </label>
                                            </div>

                                            <div class="mt-3">
                                                @if (table.IsAvailable)
                                                {
                                                    <span class="badge bg-success">
                                                        Không trùng lịch
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">
                                                        Đã có lịch giao nhau
                                                    </span>
                                                }
                                            </div>

                                        </div>
                                    </div>
                                }

                            </div>
                        </fieldset>
                    }

                    @if (!hasAvailableTables)
                    {
                        <div class="alert alert-warning mb-0">
                            Hiện không có bàn khả dụng trong
                            khoảng thời gian của yêu cầu này.
                        </div>
                    }
                }

            </div>

            <div class="d-flex flex-wrap align-items-center
                justify-content-between gap-3 mt-4">

                <a href="@Url.RouteUrl("DoraFoodManageBookings")"
                   class="btn btn-outline-secondary
                    rounded-pill px-4 py-3">
                    Quay lại
                </a>

                <button type="submit"
                        class="btn btn-primary rounded-pill px-4 py-3"
                        disabled="@(!hasAvailableTables)">
                    <i class="fas fa-check me-2"
                       aria-hidden="true"></i>
                    Xác nhận và phân bàn
                </button>

            </div>

            <p class="text-muted small mt-3 mb-0">
                Hệ thống sẽ kiểm tra lại lịch bàn và sức chứa
                khi bạn bấm xác nhận.
            </p>

        </form>
    </div>
</section>