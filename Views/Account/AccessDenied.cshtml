@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<section class="bg-light py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-9 col-lg-7">

                <div class="bg-white border rounded-4
                    shadow-sm text-center p-4 p-md-5">

                    <i class="fas fa-lock text-primary display-4 mb-4"
                       aria-hidden="true"></i>

                    <p class="text-primary fw-semibold mb-2">
                        LỖI 403
                    </p>

                    <h1 class="h2 fw-bold mb-3"
                        style="font-family: 'Segoe UI', Arial, sans-serif;">
                        Không có quyền truy cập
                    </h1>

                    <p class="text-muted mb-4">
                        Tài khoản của bạn chưa được cấp quyền
                        sử dụng chức năng này.
                    </p>

                    <div class="d-flex flex-wrap
                        justify-content-center gap-3">

                        <a href="@Url.Action("Index", "Home")"
                           class="btn btn-primary rounded-pill px-4 py-3">
                            <i class="fas fa-home me-2"
                               aria-hidden="true"></i>
                            Về trang chủ
                        </a>

                        @if (User.Identity?.IsAuthenticated != true)
                        {
                            <a href="@Url.Action("Login", "Account")"
                               class="btn btn-outline-primary
                                rounded-pill px-4 py-3">
                                Đăng nhập
                            </a>
                        }

                    </div>

                </div>
            </div>
        </div>
    </div>
</section>