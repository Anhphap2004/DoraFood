@using System.Globalization
@using System.Linq
@model DoraFood.ViewModels.MyBookingInvoiceViewModel

@{
    Layout = null;

    var invoice = Model.Invoice;
    var culture = CultureInfo.GetCultureInfo("vi-VN");

    var lines = invoice.InvoiceLines
        .OrderBy(line => line.LineNumber)
        .ToList();

    string Money(decimal amount) =>
        amount.ToString("N0", culture) + " ₫";

    var issuedAt = invoice.IssuedAtUtc?
        .AddHours(7)
        .ToString("dd/MM/yyyy HH:mm");

    var tableNames = Model.TableCodes.Count > 0
        ? string.Join(", ", Model.TableCodes)
        : "Chưa có thông tin";

    var detailsUrl = Url.RouteUrl(
        "DoraFoodMyBookingDetails",
        new { id = Model.ReservationId });
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Hóa đơn @invoice.Number - DoraFood</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f6f3f4;
            color: #292529;
            font-family: Arial, sans-serif;
            font-size: 14px;
            line-height: 1.6;
        }

        .page {
            width: min(850px, calc(100% - 32px));
            margin: 28px auto;
        }

        .toolbar {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 18px;
        }

        .button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 42px;
            padding: 9px 18px;
            border: 1px solid #d9cdd1;
            border-radius: 8px;
            background: white;
            color: #49343b;
            font: inherit;
            text-decoration: none;
            cursor: pointer;
        }

        .button-primary {
            background: #922f40;
            border-color: #922f40;
            color: white;
        }

        .button:hover {
            opacity: .85;
        }

        .button:focus-visible {
            outline: 3px solid #dba9b4;
            outline-offset: 3px;
        }

        .invoice {
            padding: 34px;
            border: 1px solid #e8dfe2;
            border-radius: 16px;
            background: white;
            box-shadow: 0 10px 35px rgb(0 0 0 / 5%);
        }

        .invoice-header {
            padding-bottom: 22px;
            border-bottom: 2px solid #922f40;
            text-align: center;
        }

        .brand {
            margin: 0;
            color: #922f40;
            font-size: 32px;
            font-weight: 800;
        }

        .caption {
            margin: 2px 0 18px;
            color: #666;
            font-size: 11px;
            letter-spacing: 2px;
        }

        h1 {
            margin: 0 0 8px;
            font-size: 22px;
        }

        .invoice-number {
            margin: 0;
            overflow-wrap: anywhere;
        }

        .paid {
            display: inline-block;
            margin-top: 12px;
            padding: 4px 12px;
            border: 1px solid #bbdbc5;
            border-radius: 20px;
            color: #236638;
            font-size: 12px;
            font-weight: bold;
        }

        .information {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px 24px;
            margin: 24px 0;
        }

            .information > div {
                min-width: 0;
            }

        dt {
            color: #666;
            font-size: 12px;
        }

        dd {
            margin: 3px 0 0;
            font-weight: 600;
            overflow-wrap: anywhere;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        th,
        td {
            padding: 12px 6px;
            border-bottom: 1px solid #e5e5e5;
            vertical-align: top;
        }

        th {
            background: #f7f5f6;
            font-size: 12px;
            text-align: left;
        }

        .name-column {
            width: 43%;
        }

        .quantity-column {
            width: 13%;
        }

        .price-column {
            width: 21%;
        }

        .total-column {
            width: 23%;
        }

        .text-end {
            text-align: right;
        }

        .item-name {
            overflow-wrap: anywhere;
        }

        .item-unit {
            display: block;
            margin-top: 3px;
            color: #666;
            font-size: 11px;
        }

        .summary {
            width: min(100%, 410px);
            margin: 24px 0 0 auto;
        }

        .money-row {
            display: flex;
            justify-content: space-between;
            gap: 20px;
            margin: 10px 0;
        }

            .money-row dt {
                color: inherit;
                font-size: inherit;
            }

            .money-row dd {
                margin: 0;
                flex-shrink: 0;
                text-align: right;
                font-variant-numeric: tabular-nums;
            }

        .discount {
            color: #236638;
        }

        .grand-total {
            padding-top: 14px;
            margin-top: 16px;
            border-top: 2px solid #333;
            font-size: 19px;
            font-weight: bold;
        }

        .payment {
            margin-top: 24px;
            padding-top: 8px;
            border-top: 1px dashed #aaa;
        }

        .muted {
            color: #666;
            font-size: 12px;
        }

        .warning {
            padding: 12px;
            border: 1px solid #e3ca8a;
            border-radius: 8px;
            background: #fff9eb;
        }

        .footer {
            margin-top: 28px;
            padding-top: 20px;
            border-top: 1px dashed #aaa;
            text-align: center;
        }

            .footer p {
                margin: 5px 0;
            }

        @@media (max-width: 575.98px) {
            .page {
                width: calc(100% - 20px);
                margin: 16px auto;
            }

            .invoice {
                padding: 22px 12px;
            }

            .information {
                gap: 14px;
            }

            th,
            td {
                padding: 10px 4px;
                font-size: 12px;
            }

            .grand-total {
                font-size: 16px;
            }
        }

        @@media print {
            @@page {
                size: A5 portrait;
                margin: 10mm;
            }

            body {
                background: white;
                color: black;
                font-size: 11px;
            }

            .page {
                width: 100%;
                margin: 0;
            }

            .toolbar {
                display: none;
            }

            .invoice {
                padding: 0;
                border: 0;
                border-radius: 0;
                box-shadow: none;
            }

            .brand,
            .discount,
            .paid {
                color: black;
            }

            .brand {
                font-size: 26px;
            }

            .invoice-header {
                border-bottom-color: black;
            }

            h1 {
                font-size: 18px;
            }

            th,
            td {
                padding: 8px 4px;
                font-size: 10px;
            }

            thead {
                display: table-header-group;
            }

            tr,
            .summary,
            .footer {
                break-inside: avoid;
            }

            .grand-total {
                font-size: 15px;
            }
        }
    </style>
</head>

<body>
    <main class="page">

        <div class="toolbar">
            <a href="@detailsUrl" class="button">
                ← Về chi tiết đặt bàn
            </a>

            <button type="button"
                    class="button button-primary"
                    onclick="window.print()">
                In / Lưu PDF
            </button>
        </div>

        <article class="invoice" aria-labelledby="invoice-title">

            <header class="invoice-header">
                <p class="brand">DoraFood</p>

                <p class="caption">
                    TINH HOA ẨM THỰC
                </p>

                <h1 id="invoice-title">
                    HÓA ĐƠN THANH TOÁN
                </h1>

                <p class="invoice-number">
                    Số: <strong>@invoice.Number</strong>
                </p>

                @if (Model.RemainingAmount == 0)
                {
                    <span class="paid">
                        ĐÃ THANH TOÁN ĐỦ
                    </span>
                }
            </header>

            <dl class="information">
                <div>
                    <dt>Ngày xuất hóa đơn</dt>
                    <dd>@issuedAt</dd>
                </div>

                <div>
                    <dt>Khách hàng</dt>
                    <dd>
                        @(string.IsNullOrWhiteSpace(invoice.CustomerName)
                            ? "Khách tại bàn"
                            : invoice.CustomerName)
                    </dd>
                </div>

                <div>
                    <dt>Mã đặt bàn</dt>
                    <dd>@Model.ReservationCode</dd>
                </div>

                <div>
                    <dt>Mã đơn gọi món</dt>
                    <dd>@Model.OrderCode</dd>
                </div>

                <div>
                    <dt>Các bàn đã phục vụ</dt>
                    <dd>@tableNames</dd>
                </div>

                @if (!string.IsNullOrWhiteSpace(invoice.CustomerTaxCode))
                {
                    <div>
                        <dt>Mã số thuế khách hàng</dt>
                        <dd>@invoice.CustomerTaxCode</dd>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(invoice.CustomerAddress))
                {
                    <div>
                        <dt>Địa chỉ trên hóa đơn</dt>
                        <dd>@invoice.CustomerAddress</dd>
                    </div>
                }
            </dl>

            <table>
                <caption class="muted"
                         style="text-align: left; margin-bottom: 8px;">
                    Chi tiết món ăn và dịch vụ đã chốt
                </caption>

                <thead>
                    <tr>
                        <th scope="col" class="name-column">
                            Nội dung
                        </th>

                        <th scope="col"
                            class="quantity-column text-end">
                            SL
                        </th>

                        <th scope="col"
                            class="price-column text-end">
                            Đơn giá
                        </th>

                        <th scope="col"
                            class="total-column text-end">
                            Tiền trước giảm
                        </th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var line in lines)
                    {
                        var subtotal = line.LineSubtotal
                            ?? decimal.Round(
                                line.Quantity * line.UnitPrice,
                                2,
                                MidpointRounding.AwayFromZero);

                        <tr>
                            <td class="item-name">
                                @line.Description

                                <span class="item-unit">
                                    Đơn vị: @line.Unit
                                </span>
                            </td>

                            <td class="text-end">
                                @line.Quantity.ToString(
                                    "0.###", culture)
                            </td>

                            <td class="text-end">
                                @Money(line.UnitPrice)
                            </td>

                            <td class="text-end">
                                @Money(subtotal)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <dl class="summary">
                <div class="money-row">
                    <dt>Tiền món và dịch vụ</dt>
                    <dd>@Money(invoice.Subtotal)</dd>
                </div>

                <div class="money-row discount">
                    <dt>Giảm giá</dt>
                    <dd>−@Money(invoice.DiscountAmount)</dd>
                </div>

                <div class="money-row">
                    <dt>Thuế</dt>
                    <dd>@Money(invoice.TaxAmount)</dd>
                </div>

                <div class="money-row grand-total">
                    <dt>TỔNG THANH TOÁN</dt>
                    <dd>@Money(Model.TotalAmount)</dd>
                </div>
            </dl>

            <section class="payment"
                     aria-labelledby="payment-title">

                <h2 id="payment-title"
                    style="font-size: 15px; margin-bottom: 0;">
                    Các khoản đã ghi nhận
                </h2>

                <dl class="summary">
                    <div class="money-row">
                        <dt>Tiền cọc đã thu</dt>
                        <dd>@Money(Model.DepositAmount)</dd>
                    </div>

                    <div class="money-row">
                        <dt>Tiền thanh toán đã thu</dt>
                        <dd>@Money(Model.SettlementAmount)</dd>
                    </div>

                    @if (Model.RefundedAmount > 0)
                    {
                        <div class="money-row">
                            <dt>Tiền đã hoàn</dt>
                            <dd>@Money(Model.RefundedAmount)</dd>
                        </div>
                    }

                    <div class="money-row">
                        <dt>Thực nhận sau hoàn tiền</dt>
                        <dd>@Money(Model.NetReceivedAmount)</dd>
                    </div>

                    <div class="money-row">
                        <dt>Còn phải thanh toán</dt>
                        <dd>@Money(Model.RemainingAmount)</dd>
                    </div>
                </dl>

                <p class="muted">
                    Các khoản thu và hoàn tiền được tính đến
                    thời điểm xuất hóa đơn.
                </p>

                @if (Model.RemainingAmount > 0)
                {
                    <p class="warning">
                        Khoản thu ghi nhận chưa đủ tổng hóa đơn.
                        Quý khách vui lòng liên hệ nhà hàng để kiểm tra.
                    </p>
                }
            </section>

            <footer class="footer">
                <p>
                    <strong>
                        Cảm ơn quý khách đã dùng bữa tại DoraFood!
                    </strong>
                </p>

                <p>Hẹn gặp lại quý khách.</p>
            </footer>
        </article>
    </main>
</body>
</html>