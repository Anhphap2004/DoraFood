@model DoraFood.Controllers.BookingController.BookingInput

@{
    ViewData["Title"] = "Đặt bàn";

    var bookingUrl = Url.RouteUrl("DoraFoodBooking")
        ?? Url.Content("~/dat-ban");
}

<!-- Tiêu đề trang -->
<section class="bg-light border-bottom py-5">
    <div class="container">

        <nav aria-label="Đường dẫn">
            <ol class="breadcrumb mb-3">
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "Home")">
                        Trang chủ
                    </a>
                </li>

                <li class="breadcrumb-item active"
                    aria-current="page">
                    Đặt bàn
                </li>
            </ol>
        </nav>

        <span class="text-primary fw-semibold small">
            HẸN NHAU MỘT BỮA NGON
        </span>

        <h1 class="fw-bold mt-3 mb-3"
            style="font-family: 'Segoe UI', Arial, sans-serif;">
            Đặt hẹn cùng DoraFood
        </h1>

        <p class="text-muted mb-0">
            Chia sẻ thời gian và số khách dự kiến.
            DoraFood sẽ tiếp nhận yêu cầu để sắp xếp cuộc hẹn của bạn.
        </p>

    </div>
</section>

<!-- Nội dung đặt bàn -->
<section class="py-5">
    <div class="container">
        <div class="row g-5">

            <!-- Thông tin hướng dẫn -->
            <div class="col-lg-4">

                <h2 class="h3 fw-bold mb-4"
                    style="font-family: 'Segoe UI', Arial, sans-serif;">
                    Chuẩn bị cho một cuộc hẹn trọn vẹn.
                </h2>

                <p class="text-muted">
                    Một bữa ăn gia đình, buổi gặp bạn bè
                    hay dịp sum vầy — hãy để lại thông tin
                    để nhà hàng có thể liên hệ với bạn.
                </p>

                <div class="border rounded-4 p-4 mt-4">

                    <i class="far fa-calendar-check
                    text-primary fs-3 mb-3"
                       aria-hidden="true"></i>

                    <h3 class="h5 fw-bold">
                        Chờ nhà hàng xác nhận
                    </h3>

                    <p class="text-muted mb-0">
                        Gửi form là bước tạo yêu cầu.
                        Bàn ăn chỉ được xác nhận sau khi
                        nhà hàng kiểm tra và liên hệ lại.
                    </p>

                </div>

                <div class="border rounded-4 p-4 mt-3">

                    <i class="far fa-clock text-primary fs-3 mb-3"
                       aria-hidden="true"></i>

                    <h3 class="h5 fw-bold">
                        Thời gian theo giờ Việt Nam
                    </h3>

                    <p class="text-muted mb-0">
                        Chọn giờ đến và giờ kết thúc dự kiến
                        để nhà hàng thuận tiện sắp xếp.
                    </p>

                </div>

            </div>

            <!-- Form -->
            <div class="col-lg-8">
                <div class="bg-white border rounded-4
                    shadow-sm p-4 p-md-5">

                    <h2 class="h3 fw-bold mb-2"
                        style="font-family: 'Segoe UI', Arial, sans-serif;">
                        Gửi yêu cầu đặt bàn
                    </h2>

                    <p class="text-muted mb-4">
                        Các trường có dấu
                        <span class="text-danger">*</span>
                        là bắt buộc.
                    </p>

                    @if (TempData["BookingSuccess"] is string successMessage)
                    {
                        <div class="alert alert-success text-break"
                             role="status">
                            @successMessage
                        </div>
                    }

                    <form action="@bookingUrl"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"
                             role="alert"></div>

                        <div class="row g-4">

                            <!-- Họ tên -->
                            <div class="col-md-6">
                                <label asp-for="GuestName"
                                       class="form-label fw-semibold">
                                    Họ và tên
                                    <span class="text-danger">*</span>
                                </label>

                                <input asp-for="GuestName"
                                       class="form-control rounded-3 py-3"
                                       placeholder="Nhập họ và tên"
                                       autocomplete="name"
                                       maxlength="150"
                                       required />

                                <span asp-validation-for="GuestName"
                                      class="text-danger small"></span>
                            </div>

                            <!-- Điện thoại -->
                            <div class="col-md-6">
                                <label asp-for="GuestPhone"
                                       class="form-label fw-semibold">
                                    Số điện thoại
                                    <span class="text-danger">*</span>
                                </label>

                                <input asp-for="GuestPhone"
                                       type="tel"
                                       class="form-control rounded-3 py-3"
                                       placeholder="Số điện thoại liên hệ"
                                       autocomplete="tel"
                                       maxlength="20"
                                       required />

                                <span asp-validation-for="GuestPhone"
                                      class="text-danger small"></span>
                            </div>

                            <!-- Số khách -->
                            <div class="col-12">
                                <label asp-for="PartySize"
                                       class="form-label fw-semibold">
                                    Số khách
                                    <span class="text-danger">*</span>
                                </label>

                                <input asp-for="PartySize"
                                       type="number"
                                       class="form-control rounded-3 py-3"
                                       min="1"
                                       max="32767"
                                       step="1"
                                       aria-describedby="booking-party-help"
                                       required />

                                <div id="booking-party-help"
                                     class="form-text">
                                    Nhập tổng số khách dự kiến.
                                    Nhà hàng sẽ kiểm tra khả năng sắp xếp.
                                </div>

                                <span asp-validation-for="PartySize"
                                      class="text-danger small"></span>
                            </div>

                            <!-- Giờ đến -->
                            <div class="col-md-6">
                                <label asp-for="StartsAtLocal"
                                       class="form-label fw-semibold">
                                    Giờ đến dự kiến
                                    <span class="text-danger">*</span>
                                </label>

                                <input asp-for="StartsAtLocal"
                                       type="datetime-local"
                                       asp-format="{0:yyyy-MM-ddTHH:mm}"
                                       class="form-control rounded-3 py-3"
                                       step="60"
                                       required />

                                <span asp-validation-for="StartsAtLocal"
                                      class="text-danger small"></span>
                            </div>

                            <!-- Giờ kết thúc -->
                            <div class="col-md-6">
                                <label asp-for="EndsAtLocal"
                                       class="form-label fw-semibold">
                                    Giờ kết thúc dự kiến
                                    <span class="text-danger">*</span>
                                </label>

                                <input asp-for="EndsAtLocal"
                                       type="datetime-local"
                                       asp-format="{0:yyyy-MM-ddTHH:mm}"
                                       class="form-control rounded-3 py-3"
                                       step="60"
                                       required />

                                <span asp-validation-for="EndsAtLocal"
                                      class="text-danger small"></span>
                            </div>

                            <!-- Ghi chú -->
                            <div class="col-12">
                                <label asp-for="Note"
                                       class="form-label fw-semibold">
                                    Ghi chú
                                </label>

                                <textarea asp-for="Note"
                                          class="form-control rounded-3"
                                          rows="4"
                                          maxlength="1000"
                                          placeholder="Ví dụ: có trẻ nhỏ, mong muốn vị trí ngồi hoặc yêu cầu đặc biệt..."></textarea>

                                <span asp-validation-for="Note"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <p class="text-muted small mb-3">
                                    Vui lòng kiểm tra số điện thoại trước
                                    khi gửi để nhà hàng có thể liên hệ xác nhận.
                                </p>

                                <button type="submit"
                                        class="btn btn-primary
                                    rounded-pill px-4 py-3">
                                    Gửi yêu cầu đặt bàn
                                    <i class="fas fa-arrow-right ms-2"
                                       aria-hidden="true"></i>
                                </button>
                            </div>

                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</section>