@using System
@using System.Globalization
@model DoraFood.Controllers.BookingController.BookingInput

@{
    ViewData["Title"] = "Đặt bàn";

    var bookingUrl = Url.RouteUrl("DoraFoodBooking")
        ?? Url.Content("~/dat-ban");

    var restaurantTimeZone = TimeZoneInfo.FindSystemTimeZoneById(
        "SE Asia Standard Time");

    var localNow = TimeZoneInfo.ConvertTimeFromUtc(
        DateTime.UtcNow,
        restaurantTimeZone);

    var closedMessage =
        ViewData["BookingClosedMessage"] as string;

    var bookingClosed =
        localNow.TimeOfDay >= TimeSpan.FromHours(18)
        || !string.IsNullOrWhiteSpace(closedMessage);

    var minimumArrival = localNow.Date
        .AddHours(10)
        .ToString(
            "yyyy-MM-ddTHH:mm",
            CultureInfo.InvariantCulture);

    var maximumArrival = localNow.Date
        .AddHours(22)
        .AddMinutes(-1)
        .ToString(
            "yyyy-MM-ddTHH:mm",
            CultureInfo.InvariantCulture);
}

<!-- Tiêu đề -->
<section class="bg-light border-bottom py-5">
    <div class="container">
        <nav aria-label="Đường dẫn">
            <ol class="breadcrumb mb-3">
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "Home")">
                        Trang chủ
                    </a>
                </li>

                <li class="breadcrumb-item active"
                    aria-current="page">
                    Đặt bàn
                </li>
            </ol>
        </nav>

        <span class="text-primary fw-semibold small">
            HẸN NHAU MỘT BỮA NGON
        </span>

        <h1 class="fw-bold mt-3 mb-3"
            style="font-family: 'Segoe UI', Arial, sans-serif;">
            Đặt hẹn cùng DoraFood
        </h1>

        <p class="text-muted mb-0">
            Chọn giờ đến và số khách.
            DoraFood sẽ kiểm tra bàn và xác nhận yêu cầu của bạn.
        </p>
    </div>
</section>

<!-- Nội dung -->
<section class="py-5">
    <div class="container">
        <div class="row g-5">

            <!-- Hướng dẫn -->
            <div class="col-lg-4">
                <h2 class="h3 fw-bold mb-4"
                    style="font-family: 'Segoe UI', Arial, sans-serif;">
                    Chuẩn bị cho một cuộc hẹn trọn vẹn.
                </h2>

                <p class="text-muted">
                    Một bữa ăn gia đình, buổi gặp bạn bè
                    hay dịp sum vầy — hãy để lại thông tin
                    để nhà hàng có thể liên hệ với bạn.
                </p>

                <div class="border rounded-4 p-4 mt-4">
                    <i class="far fa-clock text-primary fs-3 mb-3"
                       aria-hidden="true"></i>

                    <h3 class="h5 fw-bold">Giờ phục vụ</h3>

                    <dl class="row mb-0">
                        <dt class="col-5 fw-normal text-muted">
                            Buổi trưa
                        </dt>
                        <dd class="col-7 fw-semibold">
                            10:00–14:00
                        </dd>

                        <dt class="col-5 fw-normal text-muted">
                            Buổi tối
                        </dt>
                        <dd class="col-7 fw-semibold mb-0">
                            16:00–22:00
                        </dd>
                    </dl>
                </div>

                <div class="border rounded-4 p-4 mt-3">
                    <i class="far fa-calendar-alt text-primary fs-3 mb-3"
                       aria-hidden="true"></i>

                    <h3 class="h5 fw-bold">Nhận đặt trong ngày</h3>

                    <p class="text-muted mb-0">
                        Chỉ nhận đặt cho ngày hiện tại,
                        gửi yêu cầu trước 18:00.
                        Bạn vẫn có thể hẹn đến sau 18:00
                        trong giờ phục vụ buổi tối.
                    </p>
                </div>

                <div class="border rounded-4 p-4 mt-3">
                    <i class="far fa-calendar-check text-primary fs-3 mb-3"
                       aria-hidden="true"></i>

                    <h3 class="h5 fw-bold">
                        Chờ nhà hàng xác nhận
                    </h3>

                    <p class="text-muted mb-0">
                        Gửi form là bước tạo yêu cầu.
                        Bàn chỉ được giữ sau khi nhà hàng xác nhận.
                        Vui lòng đến đúng giờ hoặc liên hệ nếu đến muộn.
                    </p>
                </div>

                <p class="text-muted small mt-3 mb-0">
                    Tất cả thời gian trên trang tính theo giờ Việt Nam.
                </p>
            </div>

            <!-- Form -->
            <div class="col-lg-8">
                <div class="bg-white border rounded-4
                    shadow-sm p-4 p-md-5">

                    <h2 class="h3 fw-bold mb-2"
                        style="font-family: 'Segoe UI', Arial, sans-serif;">
                        Gửi yêu cầu đặt bàn
                    </h2>

                    <p class="text-muted mb-4">
                        Ngày đặt:
                        <strong>@localNow.ToString("dd/MM/yyyy")</strong>.
                        Các trường có dấu
                        <span class="text-danger">*</span>
                        là bắt buộc.
                    </p>

                    @if (TempData["BookingSuccess"] is string successMessage)
                    {
                        <div class="alert alert-success text-break"
                             role="status">
                            @successMessage
                        </div>
                    }

                    @if (bookingClosed)
                    {
                        <div class="alert alert-warning" role="status">
                            <strong>Đã hết thời gian nhận đặt mới hôm nay.</strong>

                            <p class="mb-0 mt-2">
                                Nhà hàng ngừng nhận yêu cầu mới từ 18:00.
                                Các yêu cầu đã đặt trước đó vẫn được giữ
                                theo quy định, không bị hủy vì mốc 18:00.
                            </p>
                        </div>
                    }

                    <form action="@bookingUrl" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"
                             role="alert"></div>

                        <div class="row g-4">

                            <div class="col-md-6">
                                <label asp-for="GuestName"
                                       class="form-label fw-semibold">
                                    Họ và tên
                                    <span class="text-danger">*</span>
                                </label>

                                <input asp-for="GuestName"
                                       class="form-control rounded-3 py-3"
                                       placeholder="Nhập họ và tên"
                                       autocomplete="name"
                                       maxlength="150"
                                       required />

                                <span asp-validation-for="GuestName"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="GuestPhone"
                                       class="form-label fw-semibold">
                                    Số điện thoại
                                    <span class="text-danger">*</span>
                                </label>

                                <input asp-for="GuestPhone"
                                       type="tel"
                                       class="form-control rounded-3 py-3"
                                       placeholder="Số điện thoại liên hệ"
                                       autocomplete="tel"
                                       maxlength="20"
                                       required />

                                <span asp-validation-for="GuestPhone"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PartySize"
                                       class="form-label fw-semibold">
                                    Số khách
                                    <span class="text-danger">*</span>
                                </label>

                                <input asp-for="PartySize"
                                       type="number"
                                       class="form-control rounded-3 py-3"
                                       min="1"
                                       max="32767"
                                       step="1"
                                       required />

                                <span asp-validation-for="PartySize"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="StartsAtLocal"
                                       class="form-label fw-semibold">
                                    Giờ đến dự kiến
                                    <span class="text-danger">*</span>
                                </label>

                                <input asp-for="StartsAtLocal"
                                       type="datetime-local"
                                       asp-format="{0:yyyy-MM-ddTHH:mm}"
                                       class="form-control rounded-3 py-3"
                                       min="@minimumArrival"
                                       max="@maximumArrival"
                                       step="60"
                                       aria-describedby="booking-arrival-help"
                                       required />

                                <span asp-validation-for="StartsAtLocal"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <div id="booking-arrival-help"
                                     class="bg-light border rounded-3 p-3 small">
                                    Chọn giờ đến trong ngày hôm nay và ở tương lai:
                                    <strong>10:00–trước 14:00</strong>
                                    hoặc
                                    <strong>16:00–trước 22:00</strong>.
                                    Không cần nhập giờ kết thúc dùng bữa.
                                </div>
                            </div>

                            <div class="col-12">
                                <label asp-for="Note"
                                       class="form-label fw-semibold">
                                    Ghi chú
                                </label>

                                <textarea asp-for="Note"
                                          class="form-control rounded-3"
                                          rows="4"
                                          maxlength="1000"
                                          placeholder="Ví dụ: có trẻ nhỏ, mong muốn vị trí ngồi hoặc yêu cầu đặc biệt..."></textarea>

                                <span asp-validation-for="Note"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <p class="text-muted small mb-3">
                                    Vui lòng kiểm tra số điện thoại trước
                                    khi gửi để nhà hàng có thể liên hệ xác nhận.
                                </p>

                                <button type="submit"
                                        class="btn btn-primary rounded-pill px-4 py-3"
                                        disabled="@bookingClosed">
                                    @(bookingClosed
                                        ? "Đã ngừng nhận đặt mới"
                                        : "Gửi yêu cầu đặt bàn")
                                </button>
                            </div>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>