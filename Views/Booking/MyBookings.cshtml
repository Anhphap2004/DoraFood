@model DoraFood.Controllers.BookingController.MyBookingsViewModel

@{
    ViewData["Title"] = "Lịch sử đặt bàn";

    var nowUtc = DateTime.UtcNow;
    var bookingUrl = Url.RouteUrl("DoraFoodBooking");
}

@functions {
    private (string Label, string CssClass) BookingStatus(string status)
    {
        return status switch
        {
            "PENDING" => ("Chờ xác nhận", "bg-warning text-dark"),
            "CONFIRMED" => ("Đã xác nhận", "bg-primary"),
            "SEATED" => ("Đã nhận bàn", "bg-info text-dark"),
            "COMPLETED" => ("Đã hoàn thành", "bg-success"),
            "CANCELLED" => ("Đã hủy", "bg-secondary"),
            "NO_SHOW" => ("Không đến", "bg-danger"),
            _ => ("Chưa xác định", "bg-secondary")
        };
    }
}

<!-- Tiêu đề -->
<section class="bg-light border-bottom py-5">
    <div class="container">

        <nav aria-label="Đường dẫn">
            <ol class="breadcrumb mb-3">
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "Home")">
                        Trang chủ
                    </a>
                </li>

                <li class="breadcrumb-item active"
                    aria-current="page">
                    Lịch sử đặt bàn
                </li>
            </ol>
        </nav>

        <h1 class="fw-bold mb-3"
            style="font-family: 'Segoe UI', Arial, sans-serif;">
            Những cuộc hẹn của bạn
        </h1>

        <p class="text-muted mb-0">
            Theo dõi các yêu cầu đặt bàn
            được gửi bằng tài khoản của bạn.
        </p>

    </div>
</section>

<!-- Danh sách -->
<section class="py-5">
    <div class="container">

        @if (TempData["BookingHistorySuccess"] is string successMessage)
        {
            <div class="alert alert-success" role="status">
                @successMessage
            </div>
        }

        @if (TempData["BookingHistoryError"] is string errorMessage)
        {
            <div class="alert alert-danger" role="alert">
                @errorMessage
            </div>
        }

        <div class="d-flex flex-wrap align-items-center
            justify-content-between gap-3 mb-4">

            <div>
                <h2 class="h4 fw-bold mb-1">
                    Yêu cầu đặt bàn
                </h2>

                <p class="text-muted small mb-0">
                    Tổng cộng @Model.TotalItems yêu cầu.
                    Thời gian hiển thị theo giờ Việt Nam.
                </p>
            </div>

            <a href="@bookingUrl"
               class="btn btn-primary rounded-pill px-4 py-2">
                <i class="fas fa-plus me-2"
                   aria-hidden="true"></i>
                Đặt bàn mới
            </a>

        </div>

        @if (Model.Reservations.Count == 0)
        {
            <div class="bg-light border rounded-4 text-center p-5">

                <i class="far fa-calendar-alt
                text-primary display-5 mb-3"
                   aria-hidden="true"></i>

                <h3 class="h4 fw-bold mb-3">
                    Bạn chưa có yêu cầu đặt bàn
                </h3>

                <p class="text-muted mb-4">
                    Các yêu cầu gửi khi đã đăng nhập
                    sẽ xuất hiện tại đây.
                </p>

                <a href="@bookingUrl"
                   class="btn btn-outline-primary rounded-pill px-4 py-2">
                    Khám phá cuộc hẹn mới
                </a>

            </div>
        }
        else
        {
            @foreach (var reservation in Model.Reservations)
            {
                var status = BookingStatus(reservation.Status);

                var canCancel =
                    reservation.Status == "PENDING"
                    && reservation.StartsAtUtc > nowUtc;

                <article class="border rounded-4 bg-white
                    shadow-sm p-4 mb-4">

                    <!-- Mã và trạng thái -->
                    <div class="d-flex flex-wrap align-items-start
                        justify-content-between gap-3 mb-4">

                        <div class="text-break">
                            <p class="text-muted small mb-1">
                                Mã yêu cầu
                            </p>

                            <h3 class="h6 fw-bold mb-0">
                                @reservation.Code
                            </h3>
                        </div>

                        <span class="badge rounded-pill
                            px-3 py-2 @status.CssClass">
                            @status.Label
                        </span>

                    </div>

                    <!-- Thông tin yêu cầu -->
                    <div class="row g-4">

                        <div class="col-md-6 col-lg-3">
                            <p class="text-muted small mb-1">
                                Người liên hệ
                            </p>

                            <p class="fw-semibold mb-1">
                                @reservation.GuestName
                            </p>

                            <p class="text-muted mb-0">
                                @reservation.GuestPhone
                            </p>
                        </div>

                        <div class="col-md-6 col-lg-3">
                            <p class="text-muted small mb-1">
                                Giờ đến dự kiến
                            </p>

                            <p class="fw-semibold mb-0">
                                @reservation.StartsAtUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm")
                            </p>
                        </div>

                        <div class="col-md-6 col-lg-3">
                            <p class="text-muted small mb-1">
                                Giờ kết thúc dự kiến
                            </p>

                            <p class="fw-semibold mb-0">
                                @reservation.EndsAtUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm")
                            </p>
                        </div>

                        <div class="col-md-6 col-lg-3">
                            <p class="text-muted small mb-1">
                                Số khách
                            </p>

                            <p class="fw-semibold mb-0">
                                <i class="fas fa-users text-primary me-2"
                                   aria-hidden="true"></i>
                                @reservation.PartySize người
                            </p>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(reservation.Note))
                        {
                            <div class="col-12">
                                <p class="text-muted small mb-1">
                                    Ghi chú
                                </p>

                                <p class="mb-0"
                                   style="white-space: pre-wrap; overflow-wrap: anywhere;">@reservation.Note</p>
                            </div>
                        }

                    </div>

                    <!-- Ngày gửi và thao tác -->
                    <div class="border-top mt-4 pt-3
                        d-flex flex-wrap align-items-center
                        justify-content-between gap-3">

                        <span class="text-muted small">
                            Gửi lúc
                            @reservation.CreatedAtUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm")
                        </span>

                        @if (canCancel)
                        {
                            <form action="@Url.Action("Cancel", "Booking")"
                                  method="post"
                                  onsubmit="return confirm('Bạn muốn hủy yêu cầu đặt bàn này?');">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@reservation.Id" />

                                <button type="submit"
                                        class="btn btn-outline-danger
                                    rounded-pill px-3 py-2">
                                    <i class="fas fa-times me-2"
                                       aria-hidden="true"></i>
                                    Hủy yêu cầu
                                </button>

                            </form>
                        }

                    </div>

                    @if (reservation.Status == "PENDING")
                    {
                        <p class="text-muted small mt-3 mb-0">
                            Yêu cầu đang chờ nhà hàng xác nhận.
                            Bàn ăn chưa được xác nhận giữ chỗ.
                        </p>
                    }

                </article>
            }
        }

        <!-- Phân trang -->
        @if (Model.TotalPages > 1)
        {
            var startPage = Math.Max(1, Model.CurrentPage - 2);
            var endPage = Math.Min(
                Model.TotalPages,
                Model.CurrentPage + 2);

            <nav class="mt-4" aria-label="Phân trang lịch sử đặt bàn">
                <ul class="pagination justify-content-center flex-wrap">

                    @if (Model.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               href="@Url.RouteUrl("DoraFoodMyBookings", new
                               {
                                   page = Model.CurrentPage - 1
                               })">
                                Trước
                            </a>
                        </li>
                    }

                    @for (var number = startPage;
                          number <= endPage;
                          number++)
                    {
                        var isCurrent =
                            number == Model.CurrentPage;

                        <li class="page-item @(isCurrent ? "active" : "")">
                            <a class="page-link"
                               href="@Url.RouteUrl("DoraFoodMyBookings", new
                               {
                                   page = number
                               })"
                               aria-current="@(isCurrent ? "page" : null)"
                               aria-label="Trang @number">
                                @number
                            </a>
                        </li>
                    }

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               href="@Url.RouteUrl("DoraFoodMyBookings", new
                               {
                                   page = Model.CurrentPage + 1
                               })">
                                Sau
                            </a>
                        </li>
                    }

                </ul>
            </nav>
        }

    </div>
</section>