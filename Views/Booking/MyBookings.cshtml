@using System
@using System.Globalization
@model DoraFood.Controllers.BookingController.MyBookingsViewModel

@{
    ViewData["Title"] = "Lịch sử đặt bàn";

    var culture = CultureInfo.GetCultureInfo("vi-VN");
    var nowUtc = DateTime.UtcNow;
    var bookingUrl = Url.RouteUrl("DoraFoodBooking");
    var refreshUrl = Url.RouteUrl(
        "DoraFoodMyBookings", new { page = Model.CurrentPage });

    var noelPhoto = Url.Content("~/images/vouchers/noel.webp");
    var tetPhoto = Url.Content("~/images/chat/dorafood-ban-tiec-tet.webp");

    string LocalDateTime(DateTime utc) =>
        utc.AddHours(7).ToString("dd/MM/yyyy HH:mm", culture);

    string? PageUrl(int page) =>
        Url.RouteUrl("DoraFoodMyBookings", new { page });

    (string Text, string Style) StatusLabel(string status) => status switch
    {
        "PENDING" => ("Chờ xác nhận", "pending"),
        "CONFIRMED" => ("Đã xác nhận", "confirmed"),
        "SEATED" => ("Đã vào bàn", "seated"),
        "COMPLETED" => ("Đã hoàn thành", "completed"),
        "CANCELLED" => ("Đã hủy", "inactive"),
        "NO_SHOW" => ("Không đến", "late"),
        _ => ("Chưa xác định", "inactive")
    };
}

<div class="df-booking-history">
    <nav class="bh-path" aria-label="Đường dẫn">
        <a href="@Url.Action("Index", "Home")">Trang chủ</a>
        <i class="fas fa-angle-right" aria-hidden="true"></i>
        <span aria-current="page">Lịch sử đặt bàn</span>
    </nav>

    <header class="bh-header">
        <div>
            <h1>Lịch sử đặt bàn</h1>
            <p>@Model.TotalItems lượt đặt <span aria-hidden="true">·</span> Giờ Việt Nam</p>
        </div>

        <div class="bh-header-actions">
            @if (Model.Reservations.Count > 0)
            {
                <a href="@refreshUrl" class="bh-btn bh-btn-light">
                    <i class="fas fa-sync-alt" aria-hidden="true"></i>
                    Làm mới
                </a>
            }

            <a href="@bookingUrl" class="bh-btn bh-btn-primary">
                <i class="fas fa-calendar-plus" aria-hidden="true"></i>
                Đặt bàn mới
            </a>
        </div>

        <div class="bh-season" aria-hidden="true">
            <span class="bh-season-panel bh-noel"
                  style="--bh-photo: url('@noelPhoto')">
                <span class="bh-tree"></span>
            </span>
            <span class="bh-season-panel bh-tet"
                  style="--bh-photo: url('@tetPhoto')">
                <span class="bh-lantern"></span>
            </span>
        </div>
    </header>

    @if (TempData["BookingHistorySuccess"] is string successMessage)
    {
        <div class="alert alert-success py-2 mb-3" role="status">
            @successMessage
        </div>
    }

    @if (TempData["BookingHistoryError"] is string errorMessage)
    {
        <div class="alert alert-danger py-2 mb-3" role="alert">
            @errorMessage
        </div>
    }

    @if (Model.Reservations.Count == 0)
    {
        <section class="bh-empty">
            <i class="far fa-calendar-alt" aria-hidden="true"></i>
            <h2>Bạn chưa có lượt đặt bàn</h2>
            <p>Các yêu cầu gửi khi đã đăng nhập sẽ xuất hiện tại đây.</p>
        </section>
    }
    else
    {
        <div class="bh-grid">
            @foreach (var reservation in Model.Reservations)
            {
                var titleId = $"bh-title-{reservation.Id}";
                var arrival = reservation.StartsAtUtc.AddHours(7);
                var deadlineUtc = reservation.StartsAtUtc.AddMinutes(30);
                var waiting = reservation.Status is "PENDING" or "CONFIRMED";
                var expired = waiting && nowUtc >= deadlineUtc;

                var status = StatusLabel(reservation.Status);
                var statusStyle = expired ? "late" : status.Style;

                var canCancel = reservation.Status == "PENDING"
                    && reservation.StartsAtUtc > nowUtc;

                var detailsUrl = Url.RouteUrl(
                    "DoraFoodMyBookingDetails", new { id = reservation.Id });

                var chatUrl = reservation.Status == "CONFIRMED" && nowUtc < deadlineUtc
                    ? Url.RouteUrl("DoraFoodOpenBookingChat", new { id = reservation.Id })
                    : null;

                var serviceCount = reservation.ReservationServices.Count;
                var extraLabel = serviceCount > 0
                    ? $"Thông tin đặt bàn · {serviceCount} dịch vụ"
                    : "Thông tin đặt bàn";

                var session = arrival.Hour switch
                {
                    >= 10 and < 14 => "Buổi trưa",
                    >= 16 and < 22 => "Buổi tối",
                    _ => "Ngoài khung phục vụ"
                };

                <article class="bh-ticket" aria-labelledby="@titleId">
                    <div class="bh-ticket-top">
                        <div class="bh-date" aria-hidden="true">
                            <strong>@arrival.ToString("dd", culture)</strong>
                            <span>Thg @arrival.Month</span>
                        </div>

                        <div class="bh-appointment">
                            <h2 id="@titleId">
                                @arrival.ToString("HH:mm", culture)
                                <span aria-hidden="true">·</span>
                                @arrival.ToString("dd/MM/yyyy", culture)
                            </h2>
                            <p>@session <span aria-hidden="true">·</span> @reservation.PartySize người</p>
                        </div>

                        <span class="bh-status bh-status--@statusStyle">@status.Text</span>
                    </div>

                    @if (expired)
                    {
                        <p class="bh-notice" role="status">
                            Đã qua hạn khách đến. Yêu cầu sẽ được xử lý hủy nếu nhà hàng chưa nhận khách.
                        </p>
                    }
                    else if (waiting)
                    {
                        <p class="bh-deadline">
                            <i class="far fa-clock" aria-hidden="true"></i>
                            Hạn khách đến <strong>@LocalDateTime(deadlineUtc)</strong>
                        </p>
                    }

                    <details class="bh-extra">
                        <summary>
                            <span>@extraLabel</span>
                            <i class="fas fa-chevron-down" aria-hidden="true"></i>
                        </summary>

                        <div class="bh-extra-body">
                            <dl class="bh-facts">
                                <div><dt>Mã yêu cầu</dt><dd>@reservation.Code</dd></div>
                                <div><dt>Người liên hệ</dt><dd>@reservation.GuestName</dd></div>
                                <div><dt>Số điện thoại</dt><dd>@reservation.GuestPhone</dd></div>
                                <div><dt>Gửi lúc</dt><dd>@LocalDateTime(reservation.CreatedAtUtc)</dd></div>

                                @if (!string.IsNullOrWhiteSpace(reservation.Note))
                                {
                                    <div>
                                        <dt>Ghi chú</dt>
                                        <dd class="bh-note">@reservation.Note</dd>
                                    </div>
                                }
                            </dl>

                            @if (serviceCount > 0)
                            {
                                @await Html.PartialAsync(
                                    "_MyBookingServices", reservation.ReservationServices)
                            }
                        </div>
                    </details>

                    @if (detailsUrl != null || chatUrl != null || canCancel)
                    {
                        <div class="bh-ticket-actions">
                            @if (detailsUrl != null)
                            {
                                <a href="@detailsUrl" class="bh-btn bh-btn-detail">
                                    Xem chi tiết
                                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                </a>
                            }

                            @if (chatUrl != null)
                            {
                                <form action="@chatUrl" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="bh-btn bh-btn-chat">
                                        <i class="far fa-comment-dots" aria-hidden="true"></i>
                                        Tư vấn món
                                    </button>
                                </form>
                            }

                            @if (canCancel)
                            {
                                <form action="@Url.Action("Cancel", "Booking")"
                                      method="post"
                                      onsubmit="return confirm('Bạn muốn hủy yêu cầu đặt bàn này?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@reservation.Id">

                                    <button type="submit" class="bh-btn bh-btn-cancel">
                                        Hủy yêu cầu
                                    </button>
                                </form>
                            }
                        </div>
                    }
                </article>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            var firstPage = Math.Max(1, Model.CurrentPage - 2);
            var lastPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

            <nav class="bh-pagination" aria-label="Phân trang lịch sử đặt bàn">
                @if (Model.CurrentPage > 1)
                {
                    <a href="@PageUrl(Model.CurrentPage - 1)"
                       class="bh-btn bh-btn-light">Trước</a>
                }

                @for (var number = firstPage; number <= lastPage; number++)
                {
                    <a href="@PageUrl(number)"
                       class="bh-btn bh-btn-light"
                       aria-label="Trang @number"
                       aria-current="@(number == Model.CurrentPage ? "page" : null)">
                        @number
                    </a>
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a href="@PageUrl(Model.CurrentPage + 1)"
                       class="bh-btn bh-btn-light">Sau</a>
                }
            </nav>
        }
    }
</div>

<style>
    .df-booking-history {
        --bh-ink: #342e2c;
        --bh-muted: #625652;
        --bh-wine: #7d3946;
        --bh-pine: #34614f;
        --bh-line: #e8ddd4;
        width: min(calc(100% - 28px), 64rem);
        margin-inline: auto;
        padding-block: 14px 28px;
        color: var(--bh-ink);
        line-height: 1.45;
    }

        .df-booking-history, .df-booking-history * {
            box-sizing: border-box;
        }

    .bh-path, .bh-header-actions, .bh-ticket-actions, .bh-pagination {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 7px;
    }

    .bh-path {
        margin-bottom: 9px;
        color: var(--bh-muted);
        font-size: .81rem;
    }

        .bh-path a {
            color: var(--bh-wine);
        }

    .bh-header {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto auto;
        align-items: center;
        gap: 13px;
        margin-bottom: 13px;
        padding: 12px 14px;
        border: 1px solid var(--bh-line);
        border-radius: 14px;
        background: linear-gradient(105deg, #fffaf1, #fbf7f0 56%, #edf3eb);
    }

    .df-booking-history .bh-header h1 {
        margin: 0;
        color: var(--bh-ink);
        font-size: clamp(1.25rem, 2.6vw, 1.75rem);
        font-weight: 600;
        line-height: 1.2;
    }

    .bh-header p, .bh-appointment p {
        margin: 3px 0 0;
        color: var(--bh-muted);
        font-size: .83rem;
    }

    .bh-season {
        display: flex;
        height: 56px;
        overflow: hidden;
        border: 1px solid #e2d1bf;
        border-radius: 9px;
    }

    .bh-season-panel {
        position: relative;
        display: grid;
        width: 54px;
        place-items: center;
        background: linear-gradient(145deg, var(--bh-cover), var(--bh-cover)), var(--bh-photo) center / cover, var(--bh-cover-base);
    }

    .bh-noel {
        --bh-cover: #25443894;
        --bh-cover-base: #345f4b;
    }

    .bh-tet {
        --bh-cover: #7b283785;
        --bh-cover-base: #994759;
        border-left: 1px solid #ffe8ce80;
    }

    .bh-tree {
        width: 25px;
        height: 34px;
        background: linear-gradient(145deg, #e9efb9, #9bc99e);
        clip-path: polygon(50% 0, 74% 38%, 65% 38%, 87% 64%, 75% 64%, 100% 87%, 59% 87%, 59% 100%, 41% 100%, 41% 87%, 0 87%, 25% 64%, 13% 64%, 35% 38%, 26% 38%);
        animation: bh-season-bob 1.35s ease-in-out 2;
    }

    .bh-lantern {
        position: relative;
        width: 25px;
        height: 23px;
        border: 1px solid #ffe2a6;
        border-radius: 45%;
        background: repeating-linear-gradient(90deg, #d65452 0 4px, #ef8769 4px 6px);
        box-shadow: 0 0 12px #ffcc7e58;
        animation: bh-season-bob 1.35s ease-in-out .15s 2;
    }

        .bh-lantern::before, .bh-lantern::after {
            position: absolute;
            left: calc(50% - 1px);
            width: 2px;
            background: #ffe0a0;
            content: "";
        }

        .bh-lantern::before {
            top: -8px;
            height: 7px;
        }

        .bh-lantern::after {
            bottom: -7px;
            height: 6px;
        }

    @@keyframes bh-season-bob {
        50% {
            transform: translateY(-3px) rotate(-6deg);
        }
    }

    .bh-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        align-items: start;
        gap: 11px;
    }

    .bh-ticket, .bh-empty {
        min-width: 0;
        border: 1px solid var(--bh-line);
        border-radius: 12px;
        background: #fffefa;
    }

    .bh-ticket {
        padding: 11px 12px;
        box-shadow: 0 3px 9px #543d2810;
    }

    .bh-empty {
        padding: 22px 14px;
        text-align: center;
    }

        .bh-empty > i {
            color: var(--bh-wine);
            font-size: 1.3rem;
        }

        .bh-empty p {
            margin: 4px 0 0;
            color: var(--bh-muted);
            font-size: .88rem;
        }

    .bh-ticket-top {
        display: grid;
        grid-template-columns: 45px minmax(0, 1fr) auto;
        align-items: center;
        gap: 8px;
    }

    .bh-date {
        display: grid;
        place-content: center;
        min-height: 45px;
        border-radius: 8px;
        background: #f5ebe2;
        color: var(--bh-wine);
        line-height: 1.12;
        text-align: center;
    }

        .bh-date strong {
            font-size: 1.08rem;
            font-weight: 600;
        }

        .bh-date span {
            margin-top: 2px;
            font-size: .69rem;
        }

    .df-booking-history .bh-appointment h2,
    .df-booking-history .bh-empty h2 {
        margin: 0;
        color: var(--bh-ink);
        font-size: .98rem;
        font-weight: 600;
        line-height: 1.35;
    }

    .bh-status {
        justify-self: end;
        padding: 3px 7px;
        border-radius: 7px;
        background: #efebe8;
        color: #564b48;
        font-size: .73rem;
        font-weight: 500;
        text-align: center;
    }

    .bh-status--pending {
        background: #fbefd1;
        color: #6a4c18;
    }

    .bh-status--confirmed, .bh-status--completed {
        background: #e8f1e7;
        color: #34583d;
    }

    .bh-status--seated {
        background: #e8eff7;
        color: #36546d;
    }

    .bh-status--late {
        background: #fae7e8;
        color: #823a46;
    }

    .bh-deadline, .bh-notice {
        margin: 7px 0 0;
        color: var(--bh-muted);
        font-size: .8rem;
    }

        .bh-deadline i {
            margin-right: 3px;
            color: var(--bh-pine);
        }

        .bh-deadline strong {
            font-weight: 500;
        }

    .bh-notice {
        padding: 5px 7px;
        border-radius: 6px;
        background: #fff0da;
        color: #6f4826;
    }

    .bh-extra {
        margin-top: 8px;
        border-top: 1px solid var(--bh-line);
    }

        .bh-extra summary {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
            min-height: 32px;
            padding: 4px 0;
            color: var(--bh-wine);
            cursor: pointer;
            font-size: .82rem;
            font-weight: 500;
            list-style: none;
        }

            .bh-extra summary::-webkit-details-marker {
                display: none;
            }

        .bh-extra[open] summary i {
            transform: rotate(180deg);
        }

    .bh-extra-body {
        padding: 4px 0 8px;
    }

    .bh-facts {
        margin: 0;
        font-size: .82rem;
    }

        .bh-facts > div {
            display: grid;
            grid-template-columns: 6.2rem minmax(0, 1fr);
            gap: 6px;
            margin-bottom: 4px;
        }

        .bh-facts dt {
            color: var(--bh-muted);
            font-weight: 500;
        }

        .bh-facts dd {
            margin: 0;
            overflow-wrap: anywhere;
        }

    .bh-note {
        white-space: pre-wrap;
    }

    .bh-extra-body :is(.fw-bold, .fw-semibold, strong) {
        font-weight: 550 !important;
    }

    .bh-ticket-actions {
        padding-top: 4px;
    }

        .bh-ticket-actions form {
            margin: 0;
        }

    .bh-pagination {
        justify-content: center;
        margin-top: 13px;
    }

    .df-booking-history .bh-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-height: 34px;
        padding: 4px 9px;
        border: 1px solid var(--bh-line);
        border-radius: 7px;
        color: var(--bh-ink);
        font: inherit;
        font-size: .8rem;
        font-weight: 500;
        text-decoration: none;
    }

    .df-booking-history .bh-btn-primary {
        border-color: #3b654f;
        background: #3b654f;
        color: #fff;
    }

    .df-booking-history .bh-btn-light {
        background: #fffefa;
    }

    .df-booking-history .bh-btn-detail {
        background: #f8eae7;
        color: var(--bh-wine);
    }

    .df-booking-history .bh-btn-chat {
        background: #edf3eb;
        color: var(--bh-pine);
    }

    .df-booking-history .bh-btn-cancel {
        background: #fff9f6;
        color: var(--bh-wine);
    }

    .df-booking-history .bh-btn:hover {
        filter: brightness(.96);
    }

    .df-booking-history .bh-btn[aria-current="page"] {
        border-color: #d9adae;
        background: #f5e6e3;
        color: var(--bh-wine);
    }

    .df-booking-history :focus-visible {
        outline: 2px solid var(--bh-pine);
        outline-offset: 2px;
    }

    @@media (max-width: 720px) {
        .bh-grid {
            grid-template-columns: minmax(0, 1fr);
        }

        .bh-header {
            grid-template-columns: minmax(0, 1fr) auto;
            gap: 8px;
        }

        .bh-season {
            grid-column: 2;
            grid-row: 1;
        }

        .bh-header-actions {
            grid-column: 1 / -1;
        }
    }

    @@media (max-width: 380px) {
        .bh-season-panel {
            width: 37px;
        }

        .bh-season {
            height: 43px;
        }

        .bh-ticket-top {
            grid-template-columns: 41px minmax(0, 1fr);
        }

        .bh-status {
            grid-column: 2;
            justify-self: start;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .bh-tree, .bh-lantern {
            animation: none;
        }
    }
</style>