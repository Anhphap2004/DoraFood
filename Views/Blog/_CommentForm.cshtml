@model DoraFood.Controllers.BlogController.CommentInput

<form action="@Url.Action("AddComment", "Blog")"
      method="post">

    @Html.AntiForgeryToken()

    <input asp-for="PostId" type="hidden" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3"
         role="alert"></div>

    <div class="mb-4">
        <label asp-for="Body"
               class="form-label fw-semibold">
            Bình luận của bạn
        </label>

        <textarea asp-for="Body"
                  class="form-control rounded-3"
                  rows="5"
                  maxlength="2000"
                  placeholder="Chia sẻ cảm nhận về bài viết..."
                  aria-describedby="comment-help"
                  required></textarea>

        <div id="comment-help" class="form-text">
            Tối đa 2.000 ký tự. Vui lòng sử dụng ngôn từ lịch sự.
        </div>

        <span asp-validation-for="Body"
              class="text-danger small"></span>
    </div>

    <button type="submit"
            class="btn btn-primary rounded-pill px-4 py-3">
        Gửi bình luận
        <i class="fas fa-paper-plane ms-2"
           aria-hidden="true"></i>
    </button>

</form>