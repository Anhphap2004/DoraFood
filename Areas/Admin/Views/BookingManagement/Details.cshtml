@using System
@using System.Linq
@model DoraFood.Controllers.BookingManagementController.BookingDetailsViewModel

@{
    var reservation = Model.Reservation;
    var isPending = reservation.Status == "PENDING";
    var isConfirmed = reservation.Status == "CONFIRMED";
    var isSeated = reservation.Status == "SEATED";
    var waitingForArrival = isPending || isConfirmed;
    var arrivalDeadlineUtc = reservation.StartsAtUtc.AddMinutes(30);
    var arrivalExpired = waitingForArrival && DateTime.UtcNow >= arrivalDeadlineUtc;
    var canEdit = waitingForArrival && !arrivalExpired;
    var canOpenOrder = isConfirmed || isSeated;
    var routeValues = new { id = reservation.Id };

    var statusText = reservation.Status switch
    {
        "PENDING" => "Chờ xác nhận",
        "CONFIRMED" => "Đã xác nhận",
        "SEATED" => "Khách đã vào bàn",
        "COMPLETED" => "Đã hoàn tất",
        "CANCELLED" => "Đã hủy",
        "NO_SHOW" => "Khách không đến",
        _ => reservation.Status
    };

    var statusTone = reservation.Status switch
    {
        "CONFIRMED" or "COMPLETED" => "is-positive",
        "SEATED" => "is-seated",
        "CANCELLED" or "NO_SHOW" => "is-closed",
        _ => "is-neutral"
    };

    var arrivalLocal = reservation.StartsAtUtc.AddHours(7);
    var sessionText = arrivalLocal.Hour switch
    {
        >= 10 and < 14 => "Buổi trưa · 10:00–14:00",
        >= 16 and < 22 => "Buổi tối · 16:00–22:00",
        _ => "Ngoài khung phục vụ"
    };

    var tables = reservation.Tables
        .OrderBy(table => table.Area.Name)
        .ThenBy(table => table.Code)
        .ToList();
    var capacity = tables.Sum(table => (int)table.Capacity);

    var invoiceOrders = reservation.Orders
        .Where(order => order.OrderType == "DINE_IN"
            && order.Invoice != null
            && order.Invoice.Status == "ISSUED"
            && order.Invoice.IssuedAtUtc.HasValue)
        .OrderByDescending(order => order.Invoice!.IssuedAtUtc)
        .ThenByDescending(order => order.Id)
        .ToList();

    string LocalDateTime(DateTime utc) => utc.AddHours(7).ToString("dd/MM/yyyy HH:mm");

    string ActionText(string action) => action switch
    {
        "BOOKING_TABLES_TRANSFERRED" => "Chuyển bàn đang phục vụ",
        "BOOKING_CREATED" => "Tạo yêu cầu đặt bàn",
        "BOOKING_CONFIRMED" => "Xác nhận và phân bàn",
        "BOOKING_SEATED" => "Nhận khách",
        "BOOKING_COMPLETED" => "Hoàn tất lượt đặt bàn",
        "BOOKING_CANCELLED" => "Hủy đặt bàn",
        "BOOKING_NO_SHOW" => "Đánh dấu khách không đến",
        "BOOKING_UPDATED" => "Điều chỉnh đặt bàn",
        _ => action
    };

    ViewData["Title"] = $"Chi tiết đặt bàn {reservation.Code}";
}

<style>
    .df-booking-details {
        --df-ink: #38221d;
        --df-muted: #6d5149;
        --df-wine: #783434;
        --df-peach: #eaa77c;
        --df-border: #e4cbb9;
        --df-paper: #fffaf4;
        color: var(--df-ink);
    }

        .df-booking-details .df-muted {
            color: var(--df-muted);
        }

        .df-booking-details .df-link {
            color: var(--df-wine);
        }

        .df-booking-details .df-card {
            padding: 1rem;
            border: 1px solid var(--df-border);
            border-radius: .9rem;
            background: var(--df-paper);
        }

        .df-booking-details .df-guest-card {
            border-top: 3px solid var(--df-peach);
        }

        .df-booking-details .df-surface {
            padding: .75rem;
            border-radius: .65rem;
            background: #f5ede5;
        }

        .df-booking-details .df-status {
            display: inline-block;
            padding: .3rem .7rem;
            border-radius: 999px;
            background: #f6e3d2;
            color: #784424;
            font-size: .84rem;
            font-weight: 700;
        }

            .df-booking-details .df-status.is-positive {
                background: #e8eee2;
                color: #36533a;
            }

            .df-booking-details .df-status.is-seated {
                background: #f1dfdc;
                color: #783434;
            }

            .df-booking-details .df-status.is-closed {
                background: #ede5df;
                color: #614a42;
            }

        .df-booking-details .df-primary {
            background: var(--df-wine);
            border-color: var(--df-wine);
            color: white;
        }

            .df-booking-details .df-primary:hover,
            .df-booking-details .df-outline:hover {
                background: #602727;
                border-color: #602727;
                color: white;
            }

        .df-booking-details .df-outline {
            border-color: var(--df-wine);
            color: var(--df-wine);
        }

        .df-booking-details .btn:focus-visible,
        .df-booking-details .df-link:focus-visible {
            outline: 2px solid var(--df-wine);
            outline-offset: 2px;
        }

        .df-booking-details .df-table-list {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
            gap: .55rem;
        }

        .df-booking-details .df-table-tile {
            min-width: 0;
            padding: .65rem .75rem;
            border-radius: .55rem;
            background: var(--df-wine);
            color: white;
        }

        .df-booking-details .df-break {
            overflow-wrap: anywhere;
        }

        .df-booking-details .df-note {
            white-space: pre-wrap;
        }
</style>

<section class="df-booking-details container-fluid py-4" aria-labelledby="booking-details-title">
    <header class="mb-3">
        <a href="@Url.RouteUrl("DoraFoodManageBookings", new { status = reservation.Status })"
           class="df-link small fw-semibold">
            <span aria-hidden="true">←</span> Danh sách đặt bàn
        </a>

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mt-2">
            <div>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <h1 id="booking-details-title" class="h3 fw-bold mb-0">Chi tiết đặt bàn</h1>
                    <span class="df-status @statusTone">@statusText</span>
                </div>
                <div class="small df-muted df-break mt-1">
                    Mã đặt bàn <code class="df-link">@reservation.Code</code>
                </div>
            </div>

            @if (canEdit || isSeated || canOpenOrder)
            {
                <div class="d-flex flex-wrap align-items-center gap-2">
                    @if (canEdit)
                    {
                        <a href="@Url.RouteUrl("DoraFoodEditBooking", routeValues)" class="btn df-primary">
                            Điều chỉnh đặt bàn
                        </a>
                    }

                    @if (isSeated)
                    {
                        <a href="@Url.RouteUrl("DoraFoodTransferBooking", routeValues)" class="btn df-outline">
                            Chuyển bàn
                        </a>
                    }

                    @if (canOpenOrder)
                    {
                        <form action="@Url.RouteUrl("DoraFoodOpenTableOrder", routeValues)"
                              method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn @(isSeated ? "df-primary" : "df-outline")">
                                @(isConfirmed ? "Lập / xem món đặt trước" : "Mở đơn gọi món")
                            </button>
                        </form>
                    }
                </div>
            }
        </div>
    </header>

    @if (TempData["BookingManagementSuccess"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }

    @if (TempData["BookingManagementError"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    @if (arrivalExpired)
    {
        <div class="alert alert-warning" role="status">
            Lượt đặt đã quá hạn giữ bàn.
            <a href="@Url.RouteUrl("DoraFoodManageBookingDetails", routeValues)" class="alert-link">
                Cập nhật trạng thái
            </a>
        </div>
    }

    <div class="row g-3 mb-3">
        <div class="col-lg-5">
            <section class="df-card df-guest-card h-100" aria-labelledby="booking-guest-title">
                <h2 id="booking-guest-title" class="h5 fw-bold mb-3">Thông tin khách</h2>

                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                    <div class="df-break">
                        <strong class="d-block fs-5">@reservation.GuestName</strong>
                        <a href="tel:@reservation.GuestPhone" class="df-link">@reservation.GuestPhone</a>
                    </div>
                    <span class="df-status">@reservation.PartySize khách</span>
                </div>

                <div class="df-surface mb-3">
                    <dl class="row g-2 small mb-0">
                        <div class="col-sm-6">
                            <dt class="df-muted">Giờ đến dự kiến</dt>
                            <dd class="mb-0">@LocalDateTime(reservation.StartsAtUtc)</dd>
                        </div>
                        <div class="col-sm-6">
                            <dt class="df-muted">Hạn khách đến theo giờ hẹn</dt>
                            <dd class="mb-0">@LocalDateTime(arrivalDeadlineUtc)</dd>
                        </div>
                        <div class="col-sm-6">
                            <dt class="df-muted">Buổi phục vụ</dt>
                            <dd class="mb-0">@sessionText</dd>
                        </div>
                        <div class="col-sm-6">
                            <dt class="df-muted">Ngày tạo yêu cầu</dt>
                            <dd class="mb-0">@LocalDateTime(reservation.CreatedAtUtc)</dd>
                        </div>
                    </dl>
                </div>

                <h3 class="small fw-bold df-muted mb-1">Ghi chú của khách</h3>
                <p class="df-note df-break mb-2">@(string.IsNullOrWhiteSpace(reservation.Note) ? "Không có ghi chú." : reservation.Note)</p>
                <p class="small df-muted mb-0">Thời gian theo giờ Việt Nam (UTC+7).</p>
            </section>
        </div>

        <div class="col-lg-7">
            <section class="df-card h-100" aria-labelledby="booking-tables-title">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                    <h2 id="booking-tables-title" class="h5 fw-bold mb-0">Bàn đã phân</h2>
                    <span class="df-status">@tables.Count bàn · @capacity chỗ</span>
                </div>

                @if (tables.Count == 0)
                {
                    <p class="df-muted mb-0">Chưa có bàn được phân.</p>
                }
                else
                {
                    <ul class="df-table-list list-unstyled mb-0">
                        @foreach (var table in tables)
                        {
                            <li class="df-table-tile df-break">
                                <strong class="d-block">@table.Code</strong>
                                <span class="small">@table.Area.Name · @table.Capacity chỗ</span>
                            </li>
                        }
                    </ul>
                }

                @if (waitingForArrival && !arrivalExpired)
                {
                    <p class="small df-muted mt-3 mb-0">
                        Hệ thống tự hủy sau hạn giữ bàn nếu khách chưa vào bàn.
                        Xác nhận đặt bàn không kéo dài thời gian chờ.
                    </p>
                }
                else if (isSeated)
                {
                    <p class="small df-muted mt-3 mb-0">
                        Bàn đang phục vụ khách và được giữ đến khi hoàn tất lượt phục vụ.
                    </p>
                }
            </section>
        </div>
    </div>

    @if (invoiceOrders.Count > 0)
    {
        <section class="df-card mb-3" aria-labelledby="booking-invoices-title">
            <h2 id="booking-invoices-title" class="h5 fw-bold mb-3">Hóa đơn đã xuất</h2>
            <ul class="list-unstyled d-grid gap-2 mb-0">
                @foreach (var order in invoiceOrders)
                {
                    var invoice = order.Invoice!;

                    <li class="df-surface d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div class="df-break">
                            <strong class="d-block">@invoice.Number</strong>
                            <span class="small df-muted">Xuất lúc @LocalDateTime(invoice.IssuedAtUtc!.Value)</span>
                        </div>
                        <a href="@Url.RouteUrl("DoraFoodTableInvoice", new { orderId = order.Id })"
                           class="btn btn-sm df-outline">Xem và in hóa đơn</a>
                    </li>
                }
            </ul>
        </section>
    }

    <section class="df-card mb-3" aria-labelledby="booking-history-title">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
            <h2 id="booking-history-title" class="h5 fw-bold mb-0">Lịch sử thao tác</h2>
            <span class="small df-muted">@Model.History.Count hoạt động</span>
        </div>

        @if (Model.History.Count == 0)
        {
            <p class="df-muted mb-0">Chưa có hoạt động.</p>
        }
        else
        {
            <ol class="list-unstyled d-grid gap-2 mb-0">
                @foreach (var log in Model.History)
                {
                    var actor = log.Actor?.UserName
                        ?? (log.ActorId.HasValue ? "Không có thông tin tài khoản" : "Hệ thống");

                    <li class="df-surface df-break">
                        <strong>@ActionText(log.Action)</strong>
                        <div class="small df-muted">
                            @log.CreatedAtUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm:ss") · @actor
                        </div>
                        @if (!string.IsNullOrWhiteSpace(log.Summary))
                        {
                            <p class="df-note mb-0 mt-1">@log.Summary</p>
                        }
                    </li>
                }
            </ol>
        }
    </section>

    @if (waitingForArrival)
    {
        <section class="df-card" aria-labelledby="booking-cancel-title">
            <h2 id="booking-cancel-title" class="h5 fw-bold mb-3">Hủy đặt bàn</h2>
            <form action="@Url.RouteUrl("DoraFoodManageCancelBooking", routeValues)"
                  method="post"
                  onsubmit="return confirm('Anh chắc chắn muốn hủy yêu cầu đặt bàn này?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Version" value="@Convert.ToBase64String(reservation.Version)" />
                <label for="cancelReason" class="form-label fw-semibold">Lý do hủy</label>
                <textarea id="cancelReason" name="Reason" class="form-control"
                          rows="3" maxlength="300" required aria-describedby="cancelReasonHelp"></textarea>
                <p id="cancelReasonHelp" class="small df-muted mt-1 mb-3">
                    Tối đa 300 ký tự. Lý do được lưu trong lịch sử thao tác.
                </p>
                <button type="submit" class="btn btn-outline-danger">Hủy đặt bàn</button>
            </form>
        </section>
    }
</section>
