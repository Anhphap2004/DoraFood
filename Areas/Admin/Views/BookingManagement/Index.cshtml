@using System
@using System.Globalization
@using System.Linq
@model DoraFood.Controllers.BookingManagementController.BookingManagementViewModel

@{
    ViewData["Title"] = "Quản lý đặt bàn";

    var managementUrl = Url.RouteUrl("DoraFoodManageBookings");

    var today = DateTime.UtcNow.AddHours(7).Date;
    var serviceDate = Model.ServiceDate?.Date ?? today;
    string DateValue(DateTime date) => date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var serviceDateValue = DateValue(serviceDate);

    string? DayUrl(DateTime date, string status) => Url.RouteUrl(
        "DoraFoodManageBookings", new
        {
            serviceDate = DateValue(date), status, keyword = Model.Keyword, areaId = Model.AreaId
        });

    string? PageUrl(int pageNumber) => Url.RouteUrl(
        "DoraFoodManageBookings",
        new
        {
            status = Model.Status,
            keyword = Model.Keyword,
            serviceDate = serviceDateValue,
            areaId = Model.AreaId,
            page = pageNumber
        });

    var filters = new[]
    {
        new { Code = "ALL", Label = "Tất cả trạng thái" },
        new { Code = "PENDING", Label = "Chờ xác nhận" },
        new { Code = "CONFIRMED", Label = "Đã xác nhận" },
        new { Code = "SEATED", Label = "Đã nhận bàn" },
        new { Code = "COMPLETED", Label = "Đã hoàn thành" },
        new { Code = "CANCELLED", Label = "Đã hủy" },
        new { Code = "NO_SHOW", Label = "Không đến" }
    };
}

@functions {
    private (string Label, string CssClass) StatusDisplay(string status)
    {
        return status switch
        {
            "PENDING" => ("Chờ xác nhận", "is-pending"),
            "CONFIRMED" => ("Đã xác nhận", "is-confirmed"),
            "SEATED" => ("Đã nhận bàn", "is-seated"),
            "COMPLETED" => ("Đã hoàn thành", "is-completed"),
            "CANCELLED" => ("Đã hủy", "is-muted"),
            "NO_SHOW" => ("Không đến", "is-noshow"),
            _ => ("Chưa xác định", "is-muted")
        };
    }
}

@section Styles {
    <link rel="stylesheet" href="~/admin/css/dorafood-reservation-days.css" asp-append-version="true" />
}

<div class="df-reservation-days">
    <header class="df-reservation-heading">
        <h1>Quản lý đặt bàn</h1>
        <span class="df-reservation-count">@Model.TotalItems yêu cầu</span>
    </header>
    <section class="df-reservation-date" aria-labelledby="df-reservation-date-heading">
        <div>
            <h2 id="df-reservation-date-heading">Lịch đặt bàn</h2>
            <p>@serviceDate.ToString("dddd, dd/MM/yyyy", CultureInfo.GetCultureInfo("vi-VN"))</p>
            <nav class="df-reservation-date__links" aria-label="Chuyển ngày phục vụ">
                @if (serviceDate > DateTime.MinValue.Date.AddDays(1))
                {
                    <a class="btn btn-outline-secondary btn-sm"
                       href="@DayUrl(serviceDate.AddDays(-1), "ALL")">← Ngày trước</a>
                }
                <a class="btn btn-outline-secondary btn-sm"
                   href="@DayUrl(today, "ALL")" aria-current="@(serviceDate == today ? "date" : null)">Hôm nay</a>
                @if (serviceDate < DateTime.MaxValue.Date.AddDays(-1))
                {
                    <a class="btn btn-outline-secondary btn-sm"
                       href="@DayUrl(serviceDate.AddDays(1), "ALL")">Ngày sau →</a>
                }
            </nav>
        </div>

        <form action="@managementUrl" method="get" class="df-reservation-date__form">
            <label for="booking-date" class="form-label">Ngày phục vụ</label>
            <div class="input-group">
                <input id="booking-date" name="serviceDate" type="date"
                       class="form-control" value="@serviceDateValue" required />
                <button type="submit" class="btn btn-primary">Xem lịch</button>
            </div>
            <input type="hidden" name="status" value="ALL" />
            <input type="hidden" name="keyword" value="@Model.Keyword" />
            <input type="hidden" name="areaId" value="@Model.AreaId" />
        </form>
    </section>

    <nav class="df-reservation-statuses" aria-label="Lọc trạng thái đặt bàn">
        @foreach (var filter in filters)
        {
            var current = Model.Status == filter.Code;
            <a class="btn btn-sm @(current ? "btn-primary" : "btn-outline-secondary")"
               href="@DayUrl(serviceDate, filter.Code)"
               aria-current="@(current ? "true" : null)">@filter.Label</a>
        }
    </nav>

        @if (TempData["BookingManagementSuccess"] is string successMessage)
        {
            <div class="alert alert-success" role="status">
                @successMessage
            </div>
        }

        @if (TempData["BookingManagementError"] is string errorMessage)
        {
            <div class="alert alert-danger" role="alert">
                @errorMessage
            </div>
        }

        <!-- Tìm kiếm và lọc -->
        <div class="df-reservation-filter">

            <form action="@managementUrl"
                  method="get"
                  class="df-reservation-filter__fields">

                <div class="df-reservation-filter__keyword">
                    <label for="booking-keyword" class="form-label fw-semibold">
                        Tìm kiếm
                    </label>
                    <input id="booking-keyword"
                           name="keyword"
                           type="search"
                           class="form-control rounded-3"
                           maxlength="150"
                           value="@Model.Keyword"
                           placeholder="Tên khách, số điện thoại hoặc mã đặt bàn" />
                </div>

                <input type="hidden" name="serviceDate" value="@serviceDateValue" />
                <input type="hidden" name="status" value="@Model.Status" />

                <div class="df-reservation-filter__area">
                    <label for="booking-area" class="form-label fw-semibold">
                        Khu vực
                    </label>
                    <select id="booking-area" name="areaId"
                            class="form-select rounded-3">
                        <option value="" selected="@(!Model.AreaId.HasValue)">
                            Tất cả khu vực
                        </option>
                        @foreach (var area in Model.Areas)
                        {
                            <option value="@area.Id"
                                    selected="@(Model.AreaId == area.Id)">
                                @area.Name@(area.IsActive ? "" : " (Ngừng hoạt động)")
                            </option>
                        }
                    </select>
                </div>

                <div class="df-reservation-filter__actions">
                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit"
                                class="btn btn-primary rounded-pill px-4">
                            <i class="fas fa-filter me-2" aria-hidden="true"></i>
                            Lọc
                        </button>
                        <a href="@Url.RouteUrl("DoraFoodManageBookings", new { status = "ALL", serviceDate = serviceDateValue })"
                           class="btn btn-outline-secondary rounded-pill px-4">
                            Xóa lọc
                        </a>
                    </div>
                </div>

            </form>
        </div>

        <h2 class="df-reservation-list-title">Danh sách ngày @serviceDate.ToString("dd/MM/yyyy")</h2>
        @if (Model.Reservations.Count == 0)
        {
            <div class="df-reservation-empty">
                <h3>Không có lượt đặt phù hợp</h3>
                <p>Thử đổi bộ lọc hoặc từ khóa tìm kiếm.</p>
            </div>
        }
        else
        {
            <div class="df-reservation-results">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">

                        <caption class="visually-hidden">
                            Danh sách yêu cầu đặt bàn theo các điều kiện tìm kiếm và lọc đã chọn.
                        </caption>

                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="p-3">Mã yêu cầu</th>
                                <th scope="col" class="p-3">Khách hàng</th>
                                <th scope="col" class="p-3">Thời gian</th>
                                <th scope="col" class="p-3">Số khách</th>
                                <th scope="col" class="p-3">Bàn được gán</th>
                                <th scope="col" class="p-3">Trạng thái</th>
                                <th scope="col" class="p-3">Thao tác</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var reservation in Model.Reservations)
                            {
                                var badge = StatusDisplay(reservation.Status);
                                var hasPreorder = reservation.Status == "CONFIRMED"
                                    && reservation.Orders.Any(order => order.OrderType == "DINE_IN"
                                        && (order.Status == "OPEN" || order.Status == "IN_PROGRESS")
                                        && order.Invoice == null && order.ClosedAtUtc == null
                                        && order.OrderItems.Any(line => line.Status != "CANCELLED"));

                                <tr>

                                    <td class="p-3">
                                        <div class="fw-semibold text-break"
                                             style="min-width: 150px; max-width: 220px;">
                                            @reservation.Code
                                        </div>

                                        <div class="text-muted small mt-2">
                                            Gửi:
                                            @reservation.CreatedAtUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                    </td>

                                    <td class="p-3">
                                        <div class="fw-semibold">
                                            @reservation.GuestName
                                        </div>

                                        <div class="text-muted small mt-1">
                                            @reservation.GuestPhone
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(reservation.Note))
                                        {
                                            <div class="small mt-2"
                                                 style="min-width: 160px; max-width: 250px; white-space: pre-wrap; overflow-wrap: anywhere;">
                                                Ghi chú: @reservation.Note
                                            </div>
                                        }
                                    </td>

                                    <td class="p-3">
                                        <div class="small text-nowrap">
                                            <span class="text-muted">Đến:</span>
                                            @reservation.StartsAtUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm")
                                        </div>

                                        <div class="small text-nowrap mt-2">
                                            <span class="text-muted">Hạn khách đến:</span>
                                            @reservation.StartsAtUtc.AddMinutes(30).AddHours(7).ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                        @if (reservation.Status == "SEATED")
                                        {
                                            <div class="small text-muted mt-2">
                                                Đang dùng bữa · Giữ bàn đến khi hoàn tất
                                            </div>
                                        }
                                    </td>

                                    <td class="p-3 text-center">
                                        <span class="fw-semibold">
                                            @reservation.PartySize
                                        </span>
                                    </td>

                                    <td class="p-3">
                                        @if (reservation.Tables.Count == 0)
                                        {
                                            <span class="text-muted small">
                                                Chưa phân bàn
                                            </span>
                                        }
                                        else
                                        {
                                            <div class="d-flex flex-column gap-2">
                                                @foreach (var table in reservation.Tables
                                                    .OrderBy(t => t.Area.Name)
                                                    .ThenBy(t => t.Code))
                                                {
                                                    <span class="badge bg-light text-dark border">
                                                        @table.Area.Name · @table.Code
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </td>

                                    <td class="p-3">
                                        <span class="df-reservation-badge @badge.CssClass">
                                            @badge.Label
                                        </span>
                                        @if (hasPreorder)
                                        {
                                            <span class="df-reservation-badge is-pending">Đã đặt món</span>
                                        }
                                    </td>
                                    <td class="p-3">
                                        <a href="@Url.RouteUrl(
                                           "DoraFoodManageBookingDetails",
                                           new { id = reservation.Id })"
                                           class="btn btn-outline-secondary rounded-pill
                                            text-nowrap px-3 py-2 me-2 mb-2">
                                            Chi tiết
                                        </a>
                                        @if (reservation.Status == "PENDING"
                                            && reservation.StartsAtUtc > DateTime.UtcNow.AddMinutes(-30))
                                        {
                                            <a href="@Url.RouteUrl(
                                                         "DoraFoodConfirmBooking",
                                                         new { id = reservation.Id })"
                                               class="btn btn-outline-primary rounded-pill text-nowrap px-3 py-2">
                                                Chọn bàn
                                            </a>
                                        }
                                        else if (reservation.Status == "CONFIRMED" && !hasPreorder
                                            && reservation.StartsAtUtc > DateTime.UtcNow.AddMinutes(-30))
                                        {
                                            <form action="@Url.RouteUrl(
                                                              "DoraFoodSeatBooking",
                                                              new { id = reservation.Id })"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Xác nhận khách đã đến và vào các bàn đã phân?');">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="version"
                                                       value="@Convert.ToBase64String(reservation.Version)" />

                                                <button type="submit"
                                                        class="btn btn-success rounded-pill text-nowrap px-3 py-2">
                                                    Nhận khách
                                                </button>
                                            </form>
                                        }
                                        else if (reservation.Status == "SEATED")
                                        {
                                            <form action="@Url.RouteUrl(
                                                              "DoraFoodCompleteBooking",
                                                              new { id = reservation.Id })"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Xác nhận khách đã rời bàn và hoàn tất lượt đặt bàn này?');">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="version"
                                                       value="@Convert.ToBase64String(reservation.Version)" />

                                                <button type="submit"
                                                        class="btn btn-primary rounded-pill text-nowrap px-3 py-2">
                                                    Hoàn tất
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            </div>
        }

        <!-- Phân trang -->
        @if (Model.TotalPages > 1)
        {
            var startPage = Math.Max(1, Model.CurrentPage - 2);
            var endPage = Math.Min(
                Model.TotalPages,
                Model.CurrentPage + 2);

            <nav class="mt-4" aria-label="Phân trang quản lý đặt bàn">
                <ul class="pagination justify-content-center flex-wrap">

                    @if (Model.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               href="@PageUrl(Model.CurrentPage - 1)">
                                Trước
                            </a>
                        </li>
                    }

                    @for (var number = startPage;
                          number <= endPage;
                          number++)
                    {
                        var isCurrent =
                            number == Model.CurrentPage;

                        <li class="page-item @(isCurrent ? "active" : "")">
                            <a class="page-link"
                               href="@PageUrl(number)"
                               aria-current="@(isCurrent ? "page" : null)"
                               aria-label="Trang @number">
                                @number
                            </a>
                        </li>
                    }

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               href="@PageUrl(Model.CurrentPage + 1)">
                                Sau
                            </a>
                        </li>
                    }

                </ul>
            </nav>
        }

</div>
