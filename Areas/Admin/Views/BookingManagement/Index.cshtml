@using System
@using System.Globalization
@using System.Linq
@model DoraFood.Controllers.BookingManagementController.BookingManagementViewModel

@{
    ViewData["Title"] = "Quản lý đặt bàn";

    var managementUrl = Url.RouteUrl("DoraFoodManageBookings");
    var dateValue = Model.ServiceDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var arrivalCutoffUtc = DateTime.UtcNow.AddMinutes(-30);
    var hasFilters = Model.Status != "ALL"
        || !string.IsNullOrWhiteSpace(Model.Keyword)
        || Model.ServiceDate.HasValue
        || Model.AreaId.HasValue;

    var statuses = new[]
    {
        (Code: "ALL", Label: "Tất cả trạng thái"),
        (Code: "PENDING", Label: "Chờ xác nhận"),
        (Code: "CONFIRMED", Label: "Đã xác nhận"),
        (Code: "SEATED", Label: "Đã nhận bàn"),
        (Code: "COMPLETED", Label: "Đã hoàn thành"),
        (Code: "CANCELLED", Label: "Đã hủy"),
        (Code: "NO_SHOW", Label: "Không đến")
    };

    (string Label, string Tone) BadgeFor(string status) => status switch
    {
        "PENDING" => ("Chờ xác nhận", "is-pending"),
        "CONFIRMED" => ("Đã xác nhận", "is-confirmed"),
        "SEATED" => ("Đã nhận bàn", "is-seated"),
        "COMPLETED" => ("Đã hoàn thành", "is-confirmed"),
        "CANCELLED" => ("Đã hủy", "is-closed"),
        "NO_SHOW" => ("Không đến", "is-closed"),
        _ => ("Chưa xác định", "is-closed")
    };

    string? PageUrl(int page) => Url.RouteUrl("DoraFoodManageBookings", new
    {
        status = Model.Status,
        keyword = Model.Keyword,
        serviceDate = dateValue,
        areaId = Model.AreaId,
        page
    });
}

<style>
    .df-booking-index {
        --df-wine: #783434;
        --df-ink: #38221d;
        --df-muted: #6d5149;
        --df-line: #e4cbb9;
        --df-paper: #fffaf4;
        --df-peach: #fae9dc;
        max-width: 84rem;
        margin-inline: auto;
        color: var(--df-ink);
    }

        .df-booking-index .df-muted {
            color: var(--df-muted);
        }

        .df-booking-index .df-panel {
            border: 1px solid var(--df-line);
            border-radius: .85rem;
            background: var(--df-paper);
        }

        .df-booking-index .df-filter {
            display: flex;
            flex-wrap: wrap;
            align-items: end;
            gap: .65rem;
            padding: .8rem 1rem;
        }

            .df-booking-index .df-filter > div {
                flex: 1 1 9rem;
                min-width: 0;
            }

            .df-booking-index .df-filter > .df-search {
                flex: 2 1 17rem;
            }

            .df-booking-index .df-filter > .df-filter-actions {
                flex: 0 1 auto;
            }

        .df-booking-index .form-label {
            margin-bottom: .25rem;
            color: var(--df-muted);
            font-size: .8rem;
            font-weight: 600;
        }

        .df-booking-index .form-control,
        .df-booking-index .form-select {
            border-color: var(--df-line);
        }

            .df-booking-index .form-control:focus,
            .df-booking-index .form-select:focus {
                border-color: var(--df-wine);
                box-shadow: 0 0 0 .16rem #78343430;
            }

        .df-booking-index .df-primary {
            background: var(--df-wine);
            border-color: var(--df-wine);
            color: white;
        }

            .df-booking-index .df-primary:hover {
                background: #602727;
                border-color: #602727;
                color: white;
            }

        .df-booking-index .df-link {
            color: var(--df-wine);
        }

            .df-booking-index .df-link:hover {
                color: #602727;
            }

        .df-booking-index .df-badge {
            display: inline-block;
            padding: .22rem .55rem;
            border-radius: 999px;
            font-size: .8rem;
            font-weight: 700;
            white-space: nowrap;
        }

        .df-booking-index .is-pending {
            background: #f7e4c9;
            color: #6c431e;
        }

        .df-booking-index .is-confirmed {
            background: #e7eee1;
            color: #355138;
        }

        .df-booking-index .is-seated {
            background: #f4dfdb;
            color: var(--df-wine);
        }

        .df-booking-index .is-closed {
            background: #eee5de;
            color: #604b42;
        }

        .df-booking-index .df-count {
            background: var(--df-peach);
            color: var(--df-wine);
        }

        .df-booking-index .df-bookings {
            --bs-table-bg: var(--df-paper);
            --bs-table-color: var(--df-ink);
            --bs-table-border-color: #eddcd0;
        }

            .df-booking-index .df-bookings th,
            .df-booking-index .df-bookings td {
                padding: .58rem .9rem;
            }

            .df-booking-index .df-bookings thead th {
                background: var(--df-peach);
                color: #573226;
                font-size: .8rem;
                white-space: nowrap;
            }

            .df-booking-index .df-bookings tbody tr:last-child > * {
                border-bottom: 0;
            }

        .df-booking-index .df-guest-name {
            overflow-wrap: anywhere;
        }

        .df-booking-index .df-actions {
            display: flex;
            justify-content: flex-end;
            flex-wrap: wrap;
            gap: .2rem .4rem;
        }

            .df-booking-index .df-actions .btn {
                white-space: nowrap;
            }

        .df-booking-index .page-link {
            color: var(--df-wine);
        }

        .df-booking-index .active .page-link {
            background: var(--df-wine);
            border-color: var(--df-wine);
            color: white;
        }

    @@media (max-width: 767.98px) {
        .df-booking-index .df-bookings tbody,
        .df-booking-index .df-bookings td {
            display: block;
        }

        .df-booking-index .df-bookings {
            display: block;
        }

            .df-booking-index .df-bookings thead {
                position: absolute;
                width: 1px;
                height: 1px;
                overflow: hidden;
                clip-path: inset(50%);
            }

            .df-booking-index .df-bookings tr {
                display: grid;
                grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
                gap: .5rem;
                padding: .75rem;
                border-bottom: 1px solid #eddcd0;
            }

            .df-booking-index .df-bookings tbody tr:last-child {
                border: 0;
            }

            .df-booking-index .df-bookings td {
                padding: 0;
                border: 0;
            }

                .df-booking-index .df-bookings td:last-child {
                    align-self: end;
                    grid-column: 1 / -1;
                }

        .df-booking-index .df-actions {
            justify-content: flex-start;
        }
    }
</style>

<div class="container-fluid df-booking-index py-3 py-lg-4">
    <header class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h1 class="h3 fw-bold mb-0">Quản lý đặt bàn</h1>
        <span class="df-badge df-count">@Model.TotalItems yêu cầu</span>
    </header>

    @if (TempData["BookingManagementSuccess"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }

    @if (TempData["BookingManagementError"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <form action="@managementUrl" method="get" class="df-panel df-filter mb-3"
          aria-label="Bộ lọc đặt bàn">
        <div class="df-search">
            <label for="booking-keyword" class="form-label">Tìm kiếm</label>
            <input id="booking-keyword" name="keyword" type="search" maxlength="150"
                   class="form-control form-control-sm" value="@Model.Keyword"
                   placeholder="Tên khách, số điện thoại hoặc mã đặt bàn" />
        </div>

        <div>
            <label for="booking-status" class="form-label">Trạng thái</label>
            <select id="booking-status" name="status" class="form-select form-select-sm">
                @foreach (var status in statuses)
                {
                    <option value="@status.Code" selected="@(Model.Status == status.Code)">@status.Label</option>
                }
            </select>
        </div>

        <div>
            <label for="booking-date" class="form-label">Ngày phục vụ</label>
            <input id="booking-date" name="serviceDate" type="date" class="form-control form-control-sm"
                   value="@dateValue" />
        </div>

        <div>
            <label for="booking-area" class="form-label">Khu vực</label>
            <select id="booking-area" name="areaId" class="form-select form-select-sm">
                <option value="">Tất cả khu vực</option>
                @foreach (var area in Model.Areas)
                {
                    <option value="@area.Id" selected="@(Model.AreaId == area.Id)">
                        @area.Name@(area.IsActive ? "" : " (Ngừng hoạt động)")
                    </option>
                }
            </select>
        </div>

        <div class="df-filter-actions d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-sm df-primary px-3">Lọc</button>
            @if (hasFilters)
            {
                <a href="@Url.RouteUrl("DoraFoodManageBookings", new { status = "ALL" })"
                   class="btn btn-sm btn-outline-secondary">Xóa lọc</a>
            }
        </div>
    </form>

    @if (Model.Reservations.Count == 0)
    {
        <div class="df-panel p-4 text-center" role="status">
            <h2 class="h6 fw-bold mb-1">Không có lượt đặt phù hợp</h2>
            <p class="small df-muted mb-0">Thử đổi bộ lọc hoặc từ khóa tìm kiếm.</p>
        </div>
    }
    else
    {
        <div class="df-panel overflow-hidden">
            <div class="table-responsive">
                <table class="table df-bookings align-middle mb-0" role="table"
                       aria-label="Danh sách yêu cầu đặt bàn">
                    <thead role="rowgroup">
                        <tr role="row">
                            <th scope="col" role="columnheader">Khách đặt</th>
                            <th scope="col" role="columnheader">Giờ đến (VN)</th>
                            <th scope="col" role="columnheader">Bàn</th>
                            <th scope="col" role="columnheader">Trạng thái</th>
                            <th scope="col" role="columnheader" class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody role="rowgroup">
                        @foreach (var reservation in Model.Reservations)
                        {
                            var badge = BadgeFor(reservation.Status);
                            var arrival = reservation.StartsAtUtc.AddHours(7);
                            var inTime = reservation.StartsAtUtc > arrivalCutoffUtc;
                            var routeValues = new { id = reservation.Id };
                            var detailsUrl = Url.RouteUrl("DoraFoodManageBookingDetails", routeValues);
                            var tables = reservation.Tables.OrderBy(t => t.Area.Name).ThenBy(t => t.Code);

                            <tr role="row">
                                <td role="cell">
                                    <strong class="d-block df-guest-name">@reservation.GuestName</strong>
                                    <span class="small df-muted">@reservation.GuestPhone · @reservation.PartySize khách</span>
                                </td>
                                <td role="cell">
                                    <span class="fw-semibold text-nowrap">@arrival.ToString("HH:mm")</span>
                                    <span class="small df-muted d-block text-nowrap">@arrival.ToString("dd/MM/yyyy")</span>
                                </td>
                                <td role="cell">
                                    @if (reservation.Tables.Count == 0)
                                    {
                                        <span class="small df-muted">Chưa phân bàn</span>
                                    }
                                    else
                                    {
                                        <span class="small text-break">@string.Join(", ", tables.Select(t => t.Code))</span>
                                    }
                                </td>
                                <td role="cell">
                                    <span class="df-badge @badge.Tone">@badge.Label</span>
                                </td>
                                <td role="cell">
                                    <div class="df-actions">
                                        <a href="@detailsUrl" class="btn btn-sm df-link"
                                           aria-label="Chi tiết lượt đặt của @reservation.GuestName">Chi tiết</a>

                                        @if (reservation.Status == "PENDING" && inTime)
                                        {
                                            <a href="@Url.RouteUrl("DoraFoodConfirmBooking", routeValues)"
                                               class="btn btn-sm df-primary">Chọn bàn</a>
                                        }
                                        else if (reservation.Status == "CONFIRMED" && inTime)
                                        {
                                            <form action="@Url.RouteUrl("DoraFoodSeatBooking", routeValues)"
                                                  method="post" class="m-0"
                                                  onsubmit="return confirm('Xác nhận khách đã đến và vào các bàn đã phân?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="version"
                                                       value="@Convert.ToBase64String(reservation.Version)" />
                                                <button type="submit" class="btn btn-sm df-primary">Nhận khách</button>
                                            </form>
                                        }
                                        else if (reservation.Status == "SEATED")
                                        {
                                            <form action="@Url.RouteUrl("DoraFoodCompleteBooking", routeValues)"
                                                  method="post" class="m-0"
                                                  onsubmit="return confirm('Xác nhận khách đã rời bàn và hoàn tất lượt đặt bàn này?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="version"
                                                       value="@Convert.ToBase64String(reservation.Version)" />
                                                <button type="submit" class="btn btn-sm df-primary">Hoàn tất</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (Model.TotalPages > 1)
    {
        var firstPage = Math.Max(1, Model.CurrentPage - 2);
        var lastPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

        <nav class="mt-3" aria-label="Phân trang đặt bàn">
            <ul class="pagination pagination-sm justify-content-end flex-wrap mb-0">
                @if (Model.CurrentPage > 1)
                {
                    <li class="page-item"><a class="page-link" href="@PageUrl(Model.CurrentPage - 1)">Trước</a></li>
                }
                @for (var pageNumber = firstPage; pageNumber <= lastPage; pageNumber++)
                {
                    var current = pageNumber == Model.CurrentPage;
                    <li class="page-item @(current ? "active" : "")">
                        <a class="page-link" href="@PageUrl(pageNumber)" aria-label="Trang @pageNumber"
                           aria-current="@(current ? "page" : null)">@pageNumber</a>
                    </li>
                }
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li class="page-item"><a class="page-link" href="@PageUrl(Model.CurrentPage + 1)">Sau</a></li>
                }
            </ul>
        </nav>
    }
</div>
