@using System.Linq
@model DoraFood.Areas.Admin.ViewModels.TransferBookingViewModel

@{
    ViewData["Title"] = "Chuyển bàn";
    var reservation = Model.Reservation;
    var currentCapacity = Model.CurrentTables.Sum(table => (int)table.Capacity);
    var routeValues = new { id = Model.Id };
    var backUrl = Url.RouteUrl("DoraFoodManageBookingDetails", routeValues);
    var transferUrl = Url.RouteUrl("DoraFoodTransferBooking", routeValues);
}

<style>
    .df-transfer {
        --df-wine: #783434;
        --df-peach: #eaa77c;
        --df-ink: #38221d;
        --df-muted: #6d5149;
        --df-border: #e4cbb9;
        --df-paper: #fffaf4;
        max-width: 76rem;
        margin-inline: auto;
        color: var(--df-ink);
    }

        .df-transfer .df-muted {
            color: var(--df-muted);
        }

        .df-transfer .df-link {
            color: var(--df-wine);
        }

        .df-transfer .df-break {
            overflow-wrap: anywhere;
        }

        .df-transfer .df-layout {
            display: flex;
            flex-wrap: wrap;
            align-items: flex-start;
            gap: 1rem;
        }

        .df-transfer .df-context {
            flex: 1 1 14rem;
            min-width: 0;
        }

        .df-transfer .df-target {
            flex: 4 1 32rem;
            min-width: 0;
        }

        .df-transfer .df-card {
            padding: 1rem;
            border: 1px solid var(--df-border);
            border-radius: .9rem;
            background: var(--df-paper);
        }

        .df-transfer .df-guest {
            border-top: 3px solid var(--df-peach);
        }

        .df-transfer .df-status,
        .df-transfer .df-party {
            display: inline-block;
            padding: .25rem .65rem;
            border-radius: 999px;
            background: #f4e2d4;
            color: #734224;
            font-size: .8rem;
            font-weight: 700;
        }

        .df-transfer .df-area {
            min-width: 0;
            margin: .75rem 0 0;
            padding: .45rem .6rem .6rem;
            border: 1px solid #efc8ac;
            border-radius: .65rem;
            background: #fae9dc;
        }

            .df-transfer .df-area legend {
                float: none;
                width: auto;
                margin: 0;
                padding: 0 .35rem;
                border-radius: .25rem;
                background: #fae9dc;
                color: #734224;
                font-size: .84rem;
                font-weight: 700;
            }

        .df-transfer .df-table-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(min(100%, max(7.65rem, calc((100% - 1.35rem) / 4))), 1fr));
            gap: .45rem;
        }

        .df-transfer .df-table {
            display: flex;
            align-items: flex-start;
            gap: .45rem;
            min-width: 0;
            padding: .45rem .5rem;
            border: 1px solid var(--df-border);
            border-radius: .5rem;
            background: var(--df-paper);
            color: var(--df-wine);
            font-size: .9rem;
            line-height: 1.35;
            overflow-wrap: anywhere;
            cursor: pointer;
        }

            .df-transfer .df-table input {
                flex: 0 0 auto;
                margin-top: .15rem;
                accent-color: var(--df-wine);
            }

            .df-transfer .df-table:has(input:enabled):hover {
                border-color: var(--df-wine);
            }

            .df-transfer .df-table:has(input:checked) {
                border-color: #97612d;
                background: #f7dfbd;
                box-shadow: inset 0 0 0 1px #97612d;
            }

            .df-transfer .df-table:has(input:disabled) {
                background: #efe7e0;
                color: var(--df-muted);
                cursor: not-allowed;
            }

            .df-transfer .df-table:focus-within,
            .df-transfer .df-submit:focus-visible {
                outline: 2px solid var(--df-ink);
                outline-offset: 3px;
            }

        .df-transfer .df-table-note {
            display: block;
            margin-top: .15rem;
            font-size: .76rem;
            color: var(--df-muted);
        }

        .df-transfer .df-table-meta {
            display: flex;
            flex-wrap: wrap;
            align-items: baseline;
            column-gap: .35rem;
        }

        .df-transfer .df-current-heading {
            border-top: 1px solid var(--df-border);
            margin-top: .75rem;
            padding-top: .75rem;
        }

        .df-transfer .df-selection {
            padding: .8rem;
            border-radius: .65rem;
            background: #f5ede5;
        }

        .df-transfer .df-submit {
            background: var(--df-wine);
            border-color: var(--df-wine);
            color: white;
        }

            .df-transfer .df-submit:hover {
                background: #602727;
                color: white;
            }

            .df-transfer .df-submit:disabled {
                background: #e9d9cf;
                border-color: #e9d9cf;
                color: #654b41;
                opacity: 1;
            }
</style>

<div class="container-fluid df-transfer py-3">
    <header class="mb-3">
        <a href="@backUrl" class="df-link small fw-semibold">
            <span aria-hidden="true">←</span> Chi tiết đặt bàn
        </a>
        <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
            <h1 class="h3 fw-bold mb-0">Chuyển hoặc gộp bàn</h1>
            <span class="df-status">Khách đang dùng bữa</span>
        </div>
    </header>

    @if (TempData["BookingManagementError"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <form id="transfer-booking-form" action="@transferUrl" method="post"
          data-party-size="@reservation.PartySize">
        @Html.AntiForgeryToken()
        <input asp-for="Version" type="hidden" />
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>

        <div class="df-layout">
            <div class="df-context">
                <section class="df-card df-guest" aria-labelledby="transfer-guest-title">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                        <div class="df-break">
                            <h2 id="transfer-guest-title" class="small df-muted mb-1">Khách đặt</h2>
                            <strong class="d-block fs-5">@reservation.GuestName</strong>
                            <a href="tel:@reservation.GuestPhone" class="df-link">@reservation.GuestPhone</a>
                        </div>
                        <span class="df-party">@reservation.PartySize khách</span>
                    </div>
                    <dl class="small df-break mb-0 mt-3">
                        <dt class="df-muted">Mã đặt bàn</dt>
                        <dd class="mb-2"><code class="df-link">@reservation.Code</code></dd>
                        <dt class="df-muted">Đơn gọi món</dt>
                        <dd class="mb-0">@(Model.ActiveOrderCode ?? "Chưa mở đơn")</dd>
                    </dl>

                    <div class="df-current-heading d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                        <h3 class="h6 fw-bold mb-0">Bàn hiện tại</h3>
                        <span class="small df-muted">@currentCapacity chỗ</span>
                    </div>

                    @if (Model.CurrentTables.Count == 0)
                    {
                        <p class="small text-danger mb-0">Lượt khách chưa có thông tin bàn.</p>
                    }
                    else
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var table in Model.CurrentTables)
                            {
                                <li class="d-flex flex-wrap justify-content-between gap-2 border-top py-2"
                                    data-current-table data-id="@table.Id" data-code="@table.Code">
                                    <span class="df-break">
                                        <strong>@table.Code</strong>
                                        <small class="d-block df-muted">@table.AreaName</small>
                                    </span>
                                    <span class="small text-nowrap">@table.Capacity chỗ</span>
                                </li>
                            }
                        </ul>
                    }
                </section>
            </div>

            <div class="df-target">
                <section class="df-card" aria-labelledby="transfer-target-title">
                    <h2 id="transfer-target-title" class="h5 fw-bold mb-1">Bàn sau khi chuyển</h2>
                    <p class="small df-muted mb-2">
                        Tích tất cả bàn khách sẽ dùng, kể cả bàn đang ngồi nếu cần gộp thêm.
                    </p>
                    <span asp-validation-for="TableIds" class="text-danger small d-block"></span>

                    @if (Model.Tables.Count == 0)
                    {
                        <p class="small df-muted my-2">Chưa có bàn đang hoạt động để lựa chọn.</p>
                    }

                    @foreach (var area in Model.Tables.GroupBy(table => table.AreaId))
                    {
                        <fieldset class="df-area">
                            <legend>@area.First().AreaName</legend>
                            <div class="df-table-grid">
                                @foreach (var table in area)
                                {
                                    var selected = table.IsAvailable && Model.TableIds.Contains(table.Id);

                                    <label class="df-table">
                                        <input type="checkbox" name="TableIds" value="@table.Id"
                                               checked="@selected" disabled="@(!table.IsAvailable)"
                                               data-code="@table.Code" data-capacity="@table.Capacity" />
                                        <span class="df-break">
                                            <span class="df-table-meta">
                                                <strong>@table.Code</strong>
                                                <span class="small text-nowrap">@table.Capacity chỗ</span>
                                            </span>
                                            @if (!table.IsAvailable)
                                            {
                                                <span class="df-table-note df-break">
                                                    @(string.IsNullOrWhiteSpace(table.UnavailableReason)
                                                        ? "Không khả dụng" : table.UnavailableReason)
                                                </span>
                                            }
                                            else if (table.IsCurrent)
                                            {
                                                <span class="df-table-note">Bàn hiện tại</span>
                                            }
                                        </span>
                                    </label>
                                }
                            </div>
                        </fieldset>
                    }

                    <div class="df-selection mt-3">
                        <div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
                            <strong>Bàn sẽ sử dụng</strong>
                            <span id="transfer-capacity" class="small df-muted" role="status">
                                Cần đủ @reservation.PartySize chỗ
                            </span>
                        </div>
                        <p id="transfer-selected-names" class="df-break mb-2">Theo các bàn đã tích chọn</p>
                        <dl class="row g-2 small mb-0">
                            <div class="col-sm-6">
                                <dt class="df-muted">Bàn sẽ trả</dt>
                                <dd id="transfer-released-names" class="df-break mb-0">—</dd>
                            </div>
                            <div class="col-sm-6">
                                <dt class="df-muted">Bàn thêm</dt>
                                <dd id="transfer-added-names" class="df-break mb-0">—</dd>
                            </div>
                        </dl>
                        <p id="transfer-selection-status" class="small mt-2 mb-0" role="status"></p>
                    </div>

                    <div class="border-top mt-3 pt-3">
                        <label asp-for="Reason" class="form-label fw-semibold">Lý do chuyển hoặc gộp bàn</label>
                        <textarea asp-for="Reason" class="form-control" rows="2" maxlength="300" required
                                  placeholder="Ví dụ: Khách muốn ngồi cùng khu vực."></textarea>
                        <span asp-validation-for="Reason" class="text-danger small"></span>
                        <p class="small df-muted mt-2 mb-0">
                            Hệ thống kiểm tra lại bàn khi lưu và ghi lý do vào lịch sử.
                            Đơn gọi món, tiền cọc và voucher đi cùng lượt khách.
                        </p>

                        <div class="d-flex flex-wrap justify-content-end gap-2 mt-3">
                            <a href="@backUrl" class="btn btn-outline-secondary">Quay lại</a>
                            <button id="transfer-submit" type="submit" class="btn df-submit">
                                Xác nhận chuyển bàn
                            </button>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById("transfer-booking-form");
            const checkboxes = [...form.querySelectorAll('input[name="TableIds"]:enabled')];
            const currentTables = [...form.querySelectorAll("[data-current-table]")];
            const currentIds = new Set(currentTables.map(table => table.dataset.id));
            const partySize = Number(form.dataset.partySize);

            const capacityElement = document.getElementById("transfer-capacity");
            const namesElement = document.getElementById("transfer-selected-names");
            const releasedElement = document.getElementById("transfer-released-names");
            const addedElement = document.getElementById("transfer-added-names");
            const statusElement = document.getElementById("transfer-selection-status");
            const submitButton = document.getElementById("transfer-submit");
            const reason = form.querySelector('[name="Reason"]');
            const submitLabel = submitButton.textContent.trim();

            let submitting = false;

            function showNames(element, tables, empty) {
                element.textContent = tables.map(table => table.dataset.code).join(", ") || empty;
            }

            function updateSelection() {
                const selected = checkboxes.filter(table => table.checked);
                const selectedIds = new Set(selected.map(table => table.value));
                const capacity = selected.reduce((sum, table) => sum + Number(table.dataset.capacity), 0);
                const released = currentTables.filter(table => !selectedIds.has(table.dataset.id));
                const added = selected.filter(table => !currentIds.has(table.value));
                const changed = released.length > 0 || added.length > 0;
                const valid = selected.length > 0 && capacity >= partySize && changed;

                capacityElement.textContent = `${selected.length} bàn · ${capacity}/${partySize} chỗ`;
                showNames(namesElement, selected, "Chưa chọn bàn.");
                showNames(releasedElement, released, "Không có");
                showNames(addedElement, added, "Không có");
                submitButton.disabled = submitting || !valid;

                statusElement.classList.toggle("text-success", valid);
                statusElement.classList.toggle("text-danger", !valid);
                if (selected.length === 0) {
                    statusElement.textContent = "Chọn ít nhất một bàn.";
                } else if (capacity < partySize) {
                    statusElement.textContent = `Còn thiếu ${partySize - capacity} chỗ.`;
                } else if (!changed) {
                    statusElement.textContent = "Danh sách bàn vẫn giống hiện tại.";
                } else {
                    statusElement.textContent = "Đủ sức chứa.";
                }

                return valid;
            }

            form.addEventListener("change", updateSelection);
            reason.addEventListener("input", () => reason.setCustomValidity(""));
            form.addEventListener("submit", event => {
                if (submitting || !updateSelection()) {
                    event.preventDefault();
                    return;
                }

                if (!reason.value.trim()) {
                    event.preventDefault();
                    reason.setCustomValidity("Vui lòng nhập lý do.");
                    reason.reportValidity();
                    return;
                }

                if (!window.confirm("Xác nhận lưu danh sách bàn đã chọn?")) {
                    event.preventDefault();
                    return;
                }

                submitting = true;
                submitButton.disabled = true;
                submitButton.textContent = "Đang lưu...";
            });

            window.addEventListener("pageshow", () => {
                submitting = false;
                submitButton.textContent = submitLabel;
                updateSelection();
            });
            updateSelection();
        })();
    </script>
}
