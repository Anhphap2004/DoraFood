@using System.Linq
@model DoraFood.Areas.Admin.ViewModels.TransferBookingViewModel

@{
    var reservation = Model.Reservation;

    ViewData["Title"] = "Chuyển bàn";

    var currentCapacity = Model.CurrentTables
        .Sum(table => (int)table.Capacity);

    var backUrl = Url.RouteUrl(
        "DoraFoodManageBookingDetails",
        new { id = Model.Id });
}

<style>
    .booking-transfer {
        --transfer-primary: #922f40;
        --transfer-border: #e5e7eb;
        color: #252525;
    }

        .booking-transfer .transfer-card {
            border: 1px solid var(--transfer-border);
            border-radius: 16px;
            overflow: hidden;
            background: var(--bs-body-bg, #fff);
        }

        .booking-transfer .transfer-heading {
            padding: 24px;
            border-bottom: 1px solid var(--transfer-border);
        }

        .booking-transfer .transfer-information {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 20px;
            margin: 22px 0 0;
        }

            .booking-transfer .transfer-information dt {
                color: var(--bs-secondary-color, #666);
                font-size: 12px;
                font-weight: normal;
                margin-bottom: 5px;
            }

            .booking-transfer .transfer-information dd {
                margin: 0;
                font-weight: 600;
                overflow-wrap: anywhere;
            }

        .booking-transfer .transfer-body {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
        }

        .booking-transfer .transfer-current {
            padding: 24px;
            border-right: 1px solid var(--transfer-border);
            background: rgb(146 47 64 / 4%);
        }

        .booking-transfer .transfer-target {
            padding: 24px;
            min-width: 0;
        }

        .booking-transfer .transfer-current-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            padding: 12px 0;
            border-bottom: 1px solid var(--transfer-border);
        }

        .booking-transfer .transfer-table-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
        }

        .booking-transfer .transfer-table-option {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            height: 100%;
            padding: 15px;
            border: 1px solid var(--transfer-border);
            border-radius: 10px;
            cursor: pointer;
        }

            .booking-transfer .transfer-table-option:has(input:checked) {
                border-color: var(--transfer-primary);
                background: rgb(146 47 64 / 6%);
                box-shadow: inset 0 0 0 1px var(--transfer-primary);
            }

            .booking-transfer .transfer-table-option:has(input:disabled) {
                background: var(--bs-tertiary-bg, #f4f4f4);
                cursor: not-allowed;
            }

            .booking-transfer .transfer-table-option:has(input:focus-visible) {
                outline: 3px solid #d99caa;
                outline-offset: 2px;
            }

        .booking-transfer .transfer-selection {
            margin-top: 22px;
            padding: 16px;
            border: 1px solid var(--transfer-border);
            border-radius: 10px;
            background: var(--bs-tertiary-bg, #f7f7f7);
        }

        .booking-transfer .transfer-footer {
            padding: 24px;
            border-top: 1px solid var(--transfer-border);
        }

    @@media (max-width: 991.98px) {
        .booking-transfer .transfer-body {
            grid-template-columns: 1fr;
        }

        .booking-transfer .transfer-current {
            border-right: 0;
            border-bottom: 1px solid var(--transfer-border);
        }

        .booking-transfer .transfer-information {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 575.98px) {
        .booking-transfer .transfer-table-grid {
            grid-template-columns: 1fr;
        }

        .booking-transfer .transfer-heading,
        .booking-transfer .transfer-current,
        .booking-transfer .transfer-target,
        .booking-transfer .transfer-footer {
            padding: 18px;
        }
    }
</style>

<div class="container-fluid booking-transfer pb-4">

    <div class="d-flex flex-wrap justify-content-between
        align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Chuyển bàn đang phục vụ</h1>

            <p class="text-body-secondary mb-0">
                Chọn đầy đủ các bàn khách sẽ sử dụng sau khi chuyển.
            </p>
        </div>

        <a href="@backUrl" class="btn btn-outline-secondary">
            ← Về chi tiết đặt bàn
        </a>
    </div>

    @if (TempData["BookingManagementError"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }

    <form id="transfer-booking-form"
          action="@Url.RouteUrl(
                      "DoraFoodTransferBooking",
                      new { id = Model.Id })"
          method="post"
          class="transfer-card shadow-sm"
          data-party-size="@reservation.PartySize">

        @Html.AntiForgeryToken()

        <input asp-for="Version" type="hidden" />

        <!-- Thông tin lượt khách -->
        <div class="transfer-heading">

            <div class="d-flex flex-wrap justify-content-between
                align-items-start gap-3">
                <div>
                    <h2 class="h5 mb-1">Thông tin lượt khách</h2>

                    <div class="small text-body-secondary text-break">
                        Mã đặt bàn: @reservation.Code
                    </div>
                </div>

                <span class="badge bg-success px-3 py-2">
                    Khách đang dùng bữa
                </span>
            </div>

            <dl class="transfer-information">
                <div>
                    <dt>Khách hàng</dt>
                    <dd>@reservation.GuestName</dd>
                </div>

                <div>
                    <dt>Số điện thoại</dt>
                    <dd>@reservation.GuestPhone</dd>
                </div>

                <div>
                    <dt>Số khách</dt>
                    <dd>@reservation.PartySize người</dd>
                </div>

                <div>
                    <dt>Đơn gọi món</dt>
                    <dd>
                        @(Model.ActiveOrderCode
                            ?? "Chưa mở đơn")
                    </dd>
                </div>
            </dl>

            <div asp-validation-summary="All"
                 class="text-danger mt-3"
                 role="alert"></div>
        </div>

        <div class="transfer-body">

            <!-- Bàn hiện tại -->
            <section class="transfer-current"
                     aria-labelledby="current-tables-title">

                <h2 id="current-tables-title" class="h5 mb-2">
                    1. Bàn hiện tại
                </h2>

                <p class="small text-body-secondary mb-3">
                    Các bàn đang gắn với lượt khách.
                </p>

                @if (Model.CurrentTables.Count == 0)
                {
                    <p class="text-danger">
                        Lượt khách chưa có thông tin bàn.
                    </p>
                }
                else
                {
                    @foreach (var table in Model.CurrentTables)
                    {
                        <div class="transfer-current-item"
                             data-current-table
                             data-id="@table.Id"
                             data-code="@table.Code">

                            <div>
                                <div class="fw-bold">
                                    @table.Code
                                </div>

                                <div class="small text-body-secondary">
                                    @table.AreaName
                                </div>
                            </div>

                            <span class="text-nowrap">
                                @table.Capacity chỗ
                            </span>
                        </div>
                    }

                    <div class="d-flex justify-content-between
                        gap-3 mt-3">
                        <span>Tổng sức chứa</span>
                        <strong>@currentCapacity chỗ</strong>
                    </div>
                }

                <div class="small text-body-secondary mt-4">
                    Đơn gọi món, các món đã gọi, tiền cọc và
                    voucher được giữ nguyên khi chuyển bàn.
                </div>
            </section>

            <!-- Chọn bàn sau khi chuyển -->
            <section class="transfer-target"
                     aria-labelledby="target-tables-title">

                <h2 id="target-tables-title" class="h5 mb-2">
                    2. Bàn sau khi chuyển
                </h2>

                <p class="small text-body-secondary mb-3">
                    Bỏ chọn bàn không dùng nữa và chọn bàn mới.
                    Có thể giữ lại một phần bàn hiện tại.
                    Tổng sức chứa phải đủ
                    <strong>@reservation.PartySize khách</strong>.
                </p>

                <span asp-validation-for="TableIds"
                      class="text-danger d-block mb-3"></span>

                @if (Model.Tables.Count == 0)
                {
                    <div class="alert alert-warning mb-0">
                        Chưa có bàn đang hoạt động để lựa chọn.
                    </div>
                }
                else
                {
                    @foreach (var area in Model.Tables
                        .GroupBy(table => table.AreaId))
                    {
                        <fieldset class="mb-4">
                            <legend class="h6 mb-3">
                                @area.First().AreaName
                            </legend>

                            <div class="transfer-table-grid">
                                @foreach (var table in area)
                                {
                                    var selected =
                                        table.IsAvailable
                                        && Model.TableIds.Contains(table.Id);

                                    <label class="transfer-table-option"
                                           for="transfer-table-@table.Id">

                                        <input id="transfer-table-@table.Id"
                                               type="checkbox"
                                               class="form-check-input mt-1"
                                               name="TableIds"
                                               value="@table.Id"
                                               checked="@selected"
                                               disabled="@(!table.IsAvailable)"
                                               data-code="@table.Code"
                                               data-capacity="@table.Capacity" />

                                        <span class="d-block">
                                            <span class="fw-bold d-block">
                                                @table.Code
                                            </span>

                                            <span class="small d-block
                                                text-body-secondary">
                                                Sức chứa: @table.Capacity người
                                            </span>

                                            @if (!table.IsAvailable)
                                            {
                                                <span class="small text-danger
                                                    d-block mt-2">
                                                    @table.UnavailableReason
                                                </span>
                                            }
                                            else if (table.IsCurrent)
                                            {
                                                <span class="badge bg-primary mt-2">
                                                    Bàn hiện tại
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success mt-2">
                                                    Có thể chọn
                                                </span>
                                            }
                                        </span>
                                    </label>
                                }
                            </div>
                        </fieldset>
                    }
                }

                <!-- Tóm tắt cập nhật theo lựa chọn -->
                <div class="transfer-selection"
                     aria-live="polite"
                     aria-atomic="true">

                    <div class="d-flex flex-wrap
                        justify-content-between gap-2">
                        <strong>Bàn được chọn</strong>

                        <span id="transfer-capacity">
                            Chưa có lựa chọn
                        </span>
                    </div>

                    <div id="transfer-selected-names"
                         class="mt-2">
                    </div>

                    <div class="small mt-3">
                        <span class="text-body-secondary">
                            Bàn sẽ trả:
                        </span>

                        <span id="transfer-released-names">—</span>
                    </div>

                    <div class="small mt-1">
                        <span class="text-body-secondary">
                            Bàn nhận thêm:
                        </span>

                        <span id="transfer-added-names">—</span>
                    </div>

                    <div id="transfer-selection-status"
                         class="small mt-3">
                    </div>
                </div>
            </section>
        </div>

        <!-- Lý do và lưu -->
        <div class="transfer-footer">

            <label asp-for="Reason"
                   class="form-label fw-semibold">
                3. Lý do chuyển bàn
                <span class="text-danger">*</span>
            </label>

            <textarea asp-for="Reason"
                      class="form-control"
                      rows="3"
                      maxlength="300"
                      required
                      placeholder="Ví dụ: Khách muốn chuyển sang khu vực yên tĩnh hơn."></textarea>

            <span asp-validation-for="Reason"
                  class="text-danger"></span>

            <div class="d-flex flex-wrap justify-content-between
                align-items-center gap-3 mt-4">
                <p class="small text-body-secondary mb-0">
                    Hệ thống kiểm tra lại bàn khi lưu và ghi nhận
                    lý do vào lịch sử.
                </p>

                <div class="d-flex gap-2">
                    <a href="@backUrl"
                       class="btn btn-outline-secondary px-4">
                        Quay lại
                    </a>

                    <button id="transfer-submit"
                            type="submit"
                            class="btn btn-primary px-4">
                        Xác nhận chuyển bàn
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById("transfer-booking-form");

            if (!form) {
                return;
            }

            const checkboxes = [
                ...form.querySelectorAll(
                    'input[name="TableIds"]'
                )
            ];

            const currentTables = [
                ...form.querySelectorAll("[data-current-table]")
            ].map(element => ({
                id: element.dataset.id,
                code: element.dataset.code
            }));

            const currentIds = new Set(
                currentTables.map(table => table.id)
            );

            const partySize = Number(form.dataset.partySize);

            const capacityElement =
                document.getElementById("transfer-capacity");

            const namesElement =
                document.getElementById("transfer-selected-names");

            const releasedElement =
                document.getElementById("transfer-released-names");

            const addedElement =
                document.getElementById("transfer-added-names");

            const statusElement =
                document.getElementById("transfer-selection-status");

            const submitButton =
                document.getElementById("transfer-submit");

            function updateSelection() {
                const selected = checkboxes.filter(
                    checkbox =>
                        checkbox.checked && !checkbox.disabled
                );

                const selectedIds = new Set(
                    selected.map(checkbox => checkbox.value)
                );

                const capacity = selected.reduce(
                    (total, checkbox) =>
                        total + Number(checkbox.dataset.capacity),
                    0
                );

                const released = currentTables.filter(
                    table => !selectedIds.has(table.id)
                );

                const added = selected.filter(
                    checkbox => !currentIds.has(checkbox.value)
                );

                const changed =
                    released.length > 0 || added.length > 0;

                capacityElement.textContent =
                    `${selected.length} bàn · ${capacity}/${partySize} chỗ`;

                namesElement.textContent = selected.length > 0
                    ? selected.map(item => item.dataset.code).join(", ")
                    : "Chưa chọn bàn.";

                releasedElement.textContent = released.length > 0
                    ? released.map(table => table.code).join(", ")
                    : "Không có";

                addedElement.textContent = added.length > 0
                    ? added.map(item => item.dataset.code).join(", ")
                    : "Không có";

                const valid =
                    selected.length > 0
                    && capacity >= partySize
                    && changed;

                submitButton.disabled = !valid;

                statusElement.className = valid
                    ? "small mt-3 text-success"
                    : "small mt-3 text-danger";

                if (selected.length === 0) {
                    statusElement.textContent =
                        "Anh hãy chọn ít nhất một bàn.";
                } else if (capacity < partySize) {
                    statusElement.textContent =
                        `Còn thiếu ${partySize - capacity} chỗ ngồi.`;
                } else if (!changed) {
                    statusElement.textContent =
                        "Danh sách bàn vẫn giống hiện tại.";
                } else {
                    statusElement.textContent =
                        "Đủ sức chứa. Anh nhập lý do rồi xác nhận chuyển bàn.";
                }

                return valid;
            }

            checkboxes.forEach(checkbox => {
                checkbox.addEventListener(
                    "change",
                    updateSelection
                );
            });

            form.addEventListener("submit", event => {
                if (!updateSelection()) {
                    event.preventDefault();
                    return;
                }

                const reason = form.querySelector(
                    '[name="Reason"]'
                );

                if (!reason.value.trim()) {
                    event.preventDefault();
                    reason.focus();
                    return;
                }

                const confirmed = window.confirm(
                    "Xác nhận chuyển sang các bàn đã chọn? " +
                    "Đơn gọi món và tiền đã thu được giữ nguyên."
                );

                if (!confirmed) {
                    event.preventDefault();
                    return;
                }

                submitButton.disabled = true;
                submitButton.textContent = "Đang lưu chuyển bàn...";
            });

            updateSelection();
        })();
    </script>
}