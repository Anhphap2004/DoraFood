@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using DoraFood.ViewModels
@model DoraFood.Models.Order

@{
    var preorder = Model.Reservation?.Status == "CONFIRMED";
    var culture = CultureInfo.GetCultureInfo("vi-VN");
    var dishes = ViewData["TableDishOptions"] as IReadOnlyList<StaffDishOption>
        ?? Array.Empty<StaffDishOption>();
    var items = Model.OrderItems.Where(item => item.Status != "CANCELLED")
        .OrderByDescending(item => item.CreatedAtUtc)
        .ThenByDescending(item => item.Id).ToList();
    var history = ViewData["TableOrderItemHistory"] as IReadOnlyList<DoraFood.Models.AuditLog>
        ?? Array.Empty<DoraFood.Models.AuditLog>();
    var subtotal = items.Sum(item => item.Quantity * item.UnitPrice);
    var canEdit = ViewData["CanAddTableOrderItems"] is true;
    var tables = Model.OrderTables.Where(link => link.ReleasedAtUtc == null)
        .Select(link => link.Table.Code).ToList();
    var heading = preorder ? "Đặt món trước" : "Đơn gọi món";
    ViewData["Title"] = heading;
    string Money(decimal amount) => amount.ToString("#,0.##", culture) + " ₫";
}

<link rel="stylesheet" href="@Url.Content("~/assets/css/dorafood-table-dishes.css")" asp-append-version="true" />
<script src="@Url.Content("~/assets/js/dorafood-table-dishes.js")" asp-append-version="true" defer></script>

<div class="df-table-dishes">
    <header class="df-table-dishes__heading">
        <div>
            @if (Model.ReservationId is long reservationId)
            {
                <a href="@Url.RouteUrl("DoraFoodManageBookingDetails", new { id = reservationId })">← Chi tiết đặt bàn</a>
            }
            <h1>@heading</h1>
            <div class="df-table-dishes__meta">
                <span>Đơn @Model.Code</span>
                @if (preorder && Model.Reservation is { } reservation)
                {
                    <span>Giờ hẹn @reservation.StartsAtUtc.AddHours(7).ToString("HH:mm · dd/MM/yyyy", culture)</span>
                }
                else if (tables.Count > 0)
                {
                    <span>Bàn @string.Join(", ", tables)</span>
                }
            </div>
        </div>
        @if (ViewData["CanPayTableOrder"] is true)
        {
            <a class="btn df-table-dishes__primary" href="@Url.RouteUrl("DoraFoodTableCheckout", new { orderId = Model.Id })">Thanh toán</a>
        }
    </header>

    @if (TempData["BookingManagementSuccess"] is string bookingMessage)
    {
        <p class="alert alert-success" role="status">@bookingMessage</p>
    }
    @if (TempData["TableOrderSuccess"] is string orderMessage)
    {
        <p class="alert alert-success" role="status">@orderMessage</p>
    }
    @if (TempData["TableOrderError"] is string orderError)
    {
        <p class="alert alert-danger" role="alert">@orderError</p>
    }

    @if (canEdit && dishes.Count > 0)
    {
        <div class="df-table-dishes__workspace" data-dish-workspace>
            <section aria-labelledby="df-dish-menu">
                <h2 id="df-dish-menu">Chọn món</h2>
                <label for="df-dish-query" class="visually-hidden">Tìm tên món</label>
                <input type="search" class="form-control df-table-dishes__search"
                       id="df-dish-query" data-dish-search placeholder="Tìm tên món hoặc khẩu phần" />
                <p class="df-table-dishes__muted" data-no-results hidden>Không tìm thấy món phù hợp.</p>

                <div class="df-table-dishes__grid">
                    @foreach (var dish in dishes)
                    {
                        <article class="df-dish-card" data-dish-name="@dish.Name">
                            <div class="df-dish-card__image">
                                @if (!string.IsNullOrWhiteSpace(dish.ImageUrl) && Url.IsLocalUrl(dish.ImageUrl))
                                {
                                    <img src="@Url.Content(dish.ImageUrl)" alt="" width="360" height="240" loading="lazy" />
                                }
                                else
                                {
                                    <span>Chưa có ảnh</span>
                                }
                            </div>
                            <div class="df-dish-card__body">
                                <h3>@dish.Name</h3>
                                <footer>
                                    <span>@Money(dish.Price)</span>
                                    <button type="button" class="btn df-table-dishes__add"
                                            data-add-dish="@dish.Id" data-price="@dish.Price.ToString(CultureInfo.InvariantCulture)"
                                            aria-label="Thêm @dish.Name">+ Thêm</button>
                                </footer>
                            </div>
                        </article>
                    }
                </div>
            </section>

            <section class="df-dish-cart" aria-labelledby="df-dish-cart-title">
                <h2 id="df-dish-cart-title">Món đang chọn</h2>
                <form action="@Url.RouteUrl("DoraFoodSaveTableDishes", new { orderId = Model.Id })"
                      method="post" data-dish-cart>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="operationId" value="@Guid.NewGuid()" />
                    <p class="df-table-dishes__muted" data-cart-empty>Chọn món từ thực đơn.</p>
                    <div data-cart-lines></div>
                    <div data-cart-fields></div>
                    <p class="df-dish-cart__total"><span>Tạm tính</span><strong data-cart-total>0 ₫</strong></p>
                    <p class="visually-hidden" aria-live="polite" data-cart-status></p>
                    <button type="submit" class="btn df-table-dishes__primary w-100"
                            data-cart-submit disabled>Xác nhận thêm món</button>
                    <noscript><p>Bật JavaScript để chọn nhiều món.</p></noscript>
                </form>
            </section>
        </div>
    }
    else if (canEdit)
    {
        <p class="df-table-dishes__muted">Hiện chưa có món đang bán.</p>
    }

    <section class="df-dish-history" aria-labelledby="df-saved-dishes">
        <h2 id="df-saved-dishes">@(preorder ? "Món đã đặt trước" : "Món đã gọi")</h2>
        @if (items.Count == 0)
        {
            <p class="df-table-dishes__muted mb-0">Chưa có món trong đơn.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Món</th>
                            <th scope="col">Thêm lúc (giờ Việt Nam)</th>
                            <th scope="col" class="text-end">SL</th>
                            <th scope="col" class="text-end">Đơn giá</th>
                            <th scope="col" class="text-end">Thành tiền</th>
                            @if (canEdit)
                            {
                                <th scope="col">Thao tác</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in items)
                        {
                            <tr>
                                <td>
                                    @item.NameSnapshot
                                    @if (!string.IsNullOrWhiteSpace(item.Note))
                                    {
                                        <div class="df-table-dishes__muted small">@item.Note</div>
                                    }
                                </td>
                                <td>@item.CreatedAtUtc.AddHours(7).ToString("HH:mm:ss · dd/MM/yyyy", culture)</td>
                                <td class="text-end">@item.Quantity.ToString("0.###", culture)</td>
                                <td class="text-end text-nowrap">@Money(item.UnitPrice)</td>
                                <td class="text-end text-nowrap">@Money(item.Quantity * item.UnitPrice)</td>
                                @if (canEdit)
                                {
                                    <td>
                                        <details>
                                            <summary>Hủy món</summary>
                                            <form class="df-dish-cancel" method="post"
                                                  action="@Url.RouteUrl("DoraFoodCancelTableDishFromAdmin", new { orderId = Model.Id, lineId = item.Id })">
                                                @Html.AntiForgeryToken()
                                           
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Xác nhận hủy</button>
                                            </form>
                                        </details>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="df-dish-cart__total"><span>Tiền món tạm tính</span><strong>@Money(subtotal)</strong></p>
        }
        @if (history.Count > 0)
        {
            <details class="mt-3">
                <summary>Lịch sử sửa đơn</summary>
                <ul class="mb-0 mt-2">
                    @foreach (var entry in history)
                    {
                        <li>
                            <strong>@(entry.Actor?.UserName ?? "Hệ thống")</strong>
                            <small>@entry.CreatedAtUtc.AddHours(7).ToString("HH:mm:ss · dd/MM/yyyy", culture)</small>
                            <div>@entry.Summary</div>
                        </li>
                    }
                </ul>
            </details>
        }
    </section>
</div>
