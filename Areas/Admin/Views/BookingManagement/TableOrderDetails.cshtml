@using System.Globalization
@using System.Linq
@model DoraFood.Models.Order

@{
    ViewData["Title"] = $"Đơn gọi món {Model.Code}";

    var culture = CultureInfo.GetCultureInfo("vi-VN");
    var items = Model.OrderItems.OrderBy(item => item.Id).ToList();

    var tableCodes = Model.OrderTables
        .Where(link => link.ReleasedAtUtc == null)
        .Select(link => link.Table.Code)
        .OrderBy(code => code)
        .ToList();

    var subtotal = items
        .Where(item => item.Status != "CANCELLED")
        .Sum(item => item.Quantity * item.UnitPrice);

    var orderStatus = Model.Status switch
    {
        "OPEN" => "Đang mở",
        "IN_PROGRESS" => "Đang phục vụ",
        "COMPLETED" => "Đã hoàn tất",
        "CANCELLED" => "Đã hủy",
        _ => Model.Status
    };
}

<div class="container py-5">
    @if (Model.ReservationId.HasValue)
    {
        <a href="@Url.RouteUrl(
                     "DoraFoodManageBookingDetails",
                     new { id = Model.ReservationId.Value })"
           class="btn btn-outline-secondary rounded-pill mb-3">
            Về chi tiết đặt bàn
        </a>
    }

    <div class="d-flex flex-wrap justify-content-between
        align-items-center gap-3 mb-4">

        <div>
            <h1 class="h3 mb-2 text-break">
                Đơn gọi món @Model.Code
            </h1>

            <p class="text-muted mb-0">
                @orderStatus · Bàn hiện tại
                @(tableCodes.Count > 0
                    ? string.Join(", ", tableCodes)
                    : "—")
            </p>
        </div>
        @if (Model.Status == "COMPLETED")
        {
            <a href="@Url.RouteUrl(
                         "DoraFoodTableInvoice",
                         new { orderId = Model.Id })"
               class="btn btn-outline-primary rounded-pill px-4">

                <i class="fas fa-receipt me-2"
                   aria-hidden="true"></i>

                Xem hóa đơn
            </a>
        }
        @if (Model.Status == "OPEN" || Model.Status == "IN_PROGRESS")
        {
            <a href="@Url.RouteUrl(
                         "DoraFoodTableCheckout",
                         new { orderId = Model.Id })"
               class="btn btn-success rounded-pill px-4">

                <i class="fas fa-money-bill-wave me-2"
                   aria-hidden="true"></i>

                Thanh toán
            </a>
        }
    </div>
    @if (TempData["TableOrderSuccess"] is string paymentSuccess)
    {
        <div class="alert alert-success" role="status">
            @paymentSuccess
        </div>
    }

    @if (TempData["BookingManagementSuccess"] is string message)
    {
        <div class="alert alert-success" role="status">
            @message
        </div>
    }
    
    @if (TempData["TableOrderError"] is string orderError)
    {
        <div class="alert alert-danger" role="alert">@orderError</div>
    }

    @if (ViewData["CanAddTableOrderItems"] is true)
    {
        var availableVariants =
            ViewData["AvailableDishVariants"]
            as System.Collections.Generic.List<DoraFood.Models.DishVariant>;

        <section class="card border-0 shadow-sm mb-4"
                 aria-labelledby="add-order-item-title">
            <div class="card-body p-4">
                <h2 id="add-order-item-title" class="h5 mb-3">Thêm món</h2>

                @if (availableVariants is { Count: > 0 })
                {
                    <form action="@Url.RouteUrl(
                                      "DoraFoodAddTableOrderItem",
                                      new { orderId = Model.Id })"
                          method="post"
                          class="row g-3">
                        @Html.AntiForgeryToken()

                        <div class="col-md-9">
                            <label for="order-variant" class="form-label">
                                Món và lựa chọn
                            </label>
                            <select id="order-variant" name="variantId"
                                    class="form-select" required>
                                <option value="">Chọn món</option>
                                @foreach (var variant in availableVariants)
                                {
                                    <option value="@variant.Id">
                                        @variant.Dish.Name · @variant.Name
                                        · @variant.Price.ToString("#,##0.##", culture) ₫
                                        / @variant.SellingUnit
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label for="order-quantity" class="form-label">
                                Số lượng
                            </label>
                            <input id="order-quantity" name="quantity"
                                   class="form-control" type="number"
                                   value="1" min="1" max="999" step="1" required />
                        </div>

                        <div class="col-12">
                            <label for="order-note" class="form-label">Ghi chú</label>
                            <textarea id="order-note" name="note"
                                      class="form-control" rows="2" maxlength="500"
                                      placeholder="Ví dụ: ít cay, để riêng nước chấm"></textarea>
                        </div>

                        <div class="col-12">
                            <button type="submit"
                                    class="btn btn-primary rounded-pill px-4">
                                Thêm vào đơn
                            </button>
                        </div>
                    </form>
                }
                else
                {
                    <p class="text-muted mb-0">Hiện chưa có món đang bán.</p>
                }
            </div>
        </section>
    }
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <h2 class="h5 mb-3">Món đã gọi</h2>

            @if (items.Count == 0)
            {
                <p class="text-muted">Đơn chưa có món.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th scope="col">Món</th>
                                <th scope="col" class="text-end">Số lượng</th>
                                <th scope="col" class="text-end">Đơn giá</th>
                                <th scope="col" class="text-end">Thành tiền</th>
                                <th scope="col" class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in items)
                            {
                                <tr>
                                    <td>
                                        @item.NameSnapshot
                                        @if (item.Status == "CANCELLED")
                                        {
                                            <span class="badge bg-secondary">Đã hủy</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.Note))
                                        {
                                            <div class="small text-muted">@item.Note</div>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (ViewData["CanAddTableOrderItems"] is true
                                            && item.Status != "CANCELLED")
                                        {
                                            <form action="@Url.RouteUrl(
                                                              "DoraFoodUpdateTableOrderItemQuantity",
                                                              new
                                                              {
                                                                  orderId = Model.Id,
                                                                  itemId = item.Id
                                                              })"
                                                  method="post"
                                                  data-item-quantity
                                                  class="d-inline-block"
                                                  style="width: 185px;">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="version"
                                                       value="@Convert.ToBase64String(item.Version)" />

                                                <div class="input-group input-group-sm">
                                                    <button type="button"
                                                            class="btn btn-outline-secondary"
                                                            data-quantity-change="-1"
                                                            aria-label="Giảm số lượng">
                                                        −
                                                    </button>

                                                    <input type="number"
                                                           name="quantity"
                                                           value="@item.Quantity.ToString(
                                                                      "0.###",
                                                                      CultureInfo.InvariantCulture)"
                                                           min="0.001"
                                                           max="999"
                                                           step="0.001"
                                                           required
                                                           class="form-control text-center"
                                                           aria-label="Số lượng món @item.NameSnapshot" />

                                                    <button type="button"
                                                            class="btn btn-outline-secondary"
                                                            data-quantity-change="1"
                                                            aria-label="Tăng số lượng">
                                                        +
                                                    </button>
                                                </div>

                                                <button type="submit"
                                                        class="btn btn-sm btn-primary w-100 mt-2">
                                                    Xác nhận
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            @item.Quantity.ToString("0.###", culture)
                                        }
                                    </td>
                                    <td class="text-end">
                                        @item.UnitPrice.ToString("#,##0.##", culture) ₫
                                    </td>
                                    <td class="text-end">
                                        @(item.Status == "CANCELLED"
                                            ? "—"
                                            : (item.Quantity * item.UnitPrice)
                                                .ToString("#,##0.##", culture) + " ₫")
                                    </td>
                                    <td class="text-end">
                                        @if (ViewData["CanAddTableOrderItems"] is true
                                            && item.Status != "CANCELLED")
                                        {
                                            <form action="@Url.RouteUrl(
                                                              "DoraFoodCancelTableOrderItem",
                                                              new
                                                              {
                                                                  orderId = Model.Id,
                                                                  itemId = item.Id
                                                              })"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Xác nhận hủy dòng món này và các món thêm đi kèm?');">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="version"
                                                       value="@Convert.ToBase64String(item.Version)" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger text-nowrap">
                                                    Hủy món
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="border-top pt-3 d-flex justify-content-between gap-3">
                <strong>Tiền món tạm tính</strong>
                <strong>@subtotal.ToString("#,##0.##", culture) ₫</strong>
            </div>
            @{
                var itemHistory =
                    ViewData["TableOrderItemHistory"]
                    as System.Collections.Generic.IReadOnlyList<
                        DoraFood.Models.AuditLog>;
            }

            @if (itemHistory is { Count: > 0 })
            {
                <section class="border-top pt-4 mt-4"
                         aria-labelledby="item-history-title">

                    <div class="d-flex flex-wrap justify-content-between
                        align-items-center gap-2 mb-3">
                        <h2 id="item-history-title" class="h5 mb-0">
                            Lịch sử điều chỉnh món
                        </h2>

                        <span class="small text-muted">
                            Tối đa 30 thao tác gần nhất
                        </span>
                    </div>

                    <ol class="list-group list-group-flush">
                        @foreach (var entry in itemHistory)
                        {
                            <li class="list-group-item px-0 py-3">
                                <div class="d-flex flex-wrap
                                    justify-content-between gap-2">

                                    <strong>
                                        @(entry.Action == "TABLE_ORDER_ITEM_CANCELLED"
                                            ? "Hủy món"
                                            : "Điều chỉnh món")
                                    </strong>

                                    <span class="small text-muted">
                                        @entry.CreatedAtUtc.AddHours(7)
                                        .ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                </div>

                                <div class="small text-muted mt-1">
                                    Nhân viên:
                                    @(entry.Actor?.UserName ?? "Chưa có thông tin")
                                </div>

                                <div class="small text-break mt-2"
                                     style="white-space: pre-wrap;">
                                    @entry.Summary
                                </div>
                            </li>
                        }
                    </ol>
                </section>
            }
        </div>
    </div>
</div>
@section Scripts {
    <script>
        (() => {
            document.querySelectorAll("[data-item-quantity]")
                .forEach(form => {
                    const input = form.querySelector(
                        'input[name="quantity"]'
                    );

                    const submit = form.querySelector(
                        'button[type="submit"]'
                    );

                    const originalQuantity = Number(input.value);

                    const buttons = [
                        ...form.querySelectorAll(
                            "[data-quantity-change]"
                        )
                    ];

                    function refresh() {
                        const value = Number(input.value);
                        const valid =
                            input.value !== ""
                            && input.checkValidity()
                            && Number.isFinite(value);

                        submit.disabled =
                            !valid || value === originalQuantity;

                        buttons.forEach(button => {
                            const next = value
                                + Number(button.dataset.quantityChange);

                            button.disabled =
                                !valid || next < 0.001 || next > 999;
                        });
                    }

                    buttons.forEach(button => {
                        button.addEventListener("click", () => {
                            const next = Number(input.value)
                                + Number(button.dataset.quantityChange);

                            if (next < 0.001 || next > 999) {
                                return;
                            }

                            input.value = (
                                Math.round(next * 1000) / 1000
                            ).toString();

                            refresh();
                        });
                    });

                    input.addEventListener("input", refresh);

                    form.addEventListener("submit", event => {
                        refresh();

                        if (submit.disabled) {
                            event.preventDefault();
                            return;
                        }

                        submit.disabled = true;
                        submit.textContent = "Đang lưu...";
                    });

                    refresh();
                });
        })();
    </script>
}