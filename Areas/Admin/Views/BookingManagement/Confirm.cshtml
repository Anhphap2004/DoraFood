@using System
@using System.Linq
@model DoraFood.Controllers.BookingManagementController.ConfirmBookingViewModel

@{
    ViewData["Title"] = "Chọn bàn và xác nhận";
    var reservation = Model.Reservation;
    var arrivalLocal = reservation.StartsAtUtc.AddHours(7);
    var deadlineLocal = arrivalLocal.AddMinutes(30);
    var isExpired = reservation.StartsAtUtc <= DateTime.UtcNow.AddMinutes(-30);
    var hasAvailableTables = Model.Tables.Any(t => t.IsAvailable);
    var canSubmit = hasAvailableTables && !isExpired && reservation.Status == "PENDING";
    var sessionLabel = arrivalLocal.TimeOfDay >= TimeSpan.FromHours(10)
        && arrivalLocal.TimeOfDay < TimeSpan.FromHours(14)
        ? "Buổi trưa · 10:00–14:00"
        : arrivalLocal.TimeOfDay >= TimeSpan.FromHours(16)
            && arrivalLocal.TimeOfDay < TimeSpan.FromHours(22)
            ? "Buổi tối · 16:00–22:00"
            : "Ngoài giờ phục vụ";
    var confirmUrl = Url.RouteUrl("DoraFoodConfirmBooking", new { id = Model.Id });
    var detailsUrl = Url.RouteUrl("DoraFoodManageBookingDetails", new { id = Model.Id });
}

<section class="bg-light border-bottom py-5">
    <div class="container">
        <a href="@Url.RouteUrl("DoraFoodManageBookings")" class="text-decoration-none">
            <i class="fas fa-arrow-left me-2" aria-hidden="true"></i>
            Quản lý đặt bàn
        </a>
        <h1 class="fw-bold mt-4 mb-3" style="font-family: 'Segoe UI', Arial, sans-serif;">Chọn bàn và xác nhận</h1>
        <p class="text-muted mb-0">Chọn các bàn đủ chỗ và chưa được giữ trong cùng buổi phục vụ.</p>
    </div>
</section>

<section class="py-5">
    <div class="container">
        @if (TempData["BookingManagementError"] is string errorMessage)
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }
        @if (isExpired)
        {
            <div class="alert alert-warning" role="alert">
                Yêu cầu đã quá hạn chờ 30 phút, không thể xác nhận.
                <a href="@detailsUrl">Xem trạng thái mới nhất</a>.
            </div>
        }

        <div class="border rounded-4 bg-white p-4 mb-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                <h2 class="h4 fw-bold mb-0">Thông tin yêu cầu</h2>
                <span class="badge bg-warning text-dark rounded-pill px-3 py-2">Chờ xác nhận</span>
            </div>
            <dl class="row g-3 mb-0">
                <div class="col-md-6">
                    <dt class="text-muted small fw-normal">Mã yêu cầu</dt>
                    <dd class="fw-semibold text-break mb-0">@reservation.Code</dd>
                </div>
                <div class="col-md-6">
                    <dt class="text-muted small fw-normal">Người liên hệ</dt>
                    <dd class="fw-semibold text-break mb-0">@reservation.GuestName · @reservation.GuestPhone</dd>
                </div>
                <div class="col-md-6 col-lg-3">
                    <dt class="text-muted small fw-normal">Giờ đến dự kiến</dt>
                    <dd class="fw-semibold mb-0">@arrivalLocal.ToString("dd/MM/yyyy HH:mm")</dd>
                </div>
                <div class="col-md-6 col-lg-3">
                    <dt class="text-muted small fw-normal">Hạn khách đến</dt>
                    <dd class="fw-semibold text-danger mb-0">@deadlineLocal.ToString("dd/MM/yyyy HH:mm")</dd>
                </div>
                <div class="col-md-6 col-lg-3">
                    <dt class="text-muted small fw-normal">Buổi phục vụ</dt>
                    <dd class="fw-semibold mb-0">@sessionLabel</dd>
                </div>
                <div class="col-md-6 col-lg-3">
                    <dt class="text-muted small fw-normal">Số khách</dt>
                    <dd class="fw-bold text-primary mb-0">@reservation.PartySize người</dd>
                </div>
                @if (!string.IsNullOrWhiteSpace(reservation.Note))
                {
                    <div class="col-12">
                        <dt class="text-muted small fw-normal">Ghi chú</dt>
                        <dd class="mb-0" style="white-space: pre-wrap; overflow-wrap: anywhere;">@reservation.Note</dd>
                    </div>
                }
            </dl>
            <div class="alert alert-light border small mt-4 mb-0">
                Thời gian theo giờ Việt Nam. Hạn giữ bàn bằng giờ hẹn cộng 30 phút,
                không tính lại từ lúc xác nhận. Khách đã được nhận vào bàn
                sẽ tiếp tục sử dụng bàn đến khi quản lý hoàn tất lượt phục vụ.
            </div>
        </div>

        <form action="@confirmUrl" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Version" type="hidden" />
            <div asp-validation-summary="All" class="text-danger mb-4" role="alert"></div>
            <div class="border rounded-4 bg-white p-4">
                <h2 class="h4 fw-bold mb-2">Chọn bàn phù hợp</h2>
                <p class="text-muted mb-4">
                    Tổng sức chứa phải đạt ít nhất <strong>@reservation.PartySize chỗ</strong>.
                    Bàn đã được giữ trong cùng buổi hoặc đang có khách chưa hoàn tất sẽ không chọn được.
                </p>
                @if (Model.Tables.Count == 0)
                {
                    <div class="alert alert-warning mb-0">Chưa có bàn đang hoạt động phù hợp. Anh kiểm tra lại dữ liệu bàn, khu vực và giờ đến.</div>
                }
                else
                {
                    @foreach (var area in Model.Tables.GroupBy(t => t.AreaName))
                    {
                        <fieldset class="border-0 p-0 mb-4">
                            <legend class="h5 fw-bold mb-3">@area.Key</legend>
                            <div class="row g-3">
                                @foreach (var table in area)
                                {
                                    var isSelected = table.IsAvailable && Model.TableIds.Contains(table.Id);
                                    <div class="col-sm-6 col-lg-4 col-xl-3">
                                        <div class="border rounded-3 p-3 h-100 @(!table.IsAvailable ? "bg-light" : "")">
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input"
                                                       id="booking-table-@table.Id" name="TableIds" value="@table.Id"
                                                       checked="@isSelected" disabled="@(!table.IsAvailable || isExpired)" />
                                                <label class="form-check-label" for="booking-table-@table.Id">
                                                    <span class="d-block fw-bold">Bàn @table.Code</span>
                                                    <span class="text-muted small">Sức chứa: @table.Capacity người</span>
                                                </label>
                                            </div>
                                            <div class="mt-3">
                                                @if (table.IsAvailable)
                                                {
                                                    <span class="badge bg-success">Có thể chọn</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Đã giữ / đang có khách</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </fieldset>
                    }
                    @if (!hasAvailableTables)
                    {
                        <div class="alert alert-warning mb-0">Hiện không có bàn khả dụng cho yêu cầu này. Anh kiểm tra các lượt đang giữ bàn hoặc đang phục vụ.</div>
                    }
                }
            </div>
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mt-4">
                <a href="@detailsUrl" class="btn btn-outline-secondary rounded-pill px-4 py-3">Về chi tiết</a>
                <button type="submit" class="btn btn-primary rounded-pill px-4 py-3" disabled="@(!canSubmit)">
                    <i class="fas fa-check me-2" aria-hidden="true"></i>
                    Xác nhận và phân bàn
                </button>
            </div>
            <p class="text-muted small mt-3 mb-0">Hệ thống kiểm tra lại hạn giữ bàn, lịch trong cùng buổi và sức chứa khi lưu.</p>
        </form>
    </div>
</section>
