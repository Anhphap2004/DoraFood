@using System
@using System.Linq
@model DoraFood.Controllers.BookingManagementController.ConfirmBookingViewModel

@{
    ViewData["Title"] = "Chọn bàn và xác nhận";

    var reservation = Model.Reservation;
    var arrivalLocal = reservation.StartsAtUtc.AddHours(7);
    var deadlineLocal = arrivalLocal.AddMinutes(30);
    var isExpired = reservation.StartsAtUtc <= DateTime.UtcNow.AddMinutes(-30);
    var canChoose = !isExpired && reservation.Status == "PENDING";
    var availableCount = Model.Tables.Count(table => table.IsAvailable);

    var confirmUrl = Url.RouteUrl("DoraFoodConfirmBooking", new { id = Model.Id });
    var detailsUrl = Url.RouteUrl("DoraFoodManageBookingDetails", new { id = Model.Id });
}

<style>
    .df-booking-top {
        display: flex;
        flex-wrap: wrap;
        align-items: stretch;
        gap: 1rem;
        margin-bottom: 1rem;
    }

        .df-booking-top > section {
            flex: 1 1 18rem;
            min-width: 0;
            margin: 0;
        }

        .df-booking-top > .df-tet-table-photo {
            position: relative;
            flex: 2 1 27rem;
            min-width: 0;
            min-height: clamp(12rem, 21vw, 19rem);
            overflow: hidden;
            border: 1px solid #e4cbb9;
            border-radius: .9rem;
            background: #783434;
        }

    .df-tet-table-photo img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 56%;
        transition: transform .7s ease;
    }

    @@media (prefers-reduced-motion: no-preference) {
        .df-tet-table-photo:hover img {
            transform: scale(1.035);
        }

        .df-tet-table-photo::after {
            position: absolute;
            inset: 0;
            content: "";
            pointer-events: none;
            background: linear-gradient( 110deg, transparent 35%, rgb(255 218 154 / .18) 50%, transparent 65% );
            animation: df-tet-shimmer 1.8s ease-out both;
        }

        @@keyframes df-tet-shimmer {
            from {
                transform: translateX(-100%);
            }

            to {
                transform: translateX(100%);
            }
        }
    }

    .df-confirm {
        --df-cream: #f7f4ee;
        --df-peach: #eaa77c;
        --df-wine: #783434;
        --df-ink: #422820;
        --df-border: #e8ccba;
        color: var(--df-ink);
    }

    .df-confirm-heading {
        margin-bottom: 1rem;
    }

    .df-confirm-back {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        margin-bottom: .6rem;
        color: var(--df-wine);
        font-size: .875rem;
        font-weight: 600;
        text-decoration: none;
    }

        .df-confirm-back:hover {
            color: var(--df-wine);
            text-decoration: underline;
            text-underline-offset: .2em;
        }

    .df-confirm-title-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: .6rem 1rem;
    }

        .df-confirm-title-row h1 {
            margin: 0;
            color: var(--df-ink);
            font-size: clamp(1.5rem, 2.3vw, 2rem);
            font-weight: 700;
            line-height: 1.2;
        }

    .df-confirm-pending {
        padding: .35rem .8rem;
        border: 1px solid #e9c09c;
        border-radius: 999px;
        background: #f7e4d3;
        color: #784424;
        font-size: .82rem;
        font-weight: 700;
    }

    .df-booking-summary {
        margin-bottom: 1rem;
        padding: 1rem 1.2rem;
        border: 1px solid var(--df-border);
        border-top: 3px solid var(--df-peach);
        border-radius: .85rem;
        background: #fffaf4;
    }

    .df-booking-guest {
        display: grid;
        justify-items: start;
        gap: .2rem;
        overflow-wrap: anywhere;
    }

    .df-booking-label,
    .df-booking-facts dt {
        color: #70554a;
        font-size: .8rem;
        font-weight: 600;
    }

    .df-booking-guest-name {
        color: var(--df-wine);
        font-size: 1.2rem;
        line-height: 1.3;
    }

    .df-booking-phone {
        color: #70554a;
        font-size: .9rem;
    }

    .df-booking-facts {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: .65rem;
        margin: 0;
        padding: .75rem .9rem;
        border-radius: .65rem;
        background: #f5eee6;
    }

        .df-booking-facts dd {
            margin: .2rem 0 0;
            font-size: 1.1rem;
            font-weight: 700;
            font-variant-numeric: tabular-nums;
            line-height: 1.2;
        }

            .df-booking-facts dd span,
            .df-booking-facts .df-booking-date {
                color: #70554a;
                font-size: .8rem;
                font-weight: 500;
            }

    .df-booking-note {
        margin-top: .8rem;
        padding: .2rem 0 .2rem .75rem;
        border-left: 2px solid var(--df-peach);
    }

        .df-booking-note p {
            margin: .15rem 0 0;
            white-space: pre-wrap;
            overflow-wrap: anywhere;
        }

    .df-booking-reference {
        display: flex;
        flex-wrap: wrap;
        gap: .2rem .55rem;
        margin-top: .8rem;
        padding-top: .65rem;
        border-top: 1px solid var(--df-border);
        color: #70554a;
        font-size: .8rem;
    }

        .df-booking-reference code {
            min-width: 0;
            color: var(--df-wine);
            overflow-wrap: anywhere;
        }

    .df-confirm .df-confirm-panel {
        background: var(--df-cream);
        border: 1px solid var(--df-border);
        border-radius: 1rem;
        padding: 1.25rem;
    }

    .df-confirm .df-confirm-area {
        min-width: 0;
        border: 0;
        border-radius: 1rem;
        background: var(--df-peach);
        padding: 1rem;
    }

        .df-confirm .df-confirm-area legend {
            float: none;
            width: auto;
            margin: 0;
            padding: 0 .4rem;
            font-size: 1rem;
            font-weight: 700;
            color: var(--df-ink);
            background: var(--df-peach);
            border-radius: .3rem;
        }

    .df-confirm .df-confirm-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
        gap: .75rem;
    }

    .df-confirm .df-confirm-table {
        display: flex;
        align-items: center;
        gap: .65rem;
        min-height: 5rem;
        padding: .75rem;
        border: 2px solid transparent;
        border-radius: .8rem;
        background: var(--df-wine);
        color: #fff8ee;
    }

        .df-confirm .df-confirm-table:has(input:enabled) {
            cursor: pointer;
        }

            .df-confirm .df-confirm-table:has(input:enabled):hover {
                background: #652927;
            }

        .df-confirm .df-confirm-table:has(input:checked) {
            border-color: #f6d995;
            box-shadow: 0 0 0 2px #72441f;
        }

        .df-confirm .df-confirm-table:focus-within {
            outline: 2px solid #3f261b;
            outline-offset: 3px;
        }

        .df-confirm .df-confirm-table:has(input:disabled) {
            background: #e6c4b5;
            color: var(--df-ink);
        }

        .df-confirm .df-confirm-table input {
            flex: 0 0 auto;
            inline-size: 1.1rem;
            block-size: 1.1rem;
            accent-color: #f6d995;
        }

    .df-confirm .df-confirm-table-info {
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .df-confirm .df-confirm-badge {
        margin-inline-start: auto;
        padding: .25rem .55rem;
        border-radius: 2rem;
        background: #e6ecde;
        color: #304c36;
        font-size: .76rem;
        font-weight: 700;
        text-align: center;
    }

    .df-confirm .df-confirm-table:has(input:disabled) .df-confirm-badge {
        background: #f5e6de;
        color: #62453d;
    }

    .df-confirm .df-confirm-table:has(input:checked) .df-confirm-badge {
        background: #f6d995;
        color: #4b301b;
    }

    .df-confirm .df-confirm-table:has(input:checked) .df-confirm-available,
    .df-confirm .df-confirm-table:not(:has(input:checked)) .df-confirm-selected {
        display: none;
    }

    .df-confirm .df-confirm-submit {
        background: var(--df-wine);
        border-color: var(--df-wine);
        color: #fff8ee;
    }

        .df-confirm .df-confirm-submit:hover:not(:disabled) {
            background: #562120;
            color: #fff8ee;
        }

        .df-confirm .df-confirm-submit:disabled {
            background: #e3d1c8;
            border-color: #e3d1c8;
            color: #573d35;
            opacity: 1;
        }
</style>

<main class="df-confirm container-fluid py-4">
    <header class="df-confirm-heading">
        <a href="@detailsUrl" class="df-confirm-back">
            <span aria-hidden="true">←</span> Chi tiết đặt bàn
        </a>

        <div class="df-confirm-title-row">
            <h1>Chọn bàn và xác nhận</h1>

            @if (canChoose)
            {
                <span class="df-confirm-pending">Chờ xác nhận</span>
            }
        </div>
    </header>

    @if (TempData["BookingManagementError"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    @if (!canChoose)
    {
        <div class="alert alert-warning" role="alert">
            @(isExpired ? "Yêu cầu đã quá hạn giữ bàn." : "Yêu cầu không còn chờ xác nhận.")
            <a href="@detailsUrl" class="alert-link">Xem chi tiết</a>
        </div>
    }

    <div class="df-booking-top">
        <section class="df-booking-summary" aria-label="Thông tin khách đặt">

            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                <div class="df-booking-guest">
                    <span class="df-booking-label">Khách đặt</span>
                    <strong class="df-booking-guest-name">@reservation.GuestName</strong>
                    <span class="df-booking-phone">@reservation.GuestPhone</span>
                </div>

                <span class="df-confirm-pending">@reservation.PartySize khách</span>
            </div>

            <dl class="df-booking-facts mt-3"
                style="grid-template-columns: repeat(2, minmax(0, 1fr));">
                <div>
                    <dt>Giờ đến</dt>
                    <dd>@arrivalLocal.ToString("HH:mm")</dd>
                    <dd class="df-booking-date">@arrivalLocal.ToString("dd/MM/yyyy")</dd>
                </div>

                <div>
                    <dt>Giữ bàn đến</dt>
                    <dd>@deadlineLocal.ToString("HH:mm")</dd>

                    @if (deadlineLocal.Date != arrivalLocal.Date)
                    {
                        <dd class="df-booking-date">@deadlineLocal.ToString("dd/MM/yyyy")</dd>
                    }
                </div>
            </dl>

            @if (!string.IsNullOrWhiteSpace(reservation.Note))
            {
                <div class="df-booking-note">
                    <span class="df-booking-label">Ghi chú</span>
                    <p>@reservation.Note</p>
                </div>
            }

            <div class="df-booking-reference">
                <span>Mã đặt bàn</span>
                <code>@reservation.Code</code>
            </div>
        </section>

        <div class="df-tet-table-photo" aria-hidden="true">
            <img src="@Url.Content("~/images/booking/ban-tiec-tet.png")"
                 alt=""
                 width="1983"
                 height="793" />
        </div>
    </div>

    <form id="booking-confirm-form" action="@confirmUrl" method="post"
          data-party-size="@reservation.PartySize">
        @Html.AntiForgeryToken()
        <input asp-for="Version" type="hidden" />
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>

        <section class="df-confirm-panel mb-3" aria-labelledby="booking-tables-title">
            <h2 id="booking-tables-title" class="h5 fw-bold mb-1">Chọn bàn</h2>
            <p class="small mb-3">
                Có @availableCount bàn khả dụng. Chọn một hoặc nhiều bàn để đủ
                <strong>@reservation.PartySize chỗ</strong>.
            </p>

            @if (Model.Tables.Count == 0)
            {
                <p class="mb-0">Chưa có bàn để hiển thị.</p>
            }

            @foreach (var area in Model.Tables.GroupBy(table => table.AreaName))
            {
                <fieldset class="df-confirm-area mt-3">
                    <legend>@area.Key</legend>
                    <div class="df-confirm-grid">
                        @foreach (var table in area)
                        {
                            var isSelected = canChoose && table.IsAvailable
                                && Model.TableIds.Contains(table.Id);

                            <label class="df-confirm-table">
                                <input type="checkbox" name="TableIds" value="@table.Id"
                                       data-capacity="@table.Capacity"
                                       checked="@isSelected"
                                       disabled="@(!canChoose || !table.IsAvailable)" />

                                <span class="df-confirm-table-info">
                                    <strong class="d-block">@table.Code</strong>
                                    <span class="small">@table.Capacity chỗ</span>
                                </span>

                                <span class="df-confirm-badge" aria-hidden="true">
                                    @if (canChoose && table.IsAvailable)
                                    {
                                        <span class="df-confirm-available">Có thể chọn</span>
                                        <span class="df-confirm-selected">Đã chọn</span>
                                    }
                                    else
                                    {
                                        <span>Không khả dụng</span>
                                    }
                                </span>
                            </label>
                        }
                    </div>
                </fieldset>
            }
        </section>

        <div class="df-confirm-panel d-flex flex-wrap align-items-center
            justify-content-between gap-3">
            <p id="booking-selection-summary" class="mb-0" role="status">
                Cần ít nhất @reservation.PartySize chỗ.
            </p>

            <button type="submit" class="btn df-confirm-submit px-4"
                    disabled="@(!canChoose || availableCount == 0)">
                Xác nhận và phân bàn
            </button>
        </div>
    </form>
</main>

<script>
    (() => {
        const form = document.getElementById("booking-confirm-form");
        const summary = document.getElementById("booking-selection-summary");
        const submitButton = form.querySelector('button[type="submit"]');
        const tableInputs = [...form.querySelectorAll('input[name="TableIds"]:enabled')];
        const partySize = Number(form.dataset.partySize);
        const canSubmit = !submitButton.disabled;

        function updateSelection() {
            const selected = tableInputs.filter(input => input.checked);
            const capacity = selected.reduce(
                (total, input) => total + Number(input.dataset.capacity), 0);
            const missing = Math.max(0, partySize - capacity);

            summary.textContent = canSubmit
                ? `Đã chọn ${selected.length} bàn · ${capacity}/${partySize} chỗ · `
                + (missing > 0 ? `Thiếu ${missing} chỗ` : "Đủ chỗ")
                : "Hiện không thể xác nhận phân bàn.";

            submitButton.disabled = !canSubmit || selected.length === 0 || missing > 0;
        }

        form.addEventListener("change", updateSelection);
        window.addEventListener("pageshow", updateSelection);
        updateSelection();
    })();
</script>
