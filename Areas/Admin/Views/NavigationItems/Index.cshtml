@model System.Collections.Generic.IReadOnlyList<DoraFood.Areas.Admin.ViewModels.NavigationItemRow>

@{
    ViewData["Title"] = "Mục điều hướng";
}
<div class="tp-page tp-page-navigationitems tp-page-index">
    <section class="tp-module-intro" aria-label="Hướng dẫn màn hình">
        <div class="tp-module-icon">
        <i class="bi bi-signpost" aria-hidden="true">
        </i>
        </div>
        <div>
        <span class="tp-kicker">DORAFOOD · CHĂM CHÚT TỪNG CHI TIẾT</span>
        <h2>Sắp xếp hành trình khám phá</h2>
        <p>Quản lý nhóm menu, mục cha, đường dẫn và trạng thái hiển thị.</p>
        </div>
        <span class="tp-season-stamp">
        <i class="bi bi-flower1" aria-hidden="true">
        </i>Vị xuân sum vầy</span>
    </section>

@if (TempData["NavigationSuccess"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}
@if (TempData["NavigationError"] is string error)
{
    <div class="alert alert-warning" role="alert">@error</div>
}
<div class="mb-3">
    <a class="btn btn-primary"
       href="@Url.Action("Create", "NavigationItems", new { area = "Admin" })">
        + Tạo mục điều hướng
    </a>
</div>
<div class="card tp-card">
    <div class="card-header tp-card-header">
        <strong>Danh sách mục điều hướng</strong>
        <span class="text-body-secondary ms-2">@Model.Count mục</span>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card-body text-body-secondary">
            Chưa có mục điều hướng nào.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 tp-table">
                <thead>
                    <tr>
                        <th scope="col">Menu</th>
                        <th scope="col">Tên hiển thị</th>
                        <th scope="col">Mục cha</th>
                        <th scope="col">Đường dẫn</th>
                        <th scope="col" class="text-end">Thứ tự</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col" class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @item.MenuName
                                <div class="small text-body-secondary">
                                    @item.MenuCode
                                </div>
                            </td>
                            <td>
                                <a class="fw-semibold"
                                   href="@Url.Action("Edit", "NavigationItems",
                                       new { area = "Admin", id = item.Id })">
                                    @item.Label
                                </a>
                            </td>
                            <td>@(item.ParentLabel ?? "—")</td>
                            <td><code class="text-break">@item.Url</code></td>
                            <td class="text-end">@item.SortOrder</td>
                            <td>
                                @if (item.IsVisible)
                                {
                                    <span class="badge text-bg-success">Đang bật</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Đã ẩn</span>
                                }
                            </td>
                            <td class="text-end">
                                <form asp-area="Admin"
                                      asp-controller="NavigationItems"
                                      asp-action="Delete"
                                      asp-route-id="@item.Id"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Anh chắc chắn muốn xóa mục điều hướng này?');">

                                    <button type="submit"
                                            class="btn btn-outline-danger btn-sm"
                                            aria-label="Xóa mục @item.Label"><i class="bi bi-trash3 me-1" aria-hidden="true"></i>Xóa</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/admin/css/admin-tet-pages.css" asp-append-version="true" />
}
