@model DoraFood.Areas.Admin.ViewModels.NavigationItemEditInput

@{
    ViewData["Title"] = "Sửa mục điều hướng";
}
<div class="tp-page tp-page-navigationitems tp-page-edit">
    <section class="tp-module-intro" aria-label="Hướng dẫn màn hình">
        <div class="tp-module-icon">
        <i class="bi bi-pencil-square" aria-hidden="true">
        </i>
        </div>
        <div>
        <span class="tp-kicker">DORAFOOD · CHĂM CHÚT TỪNG CHI TIẾT</span>
        <h2>Điều chỉnh lối đi trên website</h2>
        <p>Cập nhật tên hiển thị, liên kết và vị trí của mục menu.</p>
        </div>
        <span class="tp-season-stamp">
        <i class="bi bi-flower1" aria-hidden="true">
        </i>Vị xuân sum vầy</span>
    </section>
    <div class="tp-workspace"><div class="tp-main">


<div class="card tp-card">
    <form asp-area="Admin"
          asp-controller="NavigationItems"
          asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post">

        <div class="card-body tp-field-grid">
        <div class="tp-form-section">
        <span class="tp-section-icon">
        <i class="bi bi-pencil-square" aria-hidden="true">
        </i>
        </span>
        <div>
        <h2>Thông tin mục điều hướng</h2>
        <p>Các thay đổi có hiệu lực sau khi lưu.</p>
        </div>
        </div>
            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-2"></div>

            <div class="mb-3">
                <label asp-for="Label" class="form-label">Tên hiển thị</label>
                <input asp-for="Label" class="form-control"
                       maxlength="100" required />
                <span asp-validation-for="Label" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Url" class="form-label">Đường dẫn</label>
                <input asp-for="Url" type="text" class="form-control"
                       maxlength="1000" placeholder="~/thuc-don" required />
                <span asp-validation-for="Url" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SortOrder" class="form-label">
                    Thứ tự hiển thị
                </label>
                <input asp-for="SortOrder" type="number" step="1"
                       class="form-control" required />
                <div class="form-text">Số nhỏ hơn được xếp trước.</div>
                <span asp-validation-for="SortOrder"
                      class="text-danger small"></span>
            </div>

            <div class="form-check form-switch tp-switch">
                <input asp-for="IsVisible" class="form-check-input" />
                <label asp-for="IsVisible" class="form-check-label">
                    Hiện trên thanh điều hướng
                </label>
            </div>
        </div>

        <div class="card-footer tp-card-footer d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1" aria-hidden="true"></i>Lưu thay đổi</button>
            <a class="btn btn-outline-secondary"
               href="@Url.Action("Index", "NavigationItems", new { area = "Admin" })">
                Về danh sách
            </a>
        </div>
    </form>
</div>
    </div>
<aside class="tp-help">
        <div class="tp-help-card">
        <span class="tp-help-flower" aria-hidden="true">✿</span>
        <span class="tp-kicker">GÓC CHUẨN BỊ</span>
        <h2>Điều hướng gọn, trải nghiệm tốt</h2>
        <ol>
        <li>
        <strong>Tên hiển thị</strong>
        <p>Ưu tiên tên ngắn gọn và dễ hiểu với khách.</p>
        </li>
        <li>
        <strong>Đường dẫn</strong>
        <p>Kiểm tra liên kết để khách đến đúng trang.</p>
        </li>
        <li>
        <strong>Thứ tự & hiển thị</strong>
        <p>Số nhỏ xếp trước; tắt hiển thị nếu muốn tạm ẩn mục.</p>
        </li>
        </ol>
        <div class="tp-help-wish">
        <i class="bi bi-cup-hot" aria-hidden="true">
        </i> Chăm từng chi tiết, trọn từng trải nghiệm.</div>
        </div>
        </aside>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/admin/css/admin-tet-pages.css" asp-append-version="true" />
}
