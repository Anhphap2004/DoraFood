@using System.Globalization
@model DoraFood.Areas.Admin.ViewModels.NavigationItemCreateInput

@{
    ViewData["Title"] = "Tạo mục điều hướng";
    var invariant = CultureInfo.InvariantCulture;
}
<div class="tp-page tp-page-navigationitems tp-page-create">
    <section class="tp-module-intro" aria-label="Hướng dẫn màn hình">
        <div class="tp-module-icon">
        <i class="bi bi-signpost-split" aria-hidden="true">
        </i>
        </div>
        <div>
        <span class="tp-kicker">DORAFOOD · CHĂM CHÚT TỪNG CHI TIẾT</span>
        <h2>Dẫn lối trải nghiệm khách hàng</h2>
        <p>Thêm mục điều hướng, chọn nhóm menu và vị trí hiển thị.</p>
        </div>
        <span class="tp-season-stamp">
        <i class="bi bi-flower1" aria-hidden="true">
        </i>Vị xuân sum vầy</span>
    </section>
    <div class="tp-workspace"><div class="tp-main">


<div class="card tp-card">
    <form asp-area="Admin"
          asp-controller="NavigationItems"
          asp-action="Create"
          method="post">

        <div class="card-body">
        <div class="tp-form-section">
        <span class="tp-section-icon">
        <i class="bi bi-signpost-split" aria-hidden="true">
        </i>
        </span>
        <div>
        <h2>Cấu hình mục điều hướng</h2>
        <p>Sắp xếp menu rõ ràng, giúp khách đến đúng nội dung.</p>
        </div>
        </div>
            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-2"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="MenuId" class="form-label">Nhóm menu</label>
                    <select asp-for="MenuId"
                            asp-items="Model.MenuOptions"
                            class="form-select" required>
                        <option value="">Chọn nhóm menu</option>
                    </select>
                    <span asp-validation-for="MenuId"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ParentId" class="form-label">Mục cha</label>
                    <select asp-for="ParentId" class="form-select">
                        <option value="">Mục cấp chính</option>

                        @foreach (var parent in Model.ParentOptions)
                        {
                            <option value="@parent.Id.ToString(invariant)"
                                    data-menu-id="@parent.MenuId.ToString(invariant)">
                                @parent.Label
                            </option>
                        }
                    </select>
                    <span asp-validation-for="ParentId"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Item.Label" class="form-label">
                        Tên hiển thị
                    </label>
                    <input asp-for="Item.Label" class="form-control"
                           maxlength="100" required />
                    <span asp-validation-for="Item.Label"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Item.Url" class="form-label">Đường dẫn</label>
                    <input asp-for="Item.Url" type="text" class="form-control"
                           maxlength="1000" placeholder="~/thuc-don" required />
                    <span asp-validation-for="Item.Url"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Item.SortOrder" class="form-label">
                        Thứ tự hiển thị
                    </label>
                    <input asp-for="Item.SortOrder" type="number" step="1"
                           class="form-control" required />
                    <div class="form-text">Số nhỏ hơn được xếp trước.</div>
                    <span asp-validation-for="Item.SortOrder"
                          class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <div class="form-check form-switch tp-switch">
                        <input asp-for="Item.IsVisible" class="form-check-input" />
                        <label asp-for="Item.IsVisible" class="form-check-label">
                            Hiện trên thanh điều hướng
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-footer tp-card-footer d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1" aria-hidden="true"></i>Lưu mục</button>
            <a class="btn btn-outline-secondary"
               href="@Url.Action("Index", "NavigationItems", new { area = "Admin" })">
                Về danh sách
            </a>
        </div>
    </form>
</div>

    </div>
<aside class="tp-help">
        <div class="tp-help-card">
        <span class="tp-help-flower" aria-hidden="true">✿</span>
        <span class="tp-kicker">GÓC CHUẨN BỊ</span>
        <h2>Dễ tìm, dễ khám phá</h2>
        <ol>
        <li>
        <strong>Nhóm menu</strong>
        <p>Chọn nhóm menu trước khi chọn mục cha.</p>
        </li>
        <li>
        <strong>Mục cha</strong>
        <p>Chọn Mục cấp chính nếu muốn mục xuất hiện ở cấp ngoài cùng.</p>
        </li>
        <li>
        <strong>Đường dẫn</strong>
        <p>Dùng đường dẫn phù hợp với các trang đang có của nhà hàng.</p>
        </li>
        <li>
        <strong>Thứ tự</strong>
        <p>Số nhỏ hơn được xếp trước. Có thể tắt hiển thị mà không cần xóa.</p>
        </li>
        </ol>
        <div class="tp-help-wish">
        <i class="bi bi-cup-hot" aria-hidden="true">
        </i> Chăm từng chi tiết, trọn từng trải nghiệm.</div>
        </div>
        </aside>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/admin/css/admin-tet-pages.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        (() => {
            const menu = document.getElementById("MenuId");
            const parent = document.getElementById("ParentId");

            function filterParents() {
                for (const option of parent.options) {
                    if (option.value === "") continue;

                    const matches = option.dataset.menuId === menu.value;
                    option.hidden = !matches;
                    option.disabled = !matches;
                }

                if (parent.selectedOptions[0]?.disabled) {
                    parent.value = "";
                }
            }

            menu.addEventListener("change", filterParents);
            filterParents();
        })();
    </script>
}