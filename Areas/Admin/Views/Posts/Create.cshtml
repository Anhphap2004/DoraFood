@model DoraFood.Areas.Admin.ViewModels.PostFormInput

@{
    ViewData["Title"] = "Tạo bài viết";

    var contentHtml = Html.ValueFor(m => m.ContentHtml) ?? string.Empty;
    var editorHtml = new Ganss.Xss.HtmlSanitizer().Sanitize(contentHtml);
}
<div class="tp-page tp-page-posts tp-page-create">
    <section class="tp-module-intro" aria-label="Hướng dẫn màn hình">
        <div class="tp-module-icon">
        <i class="bi bi-journal-plus" aria-hidden="true">
        </i>
        </div>
        <div>
        <span class="tp-kicker">DORAFOOD · CHĂM CHÚT TỪNG CHI TIẾT</span>
        <h2>Kể câu chuyện từ gian bếp</h2>
        <p>Soạn bài viết, chuẩn bị nội dung và lưu bản nháp.</p>
        </div>
        <span class="tp-season-stamp">
        <i class="bi bi-flower1" aria-hidden="true">
        </i>Vị xuân sum vầy</span>
    </section>
    <div class="tp-workspace"><div class="tp-main">


<div class="tp-inner">
    <form asp-area="Admin" asp-controller="Posts" asp-action="Create"
          asp-antiforgery="true" method="post"
          class="card border-0 shadow-sm tp-card">

        <div class="card-body p-4">
        <div class="tp-form-section">
        <span class="tp-section-icon">
        <i class="bi bi-journal-plus" aria-hidden="true">
        </i>
        </span>
        <div>
        <h2>Thông tin bài viết</h2>
        <p>Tiêu đề rõ ràng, nội dung hấp dẫn và đúng danh mục.</p>
        </div>
        </div>
            <p class="text-body-secondary">Bài viết sẽ được lưu dưới dạng bản nháp.</p>

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row g-3 mb-3">
                <div class="col-lg-8">
                    <label asp-for="Title" class="form-label">Tiêu đề</label>
                    <input asp-for="Title" class="form-control" maxlength="250" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="col-lg-4">
                    <label asp-for="CategoryId" class="form-label">Danh mục</label>
                    <select asp-for="CategoryId" asp-items="Model.Categories"
                            class="form-select">
                        <option value="">Chọn danh mục</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Slug" class="form-label">Slug</label>
                <input asp-for="Slug"
                       class="form-control"
                       maxlength="250"
                       placeholder="Để trống để tự tạo từ tiêu đề"
                       aria-describedby="slug-help" />
                <div id="slug-help" class="form-text">
                    Ví dụ <code>mon-ngon-cuoi-tuan</code>.
                    Nếu để trống, hệ thống sẽ tạo slug khi anh bấm lưu.
                </div>
                <span asp-validation-for="Slug" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Summary" class="form-label">Tóm tắt</label>
                <textarea asp-for="Summary" class="form-control"
                          rows="3" maxlength="1000"></textarea>
                <span asp-validation-for="Summary" class="text-danger"></span>
            </div>

            <div id="post-content-editor">
                <label asp-for="ContentHtml" id="post-content-label"
                       class="form-label">Nội dung bài viết</label>

                <textarea asp-for="ContentHtml" class="form-control"
                          rows="12" data-editor-html="@editorHtml"></textarea>

                <span asp-validation-for="ContentHtml"
                      class="text-danger d-block mt-2"></span>
            </div>

            <details class="border rounded p-3 mt-3 tp-html-import">
                <summary class="fw-semibold">Nhập mã HTML</summary>

                <label for="post-html-source" class="form-label mt-3">
                    Dán mã HTML của bài viết
                </label>

                <textarea id="post-html-source"
                          class="form-control font-monospace"
                          rows="7" maxlength="100000" spellcheck="false"></textarea>

                <button type="button" id="post-import-html"
                        data-url="@Url.Action("ImportHtml", "Posts", new { area = "Admin" })"
                        class="btn btn-sm btn-outline-primary mt-2">
                    Đưa vào bài viết
                </button>

                <div id="post-import-status" class="small mt-2" role="status"></div>
            </details>
        </div>

        <div class="card-footer tp-card-footer bg-transparent d-flex justify-content-end gap-2">
            <a asp-area="Admin" asp-controller="Posts" asp-action="Index"
               class="btn btn-outline-secondary">
                Quay lại
            </a>
            <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1" aria-hidden="true"></i>Lưu bản nháp</button>
        </div>
    </form>
</div>

    </div>
<aside class="tp-help">
        <div class="tp-help-card">
        <span class="tp-help-flower" aria-hidden="true">✿</span>
        <span class="tp-kicker">GÓC CHUẨN BỊ</span>
        <h2>Một câu chuyện, nhiều kết nối</h2>
        <ol>
        <li>
        <strong>Bản nháp trước</strong>
        <p>Bài mới được lưu dưới dạng bản nháp để kiểm tra trước khi xuất bản.</p>
        </li>
        <li>
        <strong>Đường dẫn tự động</strong>
        <p>Để trống slug để hệ thống tạo từ tiêu đề khi lưu.</p>
        </li>
        <li>
        <strong>Soạn nội dung</strong>
        <p>Dùng thanh công cụ Summernote hoặc mở mục Nhập mã HTML.</p>
        </li>
        <li>
        <strong>Ảnh bìa</strong>
        <p>Sau khi tạo bài, mở trang sửa để tải ảnh bìa lên.</p>
        </li>
        </ol>
        <div class="tp-help-wish">
        <i class="bi bi-cup-hot" aria-hidden="true">
        </i> Chăm từng chi tiết, trọn từng trải nghiệm.</div>
        </div>
        </aside>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/admin/css/admin-tet-pages.css" asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.9.1/summernote-lite.min.css" />
}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.9.1/summernote-lite.min.js"></script>
    <script src="~/admin/js/post-editor.js" asp-append-version="true"></script>
}