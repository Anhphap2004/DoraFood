@using System.Globalization
@model DoraFood.Areas.Admin.ViewModels.DishVariantsViewModel

@{
    ViewData["Title"] = "Quản lý khẩu phần";
    var culture = CultureInfo.GetCultureInfo("vi-VN");
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h2 class="h5 mb-1">@Model.DishName</h2>
        <span class="text-body-secondary">@Model.Variants.Count khẩu phần</span>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary"
           href="@Url.Action("Index", "Dishes", new { area = "Admin" })">
            Về danh sách món
        </a>

        <a class="btn btn-primary"
           href="@Url.Action("AddVariant", "Dishes",
               new { area = "Admin", id = Model.DishId })">
            + Thêm khẩu phần
        </a>
    </div>
</div>

@if (TempData["VariantSuccess"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}

@if (TempData["VariantError"] is string error)
{
    <div class="alert alert-warning" role="alert">@error</div>
}

@if (Model.Variants.Count == 0)
{
    <div class="card">
        <div class="card-body">Món này chưa có khẩu phần.</div>
    </div>
}

@foreach (var variant in Model.Variants)
{
    <div class="card mb-3">
        <div class="card-header">
            <strong>@variant.Name</strong>
            <span class="text-body-secondary ms-2">
                @variant.Sku · @variant.SellingUnit
            </span>
        </div>

        <form asp-area="Admin"
              asp-controller="Dishes"
              asp-action="UpdateVariant"
              asp-route-id="@Model.DishId"
              method="post"
              class="card-body">

            <input type="hidden" name="variantId" value="@variant.Id" />
            <input type="hidden" name="version" value="@variant.Version" />

            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label for="price-@variant.Id" class="form-label">
                        Giá bán (₫)
                    </label>
                    <input id="price-@variant.Id"
                           name="price"
                           type="number"
                           min="0"
                           step="any"
                           value="@variant.Price.ToString("0.##", CultureInfo.InvariantCulture)"
                           class="form-control"
                           required />
                    <div class="form-text">
                        Giá hiện tại @variant.Price.ToString("#,0.##", culture) ₫
                    </div>
                </div>

                <div class="col-md-4">
                    <label for="available-@variant.Id" class="form-label">
                        Trạng thái bán
                    </label>
                    <select id="available-@variant.Id"
                            name="isAvailable"
                            class="form-select">
                        <option value="true" selected="@variant.IsAvailable">
                            Đang bán
                        </option>
                        <option value="false" selected="@(!variant.IsAvailable)">
                            Tạm ngừng bán
                        </option>
                    </select>
                </div>

                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary">
                        Lưu thay đổi
                    </button>
                </div>
            </div>
        </form>
        <div class="card-footer d-flex flex-wrap justify-content-between
            align-items-center gap-2">

            @if (variant.CanDelete)
            {
                <span class="small text-body-secondary">
                    Khẩu phần chưa có đơn hàng hoặc công thức.
                </span>

                <form asp-area="Admin"
                      asp-controller="Dishes"
                      asp-action="DeleteVariant"
                      asp-route-id="@Model.DishId"
                      method="post"
                      data-delete-variant="@variant.Name">

                    <input type="hidden" name="variantId" value="@variant.Id" />
                    <input type="hidden" name="version" value="@variant.Version" />

                    <button type="submit" class="btn btn-outline-danger btn-sm">
                        Xóa khẩu phần
                    </button>
                </form>
            }
            else
            {
                <span class="small text-body-secondary">
                    @if (variant.HasOrders && variant.HasRecipe)
                    {
                        <text>Đã có trong đơn hàng và gắn công thức.</text>
                    }
                    else if (variant.HasOrders)
                    {
                        <text>Đã có trong đơn hàng.</text>
                    }
                    else
                    {
                        <text>Đang gắn công thức.</text>
                    }
                    Có thể chọn Tạm ngừng bán.
                </span>

                <button type="button" class="btn btn-outline-secondary btn-sm" disabled>
                    Xóa khẩu phần
                </button>
            }
        </div>
    </div>
}
@section Scripts {
    <script>
        document.querySelectorAll("form[data-delete-variant]").forEach(form => {
            form.addEventListener("submit", event => {
                const name = form.dataset.deleteVariant;

                if (!window.confirm(`Xóa khẩu phần «${name}»?`)) {
                    event.preventDefault();
                }
            });
        });
    </script>
}