@model DoraFood.Areas.Admin.ViewModels.DishInput

@{
    ViewData["Title"] = "Sửa món ăn";
}
<div class="tp-page tp-page-dishes tp-page-edit">
    <section class="tp-module-intro" aria-label="Hướng dẫn màn hình">
        <div class="tp-module-icon">
        <i class="bi bi-pencil-square" aria-hidden="true">
        </i>
        </div>
        <div>
        <span class="tp-kicker">DORAFOOD · CHĂM CHÚT TỪNG CHI TIẾT</span>
        <h2>Chăm chút từng món ngon</h2>
        <p>Cập nhật thông tin và cách hiển thị món trên thực đơn.</p>
        </div>
        <span class="tp-season-stamp">
        <i class="bi bi-flower1" aria-hidden="true">
        </i>Vị xuân sum vầy</span>
    </section>
    <div class="tp-workspace"><div class="tp-main">


<div class="card tp-card">
    <form asp-area="Admin"
          asp-controller="Dishes"
          asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post">

        <div class="card-body tp-field-grid">
        <div class="tp-form-section">
        <span class="tp-section-icon">
        <i class="bi bi-pencil-square" aria-hidden="true">
        </i>
        </span>
        <div>
        <h2>Điều chỉnh món ăn</h2>
        <p>Kiểm tra tên, đường dẫn và trạng thái trước khi lưu.</p>
        </div>
        </div>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Tên món</label>
                <input asp-for="Name" class="form-control"
                       maxlength="200" required />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Slug" class="form-label">Slug</label>
                <input asp-for="Slug" class="form-control"
                       maxlength="200" placeholder="ga-nuong-muoi-ot" required />
                <span asp-validation-for="Slug" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CategoryId" class="form-label">Danh mục</label>
                <select asp-for="CategoryId"
                        asp-items="Model.CategoryOptions"
                        class="form-select" required>
                    <option value="">Chọn danh mục</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ShortDescription" class="form-label">
                    Mô tả ngắn
                </label>
                <textarea asp-for="ShortDescription" class="form-control"
                          rows="3" maxlength="500"></textarea>
                <span asp-validation-for="ShortDescription"
                      class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AllergenNote" class="form-label">
                    Lưu ý dị ứng
                </label>
                <textarea asp-for="AllergenNote" class="form-control"
                          rows="2" maxlength="500"></textarea>
                <span asp-validation-for="AllergenNote"
                      class="text-danger small"></span>
            </div>

            <div class="form-check form-switch tp-switch mb-2">
                <input asp-for="IsFeatured" class="form-check-input" />
                <label asp-for="IsFeatured" class="form-check-label">
                    Món nổi bật
                </label>
            </div>

            <div class="form-check form-switch tp-switch">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">
                    Bật món
                </label>
            </div>
        </div>

        <div class="card-footer tp-card-footer d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1" aria-hidden="true"></i>Lưu món ăn</button>
            <a class="btn btn-outline-secondary"
               href="@Url.Action("Index", "Dishes", new { area = "Admin" })">
                Về danh sách
            </a>
        </div>
    </form>
</div>
    </div>
<aside class="tp-help">
        <div class="tp-help-card">
        <span class="tp-help-flower" aria-hidden="true">✿</span>
        <span class="tp-kicker">GÓC CHUẨN BỊ</span>
        <h2>Một thực đơn dễ chọn, dễ yêu</h2>
        <ol>
        <li>
        <strong>Tên & danh mục</strong>
        <p>Giữ thông tin nhất quán với thực đơn nhà hàng.</p>
        </li>
        <li>
        <strong>Đường dẫn món</strong>
        <p>Nếu đổi slug, đường dẫn truy cập món cũng thay đổi.</p>
        </li>
        <li>
        <strong>Món nổi bật</strong>
        <p>Dùng tùy chọn này cho món muốn giới thiệu đến khách.</p>
        </li>
        <li>
        <strong>Bật món</strong>
        <p>Trạng thái hiển thị món và trạng thái bán của từng khẩu phần là hai thiết lập riêng.</p>
        </li>
        </ol>
        <div class="tp-help-wish">
        <i class="bi bi-cup-hot" aria-hidden="true">
        </i> Chăm từng chi tiết, trọn từng trải nghiệm.</div>
        </div>
        </aside>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/admin/css/admin-tet-pages.css" asp-append-version="true" />
}
