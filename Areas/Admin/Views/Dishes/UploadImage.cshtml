@model DoraFood.Areas.Admin.ViewModels.DishImageInput

@{
    ViewData["Title"] = "Tải ảnh món ăn";
}
<div class="tp-page tp-page-dishes tp-page-uploadimage">
    <section class="tp-module-intro" aria-label="Hướng dẫn màn hình">
        <div class="tp-module-icon">
        <i class="bi bi-image" aria-hidden="true">
        </i>
        </div>
        <div>
        <span class="tp-kicker">DORAFOOD · CHĂM CHÚT TỪNG CHI TIẾT</span>
        <h2>Hình đẹp, món thêm hấp dẫn</h2>
        <p>Tải ảnh từ máy và xem trước trước khi lưu làm ảnh chính.</p>
        </div>
        <span class="tp-season-stamp">
        <i class="bi bi-flower1" aria-hidden="true">
        </i>Vị xuân sum vầy</span>
    </section>
    <div class="tp-workspace"><div class="tp-main">


<div class="card tp-card">
<form asp-area="Admin"
          asp-controller="Dishes"
          asp-action="UploadImage"
          asp-route-id="@Model.DishId"
          method="post"
          enctype="multipart/form-data">

        <div class="card-body tp-upload-body">
        <div class="tp-form-section">
        <span class="tp-section-icon">
        <i class="bi bi-image" aria-hidden="true">
        </i>
        </span>
        <div>
        <h2>Ảnh món ăn</h2>
        <p>@Model.DishName</p>
        </div>
        </div>
            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-2"></div>

            @if (!string.IsNullOrWhiteSpace(Model.CurrentImageUrl))
            {
                <div class="mb-3">
                    <p class="form-label">Ảnh hiện tại</p>
                    <img src="@Url.Content(Model.CurrentImageUrl)"
                         alt="Ảnh hiện tại của @Model.DishName"
                         width="160"
                         height="120"
                         class="rounded border object-fit-cover" />
                </div>
            }

            <div class="mb-3">
                <label asp-for="Image" class="form-label">Chọn ảnh từ máy</label>

                <input asp-for="Image"
                       id="dish-image-input"
                       type="file"
                       accept="image/jpeg,image/png"
                       class="form-control"
                       required />

                <div class="form-text">JPG hoặc PNG, tối đa 5 MB.</div>
                <span asp-validation-for="Image" class="text-danger small"></span>

                <p id="dish-image-preview-error"
                   class="text-danger small mt-2 mb-0"
                   role="status"
                   hidden></p>

                <figure id="dish-image-preview" class="mt-3 mb-0" hidden>
                    <figcaption class="form-label">Xem trước ảnh vừa chọn</figcaption>
                    <img id="dish-image-preview-img"
                         alt="Ảnh món ăn vừa chọn"
                         class="img-fluid rounded border"
                         style="max-height: 300px; object-fit: contain;" />
                </figure>
            </div>
        </div>

        <div class="card-footer tp-card-footer d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-image me-1" aria-hidden="true"></i>Lưu ảnh chính</button>
            <a class="btn btn-outline-secondary"
               href="@Url.Action("Index", "Dishes", new { area = "Admin" })">
                Về danh sách
            </a>
        </div>
    </form>
</div>
    </div>
<aside class="tp-help">
        <div class="tp-help-card">
        <span class="tp-help-flower" aria-hidden="true">✿</span>
        <span class="tp-kicker">GÓC CHUẨN BỊ</span>
        <h2>Một tấm ảnh kể vị ngon</h2>
        <ol>
        <li>
        <strong>Định dạng ảnh</strong>
        <p>Chọn JPG hoặc PNG, dung lượng tối đa 5 MB.</p>
        </li>
        <li>
        <strong>Góc chụp gợi ý</strong>
        <p>Ưu tiên ảnh rõ món, đủ sáng, màu sắc tự nhiên.</p>
        </li>
        <li>
        <strong>Xem trước</strong>
        <p>Ảnh vừa chọn chỉ được cập nhật vào hệ thống sau khi bấm lưu.</p>
        </li>
        </ol>
        <div class="tp-help-wish">
        <i class="bi bi-cup-hot" aria-hidden="true">
        </i> Chăm từng chi tiết, trọn từng trải nghiệm.</div>
        </div>
        </aside>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/admin/css/admin-tet-pages.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        (() => {
            const input = document.getElementById("dish-image-input");
            const preview = document.getElementById("dish-image-preview");
            const image = document.getElementById("dish-image-preview-img");
            const error = document.getElementById("dish-image-preview-error");
            const maxBytes = 5 * 1024 * 1024;
            let previewUrl = null;

            function showError(message) {
                preview.hidden = true;
                error.textContent = message;
                error.hidden = false;
                input.setCustomValidity(message);
            }

            input.addEventListener("change", () => {
                preview.hidden = true;
                error.hidden = true;
                error.textContent = "";
                input.setCustomValidity("");
                image.removeAttribute("src");

                if (previewUrl !== null) {
                    URL.revokeObjectURL(previewUrl);
                    previewUrl = null;
                }

                const file = input.files[0];
                if (!file) return;

                if (file.size === 0 || file.size > maxBytes) {
                    showError("Ảnh phải lớn hơn 0 và không quá 5 MB.");
                    return;
                }

                if (file.type && !["image/jpeg", "image/png"].includes(file.type)) {
                    showError("Anh chọn ảnh JPG hoặc PNG nhé.");
                    return;
                }

                previewUrl = URL.createObjectURL(file);
                image.src = previewUrl;
            });

            image.addEventListener("load", () => {
                preview.hidden = false;
            });

            image.addEventListener("error", () => {
                if (previewUrl !== null) {
                    showError("Không đọc được ảnh này. Anh thử chọn ảnh khác.");
                }
            });
        })();
    </script>
}