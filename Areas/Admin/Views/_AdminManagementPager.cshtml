@model DoraFood.Areas.Admin.ViewModels.ManagementPager
@if (Model.TotalPages > 1)
{
    <nav class="d-flex flex-wrap justify-content-between align-items-center gap-2 p-3"
         aria-label="Phân trang">
        <span class="text-body-secondary small">Trang @Model.PageNumber / @Model.TotalPages</span>
        <div class="d-flex gap-2">
            @if (Model.PageNumber > 1)
            {
                <a asp-area="Admin" asp-controller="@Model.Controller" asp-action="Index"
                   asp-all-route-data="@Model.Filters" asp-route-pageNumber="@(Model.PageNumber - 1)"
                   class="btn btn-sm btn-outline-secondary">Trang trước</a>
            }
            @if (Model.PageNumber < Model.TotalPages)
            {
                <a asp-area="Admin" asp-controller="@Model.Controller" asp-action="Index"
                   asp-all-route-data="@Model.Filters" asp-route-pageNumber="@(Model.PageNumber + 1)"
                   class="btn btn-sm btn-outline-secondary">Trang sau</a>
            }
        </div>
    </nav>
}
